<Window x:Class="OctalPulse.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:OctalPulse.Installer.Converters"
        xmlns:vm="clr-namespace:OctalPulse.Installer.ViewModels"
        mc:Ignorable="d"
        Title="OctalPulse Setup"
        Width="580" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI, Inter, Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StepToVisibilityConverter x:Key="StepToVis" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- TitleBar Button Style -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2937" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151" />
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D3748" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Custom Window Title Bar ── -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/Assets/OctalPulse.png" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="OctalPulse Setup &amp; Update" FontSize="12" FontWeight="SemiBold" Foreground="#F9FAFB" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarBtn}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseBtn}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main Content Area ── -->
            <Grid Grid.Row="1" Margin="28">

                <!-- 1. WELCOME / FIRST INSTALL STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=Welcome}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#266366F1" Margin="0,0,14,0">
                                <Image Source="pack://application:,,,/Assets/OctalPulse.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Install OctalPulse Desktop" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                                <TextBlock Text="Enterprise Project &amp; Track Management Platform" FontSize="12" Foreground="#9CA3AF" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Choose the installation directory where application files will be installed. User databases and credentials will remain protected in your user profile." 
                                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>

                    <!-- Path Picker Card -->
                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Destination Directory" FontSize="12" FontWeight="SemiBold" Foreground="#F9FAFB" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="36" Background="#1F2937" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1" 
                                         Padding="10,0" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse..." Command="{Binding BrowseFolderCommand}" Height="36" />
                            </Grid>
                            <TextBlock Text="Recommended per-user location: %LocalAppData%\OctalPulse" FontSize="11" Foreground="#6B7280" />
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding ExitInstallerCommand}" Width="90" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Install Now" Command="{Binding StartInstallCommand}" Width="130" />
                    </StackPanel>
                </Grid>

                <!-- 2. WORKING / PROGRESS STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=Working}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SubStatusMessage}" FontSize="13" Foreground="#6366F1" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Progress Bar & Status Card -->
                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Progress" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" />
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" Foreground="#6366F1" HorizontalAlignment="Right" />
                            </Grid>

                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsIndeterminate}" Foreground="#6366F1" Background="#1F2937" BorderThickness="0" Margin="0,0,0,16" />

                            <Border Background="#1F2937" CornerRadius="6" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡" FontSize="16" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="The existing installation remains completely untouched until download &amp; verification succeed." 
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Width="430" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding CanCancel}" Width="100" />
                    </StackPanel>
                </Grid>

                <!-- 3. DOWNLOAD FAILED STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=DownloadFailed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#26F59E0B" Margin="0,0,14,0">
                                <TextBlock Text="⚠" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Download Failed" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                                <TextBlock Text="Your current version is still safe" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="The package could not be downloaded completely due to a network interruption or server issue." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="No existing files were modified or deleted. You can retry the download now." FontSize="12" Foreground="#F9FAFB" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding ExitInstallerCommand}" Width="90" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Retry" Command="{Binding RetryCommand}" Width="110" />
                    </StackPanel>
                </Grid>

                <!-- 4. INTERRUPTED NOTICE STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=InterruptedNotice}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#26EF4444" Margin="0,0,14,0">
                                <TextBlock Text="⚠" FontSize="20" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Update Was Interrupted" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                                <TextBlock Text="Reinstallation required" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="The previous update did not finish copying files. The application state is incomplete." FontSize="13" Foreground="#F9FAFB" Margin="0,0,0,8" />
                            <TextBlock Text="To ensure stability, the installer will download the full current package and cleanly reinstall OctalPulse into:" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding InstallDirectory}" FontSize="12" FontWeight="SemiBold" Foreground="#6366F1" Margin="0,0,0,12" />
                            <TextBlock Text="Your user database, personal settings, and tokens will remain completely intact." FontSize="11" Foreground="#10B981" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Exit" Command="{Binding ExitInstallerCommand}" Width="90" Margin="0,0,10,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Reinstall Now" Command="{Binding StartReinstallCommand}" Width="140" />
                    </StackPanel>
                </Grid>

                <!-- 5. COMPLETED STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=Completed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#2610B981" Margin="0,0,14,0">
                                <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Installation Completed!" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                                <TextBlock Text="OctalPulse is ready to run" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding SubStatusMessage}" FontSize="13" Foreground="#F9FAFB" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="All application files have been verified and updated. Temporary setup files have been cleaned up." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Location: " FontSize="11" Foreground="#6B7280" />
                                <TextBlock Text="{Binding InstallDirectory}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Width="380" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Close" Command="{Binding ExitInstallerCommand}" Width="90" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Launch OctalPulse" Command="{Binding LaunchApplicationCommand}" Width="160" />
                    </StackPanel>
                </Grid>

                <!-- 6. ERROR STEP -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=Error}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#26EF4444" Margin="0,0,14,0">
                                <TextBlock Text="✕" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Installation Error" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                                <TextBlock Text="An error occurred during setup" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#111827" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="The installer encountered an issue:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#EF4444" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Exit" Command="{Binding ExitInstallerCommand}" Width="90" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Try Again" Command="{Binding RetryCommand}" Width="120" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
