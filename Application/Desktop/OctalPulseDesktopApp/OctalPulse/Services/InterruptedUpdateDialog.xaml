<Window
    x:Class="OctalPulse.Services.InterruptedUpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OctalPulse • Installation Incomplete"
    Width="440"
    SizeToContent="Height"
    WindowStyle="ToolWindow"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    Background="{DynamicResource Brush.Surface}">
    <Border Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="8" Background="#26EF4444" Margin="0,0,12,0">
                    <TextBlock Text="⚠" FontSize="22" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update Did Not Complete" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="Previous installation was interrupted" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="The previous update or installation was unexpectedly interrupted. Application files may be missing or corrupt." 
                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />

            <TextBlock Text="Please reinstall OctalPulse using the installer to restore a clean, functioning application state." 
                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Content="Exit"
                    IsCancel="True"
                    Width="80"
                    Height="34"
                    Margin="0,0,10,0"
                    Style="{DynamicResource Button.Secondary}" />
                <Button
                    Content="Reinstall Now"
                    IsDefault="True"
                    Click="Reinstall_Click"
                    Width="120"
                    Height="34"
                    Style="{DynamicResource Button.Danger}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
