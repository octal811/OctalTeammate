<Window
    x:Class="OctalPulse.Services.UpdateNotificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OctalPulse • Update Available"
    Width="460"
    SizeToContent="Height"
    WindowStyle="ToolWindow"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{DynamicResource Brush.Surface}">
    <Border Padding="24">
        <StackPanel>
            <!-- Header with Badge -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,12,0">
                    <Path Data="{DynamicResource Icon.Sparkles}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update Available" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="A new version of OctalPulse is ready for installation." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </StackPanel>

            <!-- Version Comparison Card -->
            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                        <TextBlock x:Name="CurrentVersionText" Text="v1.0.0.0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" Margin="12,0" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,0,4" />
                        <TextBlock x:Name="NewVersionText" Text="v1.1.0.0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Release Notes (if any) -->
            <StackPanel x:Name="ReleaseNotesPanel" Margin="0,0,0,18" Visibility="Collapsed">
                <TextBlock Text="What's New:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4" />
                <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotesText" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="16" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <TextBlock Text="Updating will launch the installer, close OctalPulse, safely download and verify the update, and restart the application." 
                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="16" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Content="Later"
                    IsCancel="True"
                    Width="90"
                    Height="34"
                    Margin="0,0,10,0"
                    Style="{DynamicResource Button.Secondary}" />
                <Button
                    Content="Update Now"
                    IsDefault="True"
                    Click="UpdateNow_Click"
                    Width="120"
                    Height="34"
                    Style="{DynamicResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
