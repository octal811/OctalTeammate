<Window x:Class="OctalPulse.FloatWindows.MediaFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Feed"
        Width="390"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- White background, sharp edges, clean slate border -->
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,8,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z"
                          Fill="#9333EA" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Media Feed" Foreground="#0F172A"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <Button Grid.Column="2" x:Name="LockButton" Style="{StaticResource HeaderBtn}"
                            ToolTip="Lock / Unlock position" Click="LockButton_Click">
                        <TextBlock x:Name="LockGlyph" Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource HeaderBtn}"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource HeaderBtn}"
                            Click="CloseButton_Click" ToolTip="Hide">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Feed Posts -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#F8FAFC"
                          Padding="10,8">
                <ItemsControl ItemsSource="{Binding RecentPosts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="10,8">
                                <StackPanel>
                                    <!-- Author row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="26" Height="26" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold" Foreground="#4F46E5">
                                                <TextBlock.Text>
                                                    <Binding Path="AuthorName[0]"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AuthorName}"
                                                       Foreground="#0F172A"
                                                       FontSize="11" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProjectTitle}"
                                                           Foreground="#64748B" FontSize="9"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:MMM d}'}"
                                                           Foreground="#94A3B8" FontSize="9"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Content -->
                                    <TextBlock Text="{Binding Content}"
                                               Foreground="#334155"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxHeight="70"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Reactions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Foreground="#64748B" FontSize="9" Margin="0,0,10,0">
                                            <TextBlock.Text>
                                                <Binding Path="TotalReactions" StringFormat="{}👍 {0}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Foreground="#64748B" FontSize="9">
                                            <TextBlock.Text>
                                                <Binding Path="CommentsCount" StringFormat="{}💬 {0}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="8,5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock Text="Alt+M to toggle" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
