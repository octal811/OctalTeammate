<Window
    x:Class="OctalPulse.FloatWindows.NotesFloatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:OctalPulse.Domain.Entities;assembly=OctalPulse.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OctalPulse.ViewModels"
    Title="OctalPulse Personal Notes"
    Width="460"
    d:DataContext="{d:DesignInstance Type=vm:NotesFloatViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    KeyDown="Window_KeyDown"
    RenderOptions.BitmapScalingMode="HighQuality"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Auto"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NoteCardColorConverter x:Key="NoteColorConv" />
    </Window.Resources>

    <!--  Docked Command Drawer Container (Default: Left Side)  -->
    <Border
        x:Name="RootBorder"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="0,0,1.5,0"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                x:Name="RootShadow"
                BlurRadius="16"
                Direction="0"
                Opacity="0.18"
                ShadowDepth="0"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="Auto" />
                <!--  Stats & Quick Actions  -->
                <RowDefinition Height="Auto" />
                <!--  Composer (Collapsible)  -->
                <RowDefinition Height="*" />
                <!--  Notes List  -->
                <RowDefinition Height="Auto" />
                <!--  Bottom Status Bar  -->
            </Grid.RowDefinitions>

            <!--  ── ROW 0: DRAWER HEADER ─────────────────────────────────────  -->
            <Border
                Grid.Row="0"
                Padding="18,14"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon  -->
                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#6366F1" />
                                <GradientStop Offset="1" Color="#8B5CF6" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="📝" />
                    </Border>

                    <!--  Titles  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="My Notes &amp; Ideas" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="4">
                                <TextBlock
                                    FontFamily="Consolas, Segoe UI"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="Alt + O" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="7.6"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="🔒 100% Offline • Private • Emergency Backup Protected" />
                    </StackPanel>

                    <!--  Header Tools  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Open Emergency Folder in Explorer  -->
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="0"
                            Command="{Binding OpenEmergencyFolderCommand}"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="Open Emergency Backup Folder in Documents">
                            <TextBlock
                                Margin="7,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="📁" />
                        </Button>

                        <!--  Restore from Emergency Backup  -->
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="0"
                            Command="{Binding RestoreEmergencyBackupCommand}"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="Restore Notes from Emergency Backup">
                            <TextBlock
                                Margin="7,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="🔄" />
                        </Button>

                        <!--  Fast Add (AI / JSON Importer)  -->
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="0"
                            Command="{Binding OpenFastAddCommand}"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="Fast Add Notes from AI / JSON (Alt + I)">
                            <TextBlock
                                Margin="7,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="⚡" />
                        </Button>

                        <!--  Dock Position Lock (Left, Right, Top, Bottom)  -->
                        <Button
                            x:Name="DockButton"
                            Width="32"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="0"
                            Click="DockButton_Click"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="Dock Window: Left (Default), Right, Top, or Bottom (Alt + D)">
                            <TextBlock
                                x:Name="DockIcon"
                                Margin="7,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="⬅️" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuDockLeft" Header="⬅️  Dock Left (Default)" Click="DockLeft_Click" IsCheckable="True" />
                                    <MenuItem x:Name="MenuDockRight" Header="➡️  Dock Right" Click="DockRight_Click" IsCheckable="True" />
                                    <MenuItem x:Name="MenuDockTop" Header="⬆️  Dock Top" Click="DockTop_Click" IsCheckable="True" />
                                    <MenuItem x:Name="MenuDockBottom" Header="⬇️  Dock Bottom" Click="DockBottom_Click" IsCheckable="True" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!--  Close Button  -->
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="CloseButton_Click"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="Hide Drawer (Alt + O or Esc)">
                            <Path
                                Width="12"
                                Height="12"
                                Margin="10,0,0,0"
                                Data="{StaticResource Icon.Close}"
                                Fill="{DynamicResource Brush.TextMuted}"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ── ROW 1: STATS & SEARCH / FILTER TOOLBAR ────────────────────  -->
            <Border
                Grid.Row="1"
                Padding="16,12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <!--  Search Input + New Note Button + Fast Add Button  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Search Box  -->
                        <Border
                            Grid.Column="0"
                            Height="36"
                            Margin="0,0,8,0"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Grid.Column="0"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Icon.Search}"
                                    Fill="{DynamicResource Brush.TextMuted}"
                                    Stretch="Uniform" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Tag="Search notes, links, tags..."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!--  Actions: New Note + Fast Add  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  + New Note Button  -->
                            <Button
                                Height="36"
                                Margin="0,0,6,0"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenCreateComposerCommand}"
                                Style="{StaticResource Button.Primary}"
                                ToolTip="Create a new note manually">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="11"
                                        Height="11"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Plus}"
                                        Fill="#FFFFFF"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="New" />
                                </StackPanel>
                            </Button>

                            <!--  ⚡ Fast Add Button  -->
                            <Button
                                Height="36"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenFastAddCommand}"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Fast Add multiple notes from AI plan or JSON (Alt + I)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="⚡" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Fast Add" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Filter Chips Row  -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilterTypeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="0,0,6,0"
                                        Content="{Binding}"
                                        Cursor="Hand"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        GroupName="NoteFilters"
                                        IsChecked="{Binding Path=DataContext.SelectedTypeFilter, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=TwoWay, Converter={x:Null}}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border
                                                    x:Name="ChipBorder"
                                                    Padding="10,4"
                                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        x:Name="ChipText"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{TemplateBinding Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                                        <Setter TargetName="ChipText" Property="FontWeight" Value="Bold" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--  ── ROW 2: INLINE COMPOSER / EDITOR CARD ──────────────────────  -->
            <Border
                Grid.Row="2"
                Padding="18,16"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Primary}"
                BorderThickness="0,0,0,2"
                Visibility="{Binding IsComposerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!--  Composer Header  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter='Edit Note'}" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="New Note &amp; Idea"
                                Visibility="{Binding IsEditing, Converter={StaticResource InvertBoolToVis}}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Command="{Binding CancelComposerCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <Path
                                Width="10"
                                Height="10"
                                Margin="8,0,0,0"
                                Data="{StaticResource Icon.Close}"
                                Fill="{DynamicResource Brush.TextMuted}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!--  Title (Required)  -->
                    <TextBox
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource TextBox.Modern}"
                        Tag="Title (Required)..."
                        Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Description (Optional)  -->
                    <TextBox
                        Height="64"
                        Margin="0,0,0,10"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource TextBox.Modern}"
                        Tag="Description or thoughts (optional)..."
                        Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <!--  Note Type Selector (Pills)  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Note Category:" />
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Button
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Command="{Binding SelectTypeCommand}"
                            CommandParameter="{x:Static entities:NoteType.Task}"
                            Style="{StaticResource Button.Ghost}">
                            <TextBlock FontSize="11" Text="📋 Task" />
                        </Button>
                        <Button
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Command="{Binding SelectTypeCommand}"
                            CommandParameter="{x:Static entities:NoteType.Reminder}"
                            Style="{StaticResource Button.Ghost}">
                            <TextBlock FontSize="11" Text="⏰ Reminder" />
                        </Button>
                        <Button
                            Height="28"
                            Padding="10,0"
                            Command="{Binding SelectTypeCommand}"
                            CommandParameter="{x:Static entities:NoteType.Research}"
                            Style="{StaticResource Button.Ghost}">
                            <TextBlock FontSize="11" Text="🔬 Research" />
                        </Button>
                    </StackPanel>

                    <!--  Optional Project Tag & Due Date Row  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Project Association  -->
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Project Tag (Optional):" />
                            <ComboBox
                                Height="32"
                                FontSize="11"
                                ItemsSource="{Binding ComposerProjects}"
                                SelectedItem="{Binding SelectedProjectInput, Mode=TwoWay}"
                                Style="{StaticResource ComboBox.Modern}" />
                        </StackPanel>

                        <!--  Due Date  -->
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Due Date (Optional):" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding HasDurationDate, Mode=TwoWay}" />
                                <DatePicker
                                    Grid.Column="1"
                                    Height="32"
                                    FontSize="11"
                                    IsEnabled="{Binding HasDurationDate}"
                                    SelectedDate="{Binding DurationDateInput, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  Color Swatches (10 Curated Colors)  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Card Accent Color:" />
                    <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding ColorPalette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="26"
                                    Height="26"
                                    Margin="0,0,8,4"
                                    Padding="0"
                                    Command="{Binding Path=DataContext.SelectCardColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}"
                                    Cursor="Hand"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="{Binding Name}">
                                    <Border
                                        Width="24"
                                        Height="24"
                                        BorderThickness="1.5"
                                        CornerRadius="12">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Hex}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{Binding BorderHex}" />
                                        </Border.BorderBrush>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Link Adder  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Add Links / References:" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Height="32"
                            Margin="0,0,6,0"
                            FontSize="11"
                            Style="{StaticResource TextBox.Modern}"
                            Tag="https://example.com/research..."
                            Text="{Binding NewLinkInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            Padding="12,0"
                            Command="{Binding AddLinkCommand}"
                            Content="+ Link"
                            FontSize="11"
                            Style="{StaticResource Button.Primary}" />
                    </Grid>

                    <!--  Link Chips in Composer  -->
                    <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding LinksInput}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,6,4"
                                    Padding="8,3"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="🔗 " />
                                        <TextBlock
                                            MaxWidth="220"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{DynamicResource Brush.Primary}"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Width="16"
                                            Height="16"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding Path=DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}">
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                Text="✕" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Height="34"
                            Margin="0,0,8,0"
                            Padding="16,0"
                            Command="{Binding CancelComposerCommand}"
                            Content="Cancel"
                            FontSize="12"
                            Style="{StaticResource Button.Ghost}" />
                        <Button
                            Height="34"
                            Padding="20,0"
                            Command="{Binding SaveNoteCommand}"
                            Content="💾 Save Note"
                            FontSize="12"
                            Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ── ROW 3: SCROLLABLE LIST OF NOTES ───────────────────────────  -->
            <ScrollViewer
                Grid.Row="3"
                Padding="16"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  Empty State  -->
                    <Border
                        Margin="0,20,0,0"
                        Padding="28,36"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="{Binding FilteredNotes.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                FontSize="36"
                                Text="📝" />
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="No Notes Found" />
                            <TextBlock
                                MaxWidth="300"
                                Margin="0,0,0,16"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                LineHeight="18"
                                Text="Create a private offline note, research bookmark, or daily task by clicking '+ New Note' above."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Height="34"
                                Padding="18,0"
                                HorizontalAlignment="Center"
                                Command="{Binding OpenCreateComposerCommand}"
                                Content="+ Create First Note"
                                FontSize="12"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </Border>

                    <!--  Notes Cards List  -->
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteItemViewModel}">
                                <Border
                                    Margin="0,0,0,12"
                                    Padding="14,12"
                                    Background="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='bg'}"
                                    BorderBrush="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='border'}"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.08"
                                            ShadowDepth="1"
                                            Color="#000000" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <!--  Top Badges  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Title & Check  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Description  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Links Chips  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Card Footer (Timestamp & Actions)  -->
                                        </Grid.RowDefinitions>

                                        <!--  Row 0: Badges  -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <!--  Category Badge  -->
                                                <Border
                                                    Margin="0,0,6,0"
                                                    Padding="6,2"
                                                    Background="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='border'}"
                                                    CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,0,3,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Text="{Binding TypeIcon}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='text'}"
                                                            Text="{Binding Type}" />
                                                    </StackPanel>
                                                </Border>

                                                <!--  Project Badge (if any)  -->
                                                <Border
                                                    Padding="6,2"
                                                    Background="#1A6366F1"
                                                    CornerRadius="5"
                                                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#6366F1"
                                                        Text="{Binding RelatedToProject}" />
                                                </Border>
                                            </StackPanel>

                                            <!--  Due Date Badge  -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="6,2"
                                                Background="#22F43F5E"
                                                CornerRadius="5"
                                                Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#F43F5E"
                                                    Text="{Binding FormattedDuration}" />
                                            </Border>
                                        </Grid>

                                        <!--  Row 1: Title with Checkbox  -->
                                        <Grid Grid.Row="1" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding Path=DataContext.ToggleCheckedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsChecked="{Binding Checked, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='text'}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Checked}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Opacity" Value="0.65" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!--  Row 2: Description  -->
                                        <TextBlock
                                            Grid.Row="2"
                                            Margin="24,0,0,8"
                                            FontSize="12"
                                            Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='subtext'}"
                                            LineHeight="16"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                        <!--  Row 3: Link Chips  -->
                                        <ItemsControl
                                            Grid.Row="3"
                                            Margin="24,0,0,8"
                                            ItemsSource="{Binding ListOfLinks}"
                                            Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Height="22"
                                                        Margin="0,0,6,4"
                                                        Padding="0"
                                                        Command="{Binding Path=DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Style="{StaticResource Button.Ghost}">
                                                        <Border
                                                            Padding="8,2"
                                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="11">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="9"
                                                                    Text="🌐 " />
                                                                <TextBlock
                                                                    MaxWidth="240"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource Brush.Primary}"
                                                                    Text="{Binding}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  Row 4: Footer (Timestamp + Edit/Delete)  -->
                                        <Grid Grid.Row="4" Margin="24,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='subtext'}"
                                                Text="{Binding FormattedCreatedAt}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!--  Edit  -->
                                                <Button
                                                    Width="26"
                                                    Height="26"
                                                    Margin="0,0,4,0"
                                                    Padding="0"
                                                    Command="{Binding Path=DataContext.OpenEditComposerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Ghost}"
                                                    ToolTip="Edit Note">
                                                    <Path
                                                        Width="11"
                                                        Height="11"
                                                        Margin="7,0,0,0"
                                                        Data="{StaticResource Icon.Edit}"
                                                        Fill="{DynamicResource Brush.TextSecondary}"
                                                        Stretch="Uniform" />
                                                </Button>

                                                <!--  Delete  -->
                                                <Button
                                                    Width="26"
                                                    Height="26"
                                                    Padding="0"
                                                    Command="{Binding Path=DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Ghost}"
                                                    ToolTip="Delete Note">
                                                    <Path
                                                        Width="11"
                                                        Height="11"
                                                        Margin="7,0,0,0"
                                                        Data="{StaticResource Icon.Trash}"
                                                        Fill="{DynamicResource Brush.Danger}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  ── ROW 4: BOTTOM STATUS BAR ─────────────────────────────────  -->
            <Border
                Grid.Row="4"
                Padding="16,8"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.Success}"
                            Text="🛡️ Emergency Backup Active" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text=" • Isolated from setup uninstaller" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{DynamicResource Brush.TextMuted}">
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="{Binding TotalCount}" />
                        <Run Text=" notes (" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Primary}"
                            Text="{Binding ActiveCount}" />
                        <Run Text=" active)" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
