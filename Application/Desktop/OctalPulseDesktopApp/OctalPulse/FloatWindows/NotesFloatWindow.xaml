<Window x:Class="OctalPulse.FloatWindows.NotesFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:OctalPulse.Converters"
        xmlns:vm="clr-namespace:OctalPulse.ViewModels"
        xmlns:entities="clr-namespace:OctalPulse.Domain.Entities;assembly=OctalPulse.Domain"
        mc:Ignorable="d"
        Title="OctalPulse Personal Notes"
        Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        d:DataContext="{d:DesignInstance Type=vm:NotesFloatViewModel}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NoteCardColorConverter x:Key="NoteColorConv" />
    </Window.Resources>

    <!-- Right-Docked Command Drawer Container -->
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1.5,0,0,0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.18" Direction="180" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Stats & Quick Actions -->
                <RowDefinition Height="Auto" /> <!-- Composer (Collapsible) -->
                <RowDefinition Height="*" />    <!-- Notes List -->
                <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- ── ROW 0: DRAWER HEADER ───────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Titles -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="My Notes &amp; Ideas" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Alt + O" FontSize="10" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="🔒 100% Offline • Private • Emergency Backup Protected" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Header Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Open Emergency Folder in Explorer -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding OpenEmergencyFolderCommand}"
                                ToolTip="Open Emergency Backup Folder in Documents"
                                Width="32" Height="32" Padding="0" Margin="0,0,4,0">
                            <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Restore from Emergency Backup -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding RestoreEmergencyBackupCommand}"
                                ToolTip="Restore Notes from Emergency Backup"
                                Width="32" Height="32" Padding="0" Margin="0,0,4,0">
                            <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Click="CloseButton_Click"
                                ToolTip="Hide Drawer (Alt + O or Esc)"
                                Width="32" Height="32" Padding="0">
                            <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── ROW 1: STATS & SEARCH / FILTER TOOLBAR ──────────────────── -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                    <!-- Search Input + New Note Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Height="36" Margin="0,0,10,0">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="{DynamicResource Brush.TextMuted}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="12" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         Tag="Search notes, links, tags..." />
                            </Grid>
                        </Border>

                        <!-- + New Note Button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding OpenCreateComposerCommand}"
                                Height="36" Padding="14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="New Note" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Filter Chips Row -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilterTypeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="NoteFilters"
                                                 Content="{Binding}"
                                                 Margin="0,0,6,0"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Cursor="Hand"
                                                 IsChecked="{Binding Path=DataContext.SelectedTypeFilter, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=TwoWay, Converter={x:Null}}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="ChipBorder" CornerRadius="14" Padding="10,4" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <TextBlock x:Name="ChipText" Text="{TemplateBinding Content}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                                        <Setter TargetName="ChipText" Property="FontWeight" Value="Bold" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ── ROW 2: INLINE COMPOSER / EDITOR CARD ────────────────────── -->
            <Border Grid.Row="2"
                    Visibility="{Binding IsComposerOpen, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Primary}"
                    BorderThickness="0,0,0,2"
                    Padding="18,16">
                <StackPanel>
                    <!-- Composer Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter='Edit Note'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="New Note &amp; Idea" Visibility="{Binding IsEditing, Converter={StaticResource InvertBoolToVis}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Command="{Binding CancelComposerCommand}" Width="24" Height="24" Padding="0">
                            <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Title (Required) -->
                    <TextBox Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Modern}"
                             Tag="Title (Required)..."
                             FontWeight="SemiBold"
                             FontSize="13"
                             Margin="0,0,0,8" />

                    <!-- Description (Optional) -->
                    <TextBox Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Modern}"
                             Tag="Description or thoughts (optional)..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="64"
                             FontSize="12"
                             Margin="0,0,0,10" />

                    <!-- Note Type Selector (Pills) -->
                    <TextBlock Text="Note Category:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static entities:NoteType.Task}"
                                Height="28" Padding="10,0" Margin="0,0,6,0">
                            <TextBlock Text="📋 Task" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static entities:NoteType.Reminder}"
                                Height="28" Padding="10,0" Margin="0,0,6,0">
                            <TextBlock Text="⏰ Reminder" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static entities:NoteType.Research}"
                                Height="28" Padding="10,0">
                            <TextBlock Text="🔬 Research" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- Optional Project Tag & Due Date Row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Project Association -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Project Tag (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ComposerProjects}"
                                      SelectedItem="{Binding SelectedProjectInput, Mode=TwoWay}"
                                      Style="{StaticResource ComboBox.Modern}"
                                      Height="32" FontSize="11" />
                        </StackPanel>

                        <!-- Due Date -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Due Date (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding HasDurationDate, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding DurationDateInput, Mode=TwoWay}"
                                            IsEnabled="{Binding HasDurationDate}"
                                            Height="32" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Color Swatches (10 Curated Colors) -->
                    <TextBlock Text="Card Accent Color:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Path=DataContext.SelectCardColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Hex}"
                                        Width="26" Height="26" Margin="0,0,8,4" Padding="0" Cursor="Hand"
                                        ToolTip="{Binding Name}"
                                        Style="{StaticResource Button.Ghost}">
                                    <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1.5">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Hex}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{Binding BorderHex}" />
                                        </Border.BorderBrush>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Link Adder -->
                    <TextBlock Text="Add Links / References:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewLinkInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Modern}"
                                 Tag="https://example.com/research..."
                                 Height="32" FontSize="11" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding AddLinkCommand}" Content="+ Link" Height="32" Padding="12,0" FontSize="11" />
                    </Grid>

                    <!-- Link Chips in Composer -->
                    <ItemsControl ItemsSource="{Binding LinksInput}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="8,3" Margin="0,0,6,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗 " FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Brush.Primary}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Button.Ghost}"
                                                Command="{Binding Path=DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Width="16" Height="16" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="✕" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CancelComposerCommand}" Height="34" Padding="16,0" Margin="0,0,8,0" FontSize="12" />
                        <Button Style="{StaticResource Button.Primary}" Content="💾 Save Note" Command="{Binding SaveNoteCommand}" Height="34" Padding="20,0" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── ROW 3: SCROLLABLE LIST OF NOTES ─────────────────────────── -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                <StackPanel>
                    <!-- Empty State -->
                    <Border Visibility="{Binding FilteredNotes.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="12" Padding="28,36" Margin="0,20,0,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="No Notes Found" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Create a private offline note, research bookmark, or daily task by clicking '+ New Note' above." 
                                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextAlignment="Center" LineHeight="18" TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,16" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenCreateComposerCommand}" Content="+ Create First Note" Height="34" Padding="18,0" HorizontalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Notes Cards List -->
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteItemViewModel}">
                                <Border CornerRadius="10"
                                        Margin="0,0,0,12"
                                        Padding="14,12"
                                        BorderThickness="1.5"
                                        Background="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='bg'}"
                                        BorderBrush="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='border'}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#000000" Opacity="0.08" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Top Badges -->
                                            <RowDefinition Height="Auto" /> <!-- Title & Check -->
                                            <RowDefinition Height="Auto" /> <!-- Description -->
                                            <RowDefinition Height="Auto" /> <!-- Links Chips -->
                                            <RowDefinition Height="Auto" /> <!-- Card Footer (Timestamp & Actions) -->
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Badges -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <!-- Category Badge -->
                                                <Border Background="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='border'}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='text'}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Project Badge (if any) -->
                                                <Border Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" Background="#1A6366F1" CornerRadius="5" Padding="6,2">
                                                    <TextBlock Text="{Binding RelatedToProject}" FontSize="10" FontWeight="SemiBold" Foreground="#6366F1" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Due Date Badge -->
                                            <Border Grid.Column="1" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}" Background="#22F43F5E" CornerRadius="5" Padding="6,2">
                                                <TextBlock Text="{Binding FormattedDuration}" FontSize="10" FontWeight="Bold" Foreground="#F43F5E" />
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Title with Checkbox -->
                                        <Grid Grid.Row="1" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Checked, Mode=OneWay}"
                                                      Command="{Binding Path=DataContext.ToggleCheckedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='text'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Checked}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Opacity" Value="0.65" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Row 2: Description -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16"
                                                   Margin="24,0,0,8"
                                                   Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='subtext'}" />

                                        <!-- Row 3: Link Chips -->
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding ListOfLinks}" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}" Margin="24,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.Ghost}"
                                                            Command="{Binding Path=DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="0" Height="22" Margin="0,0,6,4" Cursor="Hand">
                                                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="11" Padding="8,2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🌐 " FontSize="9" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Row 4: Footer (Timestamp + Edit/Delete) -->
                                        <Grid Grid.Row="4" Margin="24,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FormattedCreatedAt}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding CardColor, Converter={StaticResource NoteColorConv}, ConverterParameter='subtext'}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!-- Edit -->
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding Path=DataContext.OpenEditComposerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Edit Note"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,4,0">
                                                    <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Brush.TextSecondary}" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>

                                                <!-- Delete -->
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding Path=DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete Note"
                                                        Width="26" Height="26" Padding="0">
                                                    <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── ROW 4: BOTTOM STATUS BAR ───────────────────────────────── -->
            <Border Grid.Row="4"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ Emergency Backup Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                        <TextBlock Text=" • Isolated from setup uninstaller" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}">
                        <Run Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Run Text=" notes (" />
                        <Run Text="{Binding ActiveCount}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                        <Run Text=" active)" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
