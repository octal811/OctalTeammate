<Window x:Class="OctalPulse.FloatWindows.MajorTasksFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OctalPulse.Converters"
        Title="Major Tasks"
        Width="380"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <!-- Main Container: White background, sharp edges (CornerRadius 0), clean slate border -->
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Drag handle) -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,8,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon + Title -->
                    <Path Grid.Column="0"
                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                          Fill="#4F46E5" Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Major Tasks"
                               Foreground="#0F172A"
                               FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                    <!-- Lock Button -->
                    <Button Grid.Column="2" x:Name="LockButton"
                            Style="{StaticResource HeaderBtn}"
                            ToolTip="Lock / Unlock position"
                            Click="LockButton_Click">
                        <TextBlock x:Name="LockGlyph" Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Grid.Column="3"
                            Style="{StaticResource HeaderBtn}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="4"
                            Style="{StaticResource HeaderBtn}"
                            Click="CloseButton_Click"
                            ToolTip="Hide">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Search Box -->
            <Border Grid.Row="1" Background="#FFFFFF" Padding="10,8,10,4">
                <TextBox Style="{StaticResource FilterBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search tasks by title or description..."/>
            </Border>

            <!-- 3. Filter Dropdown Controls -->
            <Border Grid.Row="2" Background="#FFFFFF" Padding="10,0,10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="0"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableProjects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              ToolTip="Filter by Project"/>

                    <!-- Track Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              ToolTip="Filter by Track"/>

                    <!-- State Dropdown -->
                    <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableStates}"
                              SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                              ToolTip="Filter by State"/>
                </Grid>
            </Border>

            <!-- 4. Task List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#F8FAFC"
                          Padding="10,8">
                <StackPanel>
                    <!-- Empty State -->
                    <TextBlock Text="No major tasks matching the selected filters."
                               Foreground="#94A3B8"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority Left Stripe -->
                                        <Border Grid.Column="0" Background="#6366F1" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#6366F1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1">
                                            <!-- Prominent Project & Track Header -->
                                            <WrapPanel Margin="0,0,0,4">
                                                <!-- Project Badge -->
                                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                                                        CornerRadius="0" Padding="5,2" Margin="0,0,4,2">
                                                    <TextBlock Foreground="#4338CA" FontSize="9" FontWeight="Bold">
                                                        <Run Text="📁 "/><Run Text="{Binding ProjectTitle, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Track Badge -->
                                                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                        CornerRadius="0" Padding="5,2" Margin="0,0,4,2">
                                                    <TextBlock Foreground="#0369A1" FontSize="9" FontWeight="SemiBold">
                                                        <Run Text="⚡ "/><Run Text="{Binding TrackTitle, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Title -->
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#0F172A"
                                                       FontSize="12" FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"/>

                                            <!-- Badges: State + Priority + Progress -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <!-- State Badge -->
                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="0" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding State}" Foreground="#475569" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Priority Badge -->
                                                <Border CornerRadius="0" Padding="5,1" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Priority}" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#4F46E5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Progress text -->
                                                <TextBlock Foreground="#64748B" FontSize="9" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <Binding Path="Progress" StringFormat="{}{0}%"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3"
                                                         Background="#E2E8F0" Foreground="#4F46E5" BorderThickness="0"
                                                         Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. Footer -->
            <Border Grid.Row="4" Background="#F8FAFC" Padding="8,5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock Text="Alt+J to toggle" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
