<Window x:Class="OctalPulse.FloatWindows.MinorTasksFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OctalPulse.Converters"
        Title="Minor Tasks"
        Width="380"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <!-- Main Container: White background, sharp edges, clean border -->
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,8,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                          Fill="#059669" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Minor Tasks" Foreground="#0F172A"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <Button Grid.Column="2" x:Name="LockButton" Style="{StaticResource HeaderBtn}"
                            ToolTip="Lock / Unlock position" Click="LockButton_Click">
                        <TextBlock x:Name="LockGlyph" Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource HeaderBtn}"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource HeaderBtn}"
                            Click="CloseButton_Click" ToolTip="Hide">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Search -->
            <Border Grid.Row="1" Background="#FFFFFF" Padding="10,8,10,4">
                <TextBox Style="{StaticResource FilterBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search minor tasks by title or parent task..."/>
            </Border>

            <!-- 3. Filter Controls -->
            <Border Grid.Row="2" Background="#FFFFFF" Padding="10,0,10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="0"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableProjects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              ToolTip="Filter by Project"/>

                    <!-- Track Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              ToolTip="Filter by Track"/>

                    <!-- Major Task Dropdown -->
                    <ComboBox Grid.Row="2" Grid.Column="0"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableMajorTasks}"
                              SelectedItem="{Binding SelectedMajorTask, Mode=TwoWay}"
                              ToolTip="Filter by Major Task"/>

                    <!-- State Dropdown -->
                    <ComboBox Grid.Row="2" Grid.Column="2"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableStates}"
                              SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                              ToolTip="Filter by State"/>
                </Grid>
            </Border>

            <!-- 4. Minor Tasks List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#F8FAFC"
                          Padding="10,8">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock Text="No minor tasks matching the selected filters."
                               Foreground="#94A3B8"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MyMinorTasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding MyMinorTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="10,8">
                                    <StackPanel>
                                        <!-- Project / Track header -->
                                        <WrapPanel Margin="0,0,0,4">
                                            <!-- Project Badge -->
                                            <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                                                    CornerRadius="0" Padding="5,2" Margin="0,0,4,2">
                                                <TextBlock Foreground="#4338CA" FontSize="9" FontWeight="Bold">
                                                    <Run Text="📁 "/><Run Text="{Binding ProjectTitle, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>

                                            <!-- Track Badge -->
                                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                    CornerRadius="0" Padding="5,2" Margin="0,0,4,2">
                                                <TextBlock Foreground="#0369A1" FontSize="9" FontWeight="SemiBold">
                                                    <Run Text="⚡ "/><Run Text="{Binding TrackTitle, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Parent Major Task breadcrumb -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="0" Padding="6,2" Margin="0,0,0,6">
                                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="9" Foreground="#64748B">
                                                <Run Text="Parent Task: " FontWeight="SemiBold"/><Run Text="{Binding MajorTaskTitle, Mode=OneWay}" Foreground="#0F172A" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Minor Task Title -->
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#0F172A"
                                                   FontSize="12" FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <!-- State + Job Type + Worktime -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- State badge -->
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="0" Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding State}" FontSize="9" Foreground="#475569" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Job Type -->
                                            <Border CornerRadius="0" Padding="5,2" Margin="0,0,6,0"
                                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                                                <TextBlock Text="{Binding JobType}" FontSize="9" Foreground="#059669" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Logged Time -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="0" Padding="5,2">
                                                <TextBlock FontSize="9" Foreground="#64748B" FontWeight="SemiBold">
                                                    <Run Text="⏱ "/><Run Text="{Binding FormattedWorkTime, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. Footer -->
            <Border Grid.Row="4" Background="#F8FAFC" Padding="8,5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock Text="Alt+N to toggle" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
