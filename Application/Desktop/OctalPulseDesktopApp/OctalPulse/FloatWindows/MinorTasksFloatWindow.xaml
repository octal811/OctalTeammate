<Window x:Class="OctalPulse.FloatWindows.MinorTasksFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OctalPulse.Converters"
        Title="Minor Tasks"
        Width="380"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <!-- Main Container: Theme-driven background, sharp edges, clean border -->
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,8,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                          Fill="{DynamicResource Brush.Success}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Minor Tasks" Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <Button Grid.Column="2" x:Name="LockButton" Style="{StaticResource HeaderBtn}"
                            ToolTip="Lock / Unlock position" Click="LockButton_Click">
                        <TextBlock x:Name="LockGlyph" Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource HeaderBtn}"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource HeaderBtn}"
                            Click="CloseButton_Click" ToolTip="Hide">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Search Box -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" Padding="10,8,10,4">
                <TextBox Style="{StaticResource FilterBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search minor tasks by title..."/>
            </Border>

            <!-- 3. Filter Controls -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" Padding="10,0,10,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="0"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableProjects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              ToolTip="Filter by Project"/>

                    <!-- Track Dropdown -->
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              ToolTip="Filter by Track"/>

                    <!-- Major Task Dropdown -->
                    <ComboBox Grid.Row="2" Grid.Column="0"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableMajorTasks}"
                              SelectedItem="{Binding SelectedMajorTask, Mode=TwoWay}"
                              ToolTip="Filter by Major Task"/>

                    <!-- State Dropdown -->
                    <ComboBox Grid.Row="2" Grid.Column="2"
                              Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding AvailableStates}"
                              SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                              ToolTip="Filter by State"/>
                </Grid>
            </Border>

            <!-- 4. Minor Tasks List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource Brush.Background}"
                          Padding="10,8">
                <StackPanel>
                    <TextBlock Text="No minor tasks matching the selected filters."
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="{DynamicResource Brush.CardBackground}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- State Left Stripe -->
                                        <Border Grid.Column="0" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="InProgress">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1">
                                            <!-- Project & Track Header -->
                                            <WrapPanel Margin="0,0,0,3">
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="0" Padding="4,1" Margin="0,0,4,2">
                                                    <TextBlock Foreground="{DynamicResource Brush.Primary}" FontSize="9" FontWeight="Bold">
                                                        <Run Text="📁 "/><Run Text="{Binding ProjectTitle, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="0" Padding="4,1" Margin="0,0,4,2">
                                                    <TextBlock Foreground="{DynamicResource Brush.Info}" FontSize="9" FontWeight="SemiBold">
                                                        <Run Text="⚡ "/><Run Text="{Binding TrackTitle, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Parent Major Task label -->
                                            <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="9" Margin="0,0,0,3">
                                                <Run Text="Task: "/><Run Text="{Binding MajorTaskTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>

                                            <!-- Minor Task Title -->
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       FontSize="11" FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"/>

                                            <!-- Badges Row -->
                                            <WrapPanel>
                                                <!-- State Badge -->
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="0" Padding="4,1" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Job Type Badge -->
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="0" Padding="4,1" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding JobType}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="9"/>
                                                </Border>

                                                <!-- Logged Time Badge -->
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="0" Padding="4,1" Margin="0,0,4,2">
                                                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="9">
                                                        <Run Text="⏱ "/><Run Text="{Binding FormattedWorkTime, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. Footer -->
            <Border Grid.Row="4" Background="{DynamicResource Brush.SurfaceElevated}" Padding="8,5" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <TextBlock Text="Alt+N to toggle" Foreground="{DynamicResource Brush.TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
