<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Theme: Light  -->
    <Color x:Key="Color.Background">#F8FAFC</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceElevated">#F1F5F9</Color>
    <Color x:Key="Color.SurfaceHover">#E2E8F0</Color>
    <Color x:Key="Color.CardBackground">#FFFFFF</Color>

    <Color x:Key="Color.Primary">#6366F1</Color>
    <Color x:Key="Color.PrimaryHover">#4F46E5</Color>
    <Color x:Key="Color.PrimaryForeground">#FFFFFF</Color>

    <Color x:Key="Color.TextPrimary">#0F172A</Color>
    <Color x:Key="Color.TextSecondary">#475569</Color>
    <Color x:Key="Color.TextMuted">#94A3B8</Color>

    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.BorderFocused">#6366F1</Color>

    <Color x:Key="Color.Success">#10B981</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.Info">#3B82F6</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}" />

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="{StaticResource Color.PrimaryForeground}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderFocused" Color="{StaticResource Color.BorderFocused}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <!--  No glow effect in Light theme  -->
    <x:Null x:Key="Effect.CardGlow" />
    <!-- Normal border thickness in Light theme -->
    <Thickness x:Key="Theme.BorderThickness">1</Thickness>

</ResourceDictionary>
