<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Font.Main">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSize.Xs" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSize.Sm" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSize.Base" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSize.Md" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSize.Lg" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSize.Xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
    <sys:Double x:Key="FontSize.2Xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>

    <!-- Text Styles -->
    <Style x:Key="Text.Heading1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.2Xl}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Heading2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Xl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Heading3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Lg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Xs}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

</ResourceDictionary>
