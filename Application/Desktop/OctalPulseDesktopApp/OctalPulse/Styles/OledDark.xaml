<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme: OLED Dark — Pure black with diamond white→indigo→white neon borders -->

    <!-- Surfaces -->
    <Color x:Key="Color.Background">#000000</Color>
    <Color x:Key="Color.Surface">#000000</Color>
    <Color x:Key="Color.SurfaceElevated">#0A0A0A</Color>
    <Color x:Key="Color.SurfaceHover">#111111</Color>
    <Color x:Key="Color.CardBackground">#000000</Color>

    <!-- Accent -->
    <Color x:Key="Color.Primary">#6366F1</Color>
    <Color x:Key="Color.PrimaryHover">#818CF8</Color>
    <Color x:Key="Color.PrimaryForeground">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#CBD5E1</Color>
    <Color x:Key="Color.TextMuted">#7E8B9B</Color>

    <!-- Kept for converters/compat that reference Color.Border by name -->
    <Color x:Key="Color.Border">#818CF8</Color>
    <Color x:Key="Color.BorderFocused">#C7D2FE</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.Info">#60A5FA</Color>

    <!-- ── Brushes ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Brush.Background"      Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface"         Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover"    Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.CardBackground"  Color="{StaticResource Color.CardBackground}" />

    <SolidColorBrush x:Key="Brush.Primary"           Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover"      Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="{StaticResource Color.PrimaryForeground}" />

    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="{StaticResource Color.TextMuted}" />

    <!--
        DIAMOND BORDER — white at corners, indigo in the middle.
        Diagonal gradient (0,0 → 1,1) = top-left white, centre indigo, bottom-right white.
        Exactly like the OLED card preview border in Settings.
    -->
    <LinearGradientBrush x:Key="Brush.Border" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#818CF8" Offset="0.5" />
        <GradientStop Color="#FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Focused = full neon indigo-white sweep -->
    <LinearGradientBrush x:Key="Brush.BorderFocused" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C7D2FE" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#C7D2FE" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info"    Color="{StaticResource Color.Info}" />

    <!-- Standard 1px border so borders align precisely to physical pixel grid -->
    <Thickness x:Key="Theme.BorderThickness">1</Thickness>

    <!-- No glow effect on cards to preserve native vector rendering and ClearType text without bitmap blur -->
    <x:Null x:Key="Effect.CardGlow" />

    <!-- No glow effect (used as null sentinel) -->
    <x:Null x:Key="Effect.NoGlow" />

</ResourceDictionary>
