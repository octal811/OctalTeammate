<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme: Heavy Glasses — Deep obsidian black tinted glass with ~80% opacity & sterling silver accents -->

    <!-- Surfaces (~80% opacity / 0xCC alpha: shows background subtly like dark tinted glass) -->
    <Color x:Key="Color.Background">#CC080B10</Color>
    <Color x:Key="Color.Surface">#CC0F131A</Color>
    <Color x:Key="Color.SurfaceElevated">#D9161B24</Color>
    <Color x:Key="Color.SurfaceHover">#E0242C3A</Color>
    <Color x:Key="Color.CardBackground">#CC121720</Color>

    <!-- Sterling Silver Accents -->
    <Color x:Key="Color.Primary">#CBD5E1</Color>
    <Color x:Key="Color.PrimaryHover">#FFFFFF</Color>
    <Color x:Key="Color.PrimaryForeground">#080B10</Color>

    <!-- Typography -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#CBD5E1</Color>
    <Color x:Key="Color.TextMuted">#7B899C</Color>

    <!-- Silver Frosted Glass Borders -->
    <Color x:Key="Color.Border">#60CBD5E1</Color>
    <Color x:Key="Color.BorderFocused">#FFFFFF</Color>

    <!-- Status Indicators -->
    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.Info">#38BDF8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Background"      Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface"         Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover"    Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.CardBackground"  Color="{StaticResource Color.CardBackground}" />

    <!-- Polished Silver Primary Brush -->
    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#CBD5E1" Offset="0.5" />
        <GradientStop Color="#94A3B8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#E2E8F0" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="{StaticResource Color.PrimaryForeground}" />

    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="{StaticResource Color.TextMuted}" />

    <!-- Silver & Black Tinted Glass Bevel Border -->
    <LinearGradientBrush x:Key="Brush.Border" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0.0" />
        <GradientStop Color="#4064748B" Offset="0.5" />
        <GradientStop Color="#99CBD5E1" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.BorderFocused" Color="{StaticResource Color.BorderFocused}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info"    Color="{StaticResource Color.Info}" />

    <!-- Dark Aviator Glass Silver Sheen Glow -->
    <DropShadowEffect x:Key="Effect.CardGlow"
                      BlurRadius="16"
                      Direction="0"
                      Opacity="0.25"
                      ShadowDepth="0"
                      Color="#CBD5E1" />

    <Thickness x:Key="Theme.BorderThickness">1</Thickness>

</ResourceDictionary>
