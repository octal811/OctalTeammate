<UserControl x:Class="OctalPulse.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Brand Hero Left Panel -->
            <ColumnDefinition Width="1.2*" />
            <!-- Form Card Right Panel -->
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <!-- Left Brand Banner -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource Color.Border}" Opacity="0.5" />
            </Border.BorderBrush>
            <Border BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="50,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- App Brand Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.Primary}" Margin="0,0,14,0">
                                <Path Data="{StaticResource Icon.Logo}" Fill="{DynamicResource Brush.PrimaryForeground}" Width="24" Height="24" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="OCTALPULSE" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="Team &amp; Work Management" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="Medium" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Hero Visual Content -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,30">
                            <TextBlock Text="Streamline your development workflows." 
                                       FontSize="28" FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.TextPrimary}" 
                                       TextWrapping="Wrap" LineHeight="36" Margin="0,0,0,16" />
                            <TextBlock Text="Hierarchical task breakdown from projects down to atomic work units. Track progress, collaborate in real time with SignalR, and stay in sync." 
                                       FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" 
                                       TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30" />

                            <!-- Feature highlights -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Tracks}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,14,0" />
                                    <TextBlock Text="Vertical workstream tracks with team lead curation" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.Success}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,14,0" />
                                    <TextBlock Text="Live auto-calculated progress derived from completed tasks" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer note -->
                        <TextBlock Grid.Row="2" Text="OctalTeammate Desktop Client • Production Grade" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- Right Login Form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Margin="40,24">
                <Border Style="{StaticResource Border.Card}" Padding="36">
                    <StackPanel>
                        <!-- Form Header -->
                        <TextBlock Text="Sign in to your account" Style="{StaticResource Text.Heading2}" Margin="0,0,0,6" />
                        <TextBlock Text="Enter your team credentials to access your workspace" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,24" />

                        <!-- Error Alert Banner -->
                        <Border Background="#2DFE5353" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap" />
                        </Border>

                        <!-- Saved Accounts Section -->
                        <StackPanel Visibility="{Binding HasSavedAccounts, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20">
                            <TextBlock Text="Saved accounts" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SavedAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="Saved password on this device" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="Sign In" Margin="0,0,8,0" Height="30" Padding="16,0"
                                                        Command="{Binding DataContext.SignInWithSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Remove" Height="30"
                                                        Command="{Binding DataContext.RemoveSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Email Field -->
                        <TextBlock Text="Email Address" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,18" />

                        <!-- Password Field -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Forgot password?" Command="{Binding NavigateToForgotPasswordCommand}" 
                                    FontSize="12" Height="Auto" Padding="0" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <PasswordBox x:Name="PwdBox" Style="{StaticResource PasswordBox.Modern}" PasswordChanged="PasswordBox_PasswordChanged" />
                        </Grid>

                        <!-- Remember Me & Options -->
                        <Grid Margin="0,0,0,24">
                            <CheckBox Content="Remember this device" IsChecked="{Binding RememberMe}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Verify email?" Command="{Binding NavigateToVerifyEmailCommand}" 
                                    FontSize="12" Height="Auto" Padding="0" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Submit Button -->
                        <Button Style="{StaticResource Button.Primary}" Content="Sign In" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,0,0,20" />

                        <!-- Busy Loading Indicator -->
                        <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

                        <!-- Register Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Don't have an account?" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Create account" Command="{Binding NavigateToRegisterCommand}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Padding="0" Height="Auto" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
