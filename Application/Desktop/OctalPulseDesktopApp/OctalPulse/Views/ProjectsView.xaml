<UserControl x:Class="OctalPulse.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
            <StackPanel>
                <!-- Title & Actions Row -->
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Team Projects" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
                        <TextBlock Text="Manage your software projects, curate workstreams, and coordinate team members." Style="{StaticResource Text.Subtitle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Secondary}" Content="Join Project" Command="{Binding OpenJoinModalCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="+ New Project" Command="{Binding OpenCreateModalCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Search & Filters Toolbar -->
                <Border Style="{StaticResource Border.Card}" Padding="16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Input -->
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBox.Modern}" 
                                 Tag="Search projects by title or description..." 
                                 Margin="0,0,16,0" />

                        <!-- Status Filter -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Style="{StaticResource ComboBox.Modern}" Height="42" />
                    </Grid>
                </Border>

                <!-- Loading Progress -->
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

                <!-- Empty State -->
                <Border Style="{StaticResource Border.Card}" Padding="40" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                        Visibility="{Binding DisplayedProjects.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Projects}" Fill="{DynamicResource Brush.TextMuted}" Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,16" />
                        <TextBlock Text="No projects found matching your criteria." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Try adjusting your search terms or create a new project workspace." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Button Style="{StaticResource Button.Primary}" Content="Create New Project" Command="{Binding OpenCreateModalCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Projects Grid -->
                <ItemsControl x:Name="ProjectsControl" ItemsSource="{Binding DisplayedProjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Border.Card}" Margin="0,0,18,18" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Width="300" HorizontalAlignment="Left" />
                                        <!-- Status Badge -->
                                        <Border HorizontalAlignment="Right" CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.SurfaceElevated}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description, FallbackValue='No description provided.'}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,0,0,16" />

                                    <!-- Progress Bar -->
                                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Project Progress" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <Button Grid.Row="3" Style="{StaticResource Button.Secondary}" Content="Open Project Workspace →" 
                                            Command="{Binding DataContext.OpenProjectDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" HorizontalAlignment="Right" Height="34" Padding="14,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Modal: Create Project ────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Create New Project" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseCreateModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Project Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewProjectTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="120" Margin="0,0,0,16" />

                        <TextBlock Text="Initial Status" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding NewProjectStatus}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseCreateModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Create Project" Command="{Binding SubmitCreateProjectCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Modal: Join Project ──────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsJoinModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="480" MaxHeight="580" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Request to Join Project" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseJoinModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Enter the Project GUID and choose your initial project role. The project creator will review and approve your request." 
                                   FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20" />

                        <TextBlock Text="Project ID (GUID)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding JoinProjectId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Your Role in Project" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding JoinSelectedRole}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseJoinModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Send Join Request" Command="{Binding SubmitJoinProjectCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
