<UserControl x:Class="OctalPulse.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
            <StackPanel>
                <!-- Back Navigation -->
                <Button Style="{StaticResource Button.Ghost}" Content="← Back to Projects" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="0" />

                <!-- Project Hero Card -->
                <Border Style="{StaticResource Border.Card}" Padding="28" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Title & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Project.Title}" Style="{StaticResource Text.Heading1}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                
                                <!-- Interactive Status Selector Dropdown -->
                                <ComboBox ItemsSource="{Binding AvailableStatuses}" 
                                          SelectedItem="{Binding CurrentStatus, Mode=TwoWay}"
                                          Style="{StaticResource ComboBox.Modern}" 
                                          Height="36" Width="145" VerticalAlignment="Center"
                                          ToolTip="Change project status">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Converter={StaticResource StatusToBrush}}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Project Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Secondary}" Content="Edit Project" Command="{Binding OpenEditProjectModalCommand}" Height="34" Padding="14,0" Margin="0,0,10,0" />
                                <Button Style="{StaticResource Button.Danger}" Content="Delete Project" Command="{Binding DeleteProjectCommand}" 
                                        Visibility="{Binding IsCreator, Converter={StaticResource BoolToVis}}" Height="34" Padding="12,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Description -->
                        <TextBlock Grid.Row="1" Text="{Binding Project.Description, FallbackValue='No description provided for this project.'}" 
                                   FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20" />

                        <!-- Row 2: Metadata & Progress -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Creator: " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Project.Creator.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,24,0" />

                                <TextBlock Text="Team Members: " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Project.MembersCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            </StackPanel>

                            <!-- Overall Progress Bar -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Project Progress" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Text="{Binding Project.Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding Project.Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Navigation Tabs: Tracks / Members / Events -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tracks Tab Button -->
                        <Button Style="{StaticResource Button.Ghost}" Content="Tracks (Workstreams)" Command="{Binding SelectTabCommand}" CommandParameter="Tracks" 
                                FontSize="14" FontWeight="SemiBold" Height="40" Padding="16,0" Margin="0,0,8,0" />
                        <!-- Members Tab Button -->
                        <Button Style="{StaticResource Button.Ghost}" Content="Team Members" Command="{Binding SelectTabCommand}" CommandParameter="Members" 
                                FontSize="14" FontWeight="SemiBold" Height="40" Padding="16,0" Margin="0,0,8,0" />
                        <!-- Events Tab Button -->
                        <Button Style="{StaticResource Button.Ghost}" Content="Project Events" Command="{Binding SelectTabCommand}" CommandParameter="Events" 
                                FontSize="14" FontWeight="SemiBold" Height="40" Padding="16,0" />
                    </StackPanel>
                </Border>

                <!-- Loading Bar -->
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

                <!-- ── TAB 1: TRACKS ─────────────────────────────────────────── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Tracks">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Tracks Header -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Workstream Tracks" Style="{StaticResource Text.Heading3}" />
                        <Button Style="{StaticResource Button.Primary}" Content="+ Add Track" Command="{Binding OpenCreateTrackModalCommand}" HorizontalAlignment="Right" Height="36" Padding="14,0" />
                    </Grid>

                    <!-- Tracks Empty State -->
                    <Border Style="{StaticResource Border.Card}" Padding="32" Visibility="{Binding Tracks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No tracks created yet." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Create a track to organize deliverables by engineering vertical (e.g., Backend, Frontend, Mobile, AI)." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <Button Style="{StaticResource Button.Primary}" Content="Create First Track" Command="{Binding OpenCreateTrackModalCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tracks Cards Grid -->
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Border.Card}" Width="440" Margin="0,0,18,18" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Track Name -->
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />

                                        <!-- Track Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description, FallbackValue='No description provided.'}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />

                                        <!-- Track Progress -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Progress from Major Tasks" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                                        </StackPanel>

                                        <!-- Enter Track Workspace -->
                                        <Button Grid.Row="3" Style="{StaticResource Button.Secondary}" Content="Open Track Workspace →" 
                                                Command="{Binding DataContext.OpenTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" HorizontalAlignment="Right" Height="34" Padding="14,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── TAB 2: MEMBERS ────────────────────────────────────────── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Members">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Approved Team Members" Style="{StaticResource Text.Heading3}" Margin="0,0,0,18" />

                    <Border Style="{StaticResource Border.Card}" Padding="20">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.SurfaceElevated}" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name[0]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ── TAB 3: EVENTS ─────────────────────────────────────────── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Events">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Project Events &amp; Milestones" Style="{StaticResource Text.Heading3}" />
                        <Button Style="{StaticResource Button.Primary}" Content="+ Add Event" Command="{Binding OpenCreateEventModalCommand}" HorizontalAlignment="Right" Height="36" Padding="14,0" />
                    </Grid>

                    <Border Style="{StaticResource Border.Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="No events found for this project." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding Events.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,10" HorizontalAlignment="Center" />

                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="10,6" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StartDate, Converter={StaticResource DateFormatter}, ConverterParameter='MMM dd, yyyy'}" 
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" Background="{DynamicResource Brush.SurfaceElevated}">
                                                    <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Modal: Edit Project ──────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsEditProjectModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Edit Project Details" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseEditProjectModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Project Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditProjectTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Description" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditProjectDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="130" Margin="0,0,0,16" />

                        <TextBlock Text="Project Status" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditProjectStatus}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,24,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Converter={StaticResource StatusToBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,20,0,0">
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseEditProjectModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Save Changes" Command="{Binding SubmitEditProjectCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Modal: Create Track ──────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateTrackModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="500" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Create Workstream Track" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseCreateTrackModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Track Name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTrackName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTrackDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="110" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseCreateTrackModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Create Track" Command="{Binding SubmitCreateTrackCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Modal: Create Event ──────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateEventModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="500" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Add Project Event" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseCreateEventModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Event Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewEventTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Event Type" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableEventTypes}" SelectedItem="{Binding NewEventType}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Event Date" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding NewEventDate}" Height="40" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewEventDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="110" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseCreateEventModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Save Event" Command="{Binding SubmitCreateEventCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
