<UserControl x:Class="OctalPulse.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel>
            <!-- Header & Action Row -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Welcome back to your workspace" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
                    <TextBlock Text="Here is an overview of your team projects, tasks progress, and upcoming schedule." Style="{StaticResource Text.Subtitle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Content="Refresh" Command="{Binding LoadDashboardDataCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="View All Projects" Command="{Binding NavigateProjectsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

            <!-- KPI Metric Cards Grid -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1: My Projects -->
                <Border Grid.Column="0" Style="{StaticResource Border.Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Brush.SurfaceElevated}" Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.Projects}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Total Projects" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MyProjectsCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Active organization projects" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric 2: Average Progress -->
                <Border Grid.Column="2" Style="{StaticResource Border.Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Brush.SurfaceElevated}" Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.Success}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Overall Progress" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AverageProgress}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="%" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="Auto-calculated from task completions" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric 3: Upcoming Events -->
                <Border Grid.Column="4" Style="{StaticResource Border.Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Brush.SurfaceElevated}" Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.Calendar}" Fill="{DynamicResource Brush.Info}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Upcoming Events" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpcomingEventsCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Scheduled for this month" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-Column Layout: Recent Projects on Left, Upcoming Schedule on Right -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Recent Projects -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="My Active Projects" Style="{StaticResource Text.Heading3}" Margin="0,0,0,16" />

                    <!-- Empty state -->
                    <Border Style="{StaticResource Border.Card}" Padding="32" HorizontalAlignment="Stretch"
                            Visibility="{Binding RecentProjects.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No active projects found." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Create a project or request to join an existing team workspace." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <Button Style="{StaticResource Button.Primary}" Content="Explore Projects" Command="{Binding NavigateProjectsCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Projects ItemsControl -->
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Border.Card}" Margin="0,0,0,14" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title & Status Chip -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <!-- Status Chip -->
                                            <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,4" Background="{DynamicResource Brush.SurfaceElevated}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description, FallbackValue='No description provided.'}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />

                                        <!-- Progress Bar & Actions -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Progress Bar -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Progress" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                                            </StackPanel>

                                            <!-- Open Workspace Button -->
                                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Open Workspace" 
                                                    Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="34" Padding="12,0" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: Upcoming Schedule -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Upcoming Schedule" Style="{StaticResource Text.Heading3}" Margin="0,0,0,16" />

                    <Border Style="{StaticResource Border.Card}" Padding="18">
                        <StackPanel>
                            <!-- Empty state -->
                            <TextBlock Text="No upcoming events scheduled." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" 
                                       Visibility="{Binding UpcomingEvents.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" 
                                       Margin="0,10" HorizontalAlignment="Center" />

                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding UpcomingEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Date Block -->
                                                    <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="10,6" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StartDate, Converter={StaticResource DateFormatter}, ConverterParameter='MMM dd'}" 
                                                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Event Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource Brush.Primary}" FontWeight="Medium" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                                    Visibility="{Binding CreatedByUserName, Converter={StaticResource NullToVis}}">
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CreatedByUserName, Converter={StaticResource StringToInitial}}" FontSize="8.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                                       Text="{Binding CreatedByUserName, StringFormat='by {0}'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
