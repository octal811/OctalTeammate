<UserControl
    x:Class="OctalPulse.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer
        Padding="32"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
            <!--  Header  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource Text.Heading1}"
                Text="Settings &amp; Integrations" />
            <TextBlock
                Margin="0,0,0,28"
                Style="{StaticResource Text.Subtitle}"
                Text="Manage desktop client preferences, security keys, and developer integrations." />

            <!--  Loading Indicator  -->
            <ProgressBar
                Margin="0,0,0,20"
                IsIndeterminate="True"
                Style="{StaticResource ProgressBar.Modern}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!--  ── SECTION 1: APPEARANCE ───────────────────────────────────  -->
            <Border
                Margin="0,0,0,24"
                Padding="24"
                Style="{StaticResource Border.Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,4,0"
                        Style="{StaticResource Text.Heading3}"
                        Text="Appearance &amp; Theme" />
                    <TextBlock
                        Margin="0,0,0,18"
                        Style="{StaticResource Text.Subtitle}"
                        Text="Select your preferred desktop interface theme. Changes apply instantly without restarting." />

                    <WrapPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <!--  Dark Theme  -->
                        <Border
                            Margin="0,0,14,0"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Cursor="Hand">
                            <Button
                                Width="160"
                                Height="100"
                                Padding="0"
                                Command="{Binding SelectThemeCommand}"
                                CommandParameter="Dark"
                                Style="{StaticResource Button.Ghost}">
                                <StackPanel HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <SkewTransform />
                                            <RotateTransform />
                                            <TranslateTransform X="50" />
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border
                                        Width="64"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Background="#111827"
                                        BorderBrush="#2D3748"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,5,0"
                                                Fill="#6366F1" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Width="62"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="🌙  Dark" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  Light Theme  -->
                        <Border
                            Margin="0,0,14,0"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Cursor="Hand">
                            <Button
                                Width="160"
                                Height="100"
                                Padding="0"
                                Command="{Binding SelectThemeCommand}"
                                CommandParameter="Light"
                                Style="{StaticResource Button.Ghost}">
                                <StackPanel HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <SkewTransform />
                                            <RotateTransform />
                                            <TranslateTransform X="50" />
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border
                                        Width="64"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,5,0"
                                                Fill="#6366F1" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Width="63"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="☀️  Light" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  OLED Dark Theme  -->
                        <Border
                            Margin="0,0,0,0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Cursor="Hand">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFF" />
                                    <GradientStop Offset="0.5" Color="#6366F1" />
                                    <GradientStop Offset="1" Color="#FFFFFF" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Button
                                Width="160"
                                Height="100"
                                Padding="0"
                                Background="#000000"
                                Command="{Binding SelectThemeCommand}"
                                CommandParameter="OledDark"
                                Style="{StaticResource Button.Ghost}">
                                <StackPanel HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <SkewTransform />
                                            <RotateTransform />
                                            <TranslateTransform X="40" />
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border
                                        Width="64"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Background="#000000"
                                        CornerRadius="8">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#FFFFFF" />
                                                <GradientStop Offset="1" Color="#6366F1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border BorderThickness="1.5">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#FFFFFF" />
                                                    <GradientStop Offset="1" Color="#6366F1" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border CornerRadius="6">
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Margin="0,0,5,0"
                                                        Fill="#FFFFFF" />
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Fill="#818CF8" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="⬛ OLED Dark">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#FFFFFF" />
                                                <GradientStop Offset="1" Color="#818CF8" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  Glasses Theme (Grey/Silver with 40% Translucent Background)  -->
                        <Border
                            Margin="14,0,0,0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Cursor="Hand">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFF" />
                                    <GradientStop Offset="0.5" Color="#94A3B8" />
                                    <GradientStop Offset="1" Color="#CBD5E1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Button
                                Width="160"
                                Height="100"
                                Padding="0"
                                Background="#401A222D"
                                Command="{Binding SelectThemeCommand}"
                                CommandParameter="Glasses"
                                Style="{StaticResource Button.Ghost}"
                                ToolTip="Frosted grey &amp; silver glass with 40% translucent background">
                                <StackPanel
                                    Margin="48,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="64"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Background="#59242F3D"
                                        BorderBrush="#80CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,5,0"
                                                Fill="#F8FAFC" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#E2E8F0"
                                        Text="👓 Glasses" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  Heavy Glasses Theme (Deep Black & Silver with Low Translucency / Dark Sunglasses)  -->
                        <Border
                            Margin="14,0,0,0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Cursor="Hand">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFF" />
                                    <GradientStop Offset="0.5" Color="#475569" />
                                    <GradientStop Offset="1" Color="#CBD5E1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Button
                                Width="160"
                                Height="100"
                                Padding="0"
                                Background="#CC080B10"
                                Command="{Binding SelectThemeCommand}"
                                CommandParameter="HeavyGlasses"
                                Style="{StaticResource Button.Ghost}"
                                ToolTip="Deep obsidian black &amp; sterling silver with ~80% opacity (dark tinted glasses)">
                                <StackPanel
                                    Margin="28,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="64"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Background="#0F131A"
                                        BorderBrush="#60CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,5,0"
                                                Fill="#FFFFFF" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="#CBD5E1" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#FFFFFF"
                                        Text="🕶️ Heavy Glasses" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </WrapPanel>

                    <!--  Active Theme Label  -->
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextMuted}">
                        <Run Text="Active theme: " />
                        <Run
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.Primary}"
                            Text="{Binding CurrentTheme}" />
                    </TextBlock>
                </StackPanel>
            </Border>


            <!--  ── SECTION 2: GITHUB INTEGRATION ────────────────────────────  -->
            <Border
                Margin="0,0,0,24"
                Padding="24"
                Style="{StaticResource Border.Card}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Border
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="6">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{StaticResource Icon.GitHub}"
                                Fill="{DynamicResource Brush.TextPrimary}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Heading3}"
                            Text="GitHub Integration (DPAPI Protected)" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        LineHeight="20"
                        Style="{StaticResource Text.Subtitle}"
                        Text="Connect your GitHub account to associate repository commits, pull requests, and issues with project tasks. Your Personal Access Token is hardware-encrypted via Windows DPAPI and never stored in plaintext."
                        TextWrapping="Wrap" />

                    <!--  Not Connected State  -->
                    <StackPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="GitHub Personal Access Token" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Style="{StaticResource TextBox.Modern}"
                                Tag="ghp_xxxxxxxxxxxxxxxxxxxx"
                                Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Height="42"
                                Padding="20,0"
                                Command="{Binding ConnectGitHubCommand}"
                                Content="Connect GitHub"
                                Style="{StaticResource Button.Primary}" />
                        </Grid>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Requires 'repo' and 'read:user' scopes." />
                    </StackPanel>

                    <!--  Connected State  -->
                    <StackPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource BoolToVis}}">
                        <Border
                            Margin="0,0,0,18"
                            Padding="16"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  GitHub Avatar placeholder  -->
                                <Border
                                    Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    Margin="0,0,14,0"
                                    Background="{DynamicResource Brush.Primary}"
                                    CornerRadius="21">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="#FFFFFF"
                                        Text="{Binding GitHubUser.Login[0]}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding GitHubUser.Login}" />
                                        <Border
                                            Padding="6,2"
                                            Background="#2D10B981"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.Success}"
                                                Text="Connected" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="{Binding GitHubUser.Bio, FallbackValue='GitHub Developer'}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Height="34"
                                    Padding="14,0"
                                    Command="{Binding DisconnectGitHubCommand}"
                                    Content="Disconnect"
                                    Style="{StaticResource Button.Danger}" />
                            </Grid>
                        </Border>

                        <!--  Repositories List  -->
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Your Repositories" />
                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="0,8"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource Brush.Primary}"
                                                Text="{Binding FullName}" />
                                            <TextBlock
                                                Width="300"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!--  ── SECTION 3: GEMINI AI & OCTO SUPPORTER ────────────────────  -->
            <Border
                Margin="0,0,0,24"
                Padding="24"
                Style="{StaticResource Border.Card}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Border
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Brush.PrimarySoft}"
                            CornerRadius="6">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{StaticResource Icon.Sparkles}"
                                Fill="{DynamicResource Brush.Primary}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Heading3}"
                            Text="Google Gemini AI — Octo Supporter (DPAPI Protected)" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        LineHeight="20"
                        Style="{StaticResource Text.Subtitle}"
                        Text="Connect your personal Google Gemini API key to empower Octo — your AI assistant that analyzes tasks, dependencies, priorities, and project progression. Your API key is encrypted via Windows DPAPI and stored only on this device. It is never transmitted to other users."
                        TextWrapping="Wrap" />

                    <!--  Not Connected State  -->
                    <StackPanel Visibility="{Binding IsGeminiConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Google Gemini API Key" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Style="{StaticResource TextBox.Modern}"
                                Tag="AIzaSy..."
                                Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Height="42"
                                Padding="20,0"
                                Command="{Binding ConnectGeminiCommand}"
                                Content="Connect Gemini"
                                Style="{StaticResource Button.Primary}" />
                        </Grid>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Obtain a free or paid API key at Google AI Studio (aistudio.google.com). After connecting, you can choose which Gemini model Octo uses."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Connected State  -->
                    <StackPanel Visibility="{Binding IsGeminiConnected, Converter={StaticResource BoolToVis}}">
                        <Border
                            Margin="0,0,0,16"
                            Padding="16"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    Margin="0,0,14,0"
                                    Background="{DynamicResource Brush.PrimarySoft}"
                                    CornerRadius="21">
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Sparkles}"
                                        Fill="{DynamicResource Brush.Primary}"
                                        Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="Google Gemini Connected" />
                                        <Border
                                            Padding="6,2"
                                            Background="#2D10B981"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.Success}"
                                                Text="Octo Ready" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="Key: " />
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Text="{Binding GeminiMaskedKeyDisplay}" />
                                        <Border
                                            Padding="6,1"
                                            Background="{DynamicResource Brush.Surface}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource Brush.Primary}"
                                                Text="{Binding GeminiModel}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Height="34"
                                    Padding="14,0"
                                    Command="{Binding DisconnectGeminiCommand}"
                                    Content="Disconnect"
                                    Style="{StaticResource Button.Danger}" />
                            </Grid>
                        </Border>

                        <!--  ── Model Selector ───────────────────────────────────  -->
                        <Border
                            Margin="0,0,0,0"
                            Padding="18"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="10">
                            <StackPanel>
                                <!--  Header row  -->
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="⚙️" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Gemini Model" />
                                </StackPanel>

                                <!--  Description  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="Choose which Gemini model Octo uses. Newer models are smarter but may count against your quota faster."
                                    TextWrapping="Wrap" />

                                <!--  Dropdown + Apply button  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  ComboBox with curated model list  -->
                                    <ComboBox
                                        Grid.Column="0"
                                        Height="42"
                                        ItemsSource="{Binding AvailableGeminiModels}"
                                        SelectedItem="{Binding GeminiModelInput, Mode=TwoWay}"
                                        Style="{StaticResource ComboBox.Modern}" />

                                    <!--  Apply button  -->
                                    <Button
                                        Grid.Column="2"
                                        Height="42"
                                        Padding="20,0"
                                        Command="{Binding SaveGeminiModelCommand}"
                                        Content="💾  Apply"
                                        Style="{StaticResource Button.Primary}" />
                                </Grid>

                                <!--  Active model badge  -->
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="Active: " />
                                    <Border
