<UserControl x:Class="OctalPulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000">

<UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Settings &amp; Integrations" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
            <TextBlock Text="Manage desktop client preferences, security keys, and developer integrations." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,28" />

<!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

            <!-- ── SECTION 1: APPEARANCE ─────────────────────────────────── -->
            <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Theme" Style="{StaticResource Text.Heading3}" Margin="0,0,4,0" />
                    <TextBlock Text="Select your preferred desktop interface theme. Changes apply instantly without restarting." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Dark Theme -->
                        <Border CornerRadius="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,14,0" Cursor="Hand">
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding SelectThemeCommand}" CommandParameter="Dark"
                                    Width="160" Height="100" Padding="0">
                                <StackPanel HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform X="50"/>
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border Width="64" Height="40" CornerRadius="8" Margin="0,0,0,8" Background="#111827"
                                            BorderBrush="#2D3748" BorderThickness="1.5">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#6366F1" Margin="0,0,5,0" />
                                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="🌙  Dark" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Width="62" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Light Theme -->
                        <Border CornerRadius="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,14,0" Cursor="Hand">
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding SelectThemeCommand}" CommandParameter="Light"
                                    Width="160" Height="100" Padding="0">
                                <StackPanel HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform X="50"/>
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border Width="64" Height="40" CornerRadius="8" Margin="0,0,0,8" Background="#F8FAFC"
                                            BorderBrush="#E2E8F0" BorderThickness="1.5">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#6366F1" Margin="0,0,5,0" />
                                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="☀️  Light" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" Width="63" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- OLED Dark Theme -->
                        <Border CornerRadius="10" Margin="0,0,0,0" Cursor="Hand"
                                BorderThickness="1.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="0.5" />
                                    <GradientStop Color="#FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding SelectThemeCommand}" CommandParameter="OledDark"
                                    Width="160" Height="100" Padding="0" Background="#000000">
                                <StackPanel HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform X="40"/>
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                    <Border Width="64" Height="40" CornerRadius="8" Margin="0,0,0,8" Background="#000000">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                <GradientStop Color="#6366F1" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border BorderThickness="1.5">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                                    <GradientStop Color="#6366F1" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border CornerRadius="6">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,5,0" />
                                                    <Ellipse Width="8" Height="8" Fill="#818CF8" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="⬛ OLED Dark" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                <GradientStop Color="#818CF8" Offset="1" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Active Theme Label -->
                    <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}">
                        <Run Text="Active theme: " />
                        <Run Text="{Binding CurrentTheme}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                    </TextBlock>
                </StackPanel>
            </Border>


            <!-- ── SECTION 2: GITHUB INTEGRATION ──────────────────────────── -->
            <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Margin="0,0,10,0">
                            <Path Data="{StaticResource Icon.GitHub}" Fill="{DynamicResource Brush.TextPrimary}" Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="GitHub Integration (DPAPI Protected)" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Connect your GitHub account to associate repository commits, pull requests, and issues with project tasks. Your Personal Access Token is hardware-encrypted via Windows DPAPI and never stored in plaintext." 
                               Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

                    <!-- Not Connected State -->
                    <StackPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="GitHub Personal Access Token" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Tag="ghp_xxxxxxxxxxxxxxxxxxxx" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="Connect GitHub" Command="{Binding ConnectGitHubCommand}" Height="42" Padding="20,0" />
                        </Grid>
                        <TextBlock Text="Requires 'repo' and 'read:user' scopes." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>

                    <!-- Connected State -->
                    <StackPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- GitHub Avatar placeholder -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Brush.Primary}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding GitHubUser.Login[0]}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GitHubUser.Login}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,10,0" />
                                        <Border Background="#2D10B981" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="Connected" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GitHubUser.Bio, FallbackValue='GitHub Developer'}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource Button.Danger}" Content="Disconnect" Command="{Binding DisconnectGitHubCommand}" Height="34" Padding="14,0" />
                            </Grid>
                        </Border>

                        <!-- Repositories List -->
                        <TextBlock Text="Your Repositories" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding FullName}" FontSize="13" Foreground="{DynamicResource Brush.Primary}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" Width="300" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ── SECTION 3: GEMINI AI & OCTO SUPPORTER ──────────────────── -->
            <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,10,0">
                            <Path Data="{StaticResource Icon.Sparkles}" Fill="{DynamicResource Brush.Primary}" Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Google Gemini AI — Octo Supporter (DPAPI Protected)" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Connect your personal Google Gemini API key to empower Octo — your AI assistant that analyzes tasks, dependencies, priorities, and project progression. Your API key is encrypted via Windows DPAPI and stored only on this device. It is never transmitted to other users." 
                               Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

                    <!-- Not Connected State -->
                    <StackPanel Visibility="{Binding IsGeminiConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Google Gemini API Key" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Tag="AIzaSy..." Margin="0,0,12,0" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="Connect Gemini" Command="{Binding ConnectGeminiCommand}" Height="42" Padding="20,0" />
                        </Grid>
                        <TextBlock Text="Obtain a free or paid API key at Google AI Studio (aistudio.google.com). After connecting, you can choose which Gemini model Octo uses." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Connected State -->
                    <StackPanel Visibility="{Binding IsGeminiConnected, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0">
                                    <Path Data="{StaticResource Icon.Sparkles}" Fill="{DynamicResource Brush.Primary}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Google Gemini Connected" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,10,0" />
                                        <Border Background="#2D10B981" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="Octo Ready" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Key: " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                        <TextBlock Text="{Binding GeminiMaskedKeyDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0" />
                                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding GeminiModel}" FontSize="11" Foreground="{DynamicResource Brush.Primary}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource Button.Danger}" Content="Disconnect" Command="{Binding DisconnectGeminiCommand}" Height="34" Padding="14,0" />
                            </Grid>
                        </Border>

                        <!-- ── Model Selector ─────────────────────────────────── -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="18" Margin="0,0,0,0">
                            <StackPanel>
                                <!-- Header row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Gemini Model" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Text="Choose which Gemini model Octo uses. Newer models are smarter but may count against your quota faster."
                                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <!-- Dropdown + Apply button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ComboBox with curated model list -->
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableGeminiModels}"
                                              SelectedItem="{Binding GeminiModelInput, Mode=TwoWay}"
                                              Style="{StaticResource ComboBox.Modern}"
                                              Height="42" />

                                    <!-- Apply button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource Button.Primary}"
                                            Content="💾  Apply"
                                            Command="{Binding SaveGeminiModelCommand}"
                                            Height="42" Padding="20,0" />
                                </Grid>

                                <!-- Active model badge -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Active: " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="{Binding GeminiModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ── SECTION 4: FLOATING WINDOWS & SHORTCUT GUIDE (CHEAT SHEET) ── -->
            <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,10,0">
                            <Path Data="{StaticResource Icon.Dashboard}" Fill="{DynamicResource Brush.Primary}" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Floating Windows &amp; Hotkeys Guide" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Global keyboard shortcuts allow you to instantly summon or toggle floating widgets and overlay boards from anywhere in Windows, even when OctalPulse is minimized or another application has focus." 
                               Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18" />

                    <!-- Pro Tip Banner -->
                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Sparkles}" Fill="{DynamicResource Brush.Primary}" Width="13" Height="13" Stretch="Uniform" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap">
                                <Run Text="⚡ Global Windows Hotkeys:" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                                <Run Text=" Press any combination below from any game, browser, or code editor to pop open its floating overlay. You can also click Test Open to preview any window now." />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Shortcut Cheat Sheet Cards -->
                    <StackPanel>
                        <!-- 1. Alt + W: Main Window -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Dashboard}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Main Workspace Window" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Restores and brings the primary OctalPulse hub to the foreground from tray or background." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Key Badge -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="W" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Open" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="main" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Alt + N: Minor Tasks Board -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Minor Tasks Board" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Compact floating sticky checklist to quickly add, review, and check off agile subtasks." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="N" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Toggle" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="minortasks" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 3. Alt + J: Major Tasks Board -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Briefcase}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Major Tasks Board" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Floating agile kanban board with sprint milestones, priority indicators, and track items." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="J" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Toggle" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="majortasks" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 4. Alt + M: Media -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Media}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Media Player" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Floating lightweight music controller and audio stream player for productive sessions." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="M" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Toggle" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="media" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 5. Alt + T: Stopwatch -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Stopwatch}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Stopwatch &amp; Focus Timer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Floating high-precision stopwatch with lap counter and quick pomodoro focus tracking." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="T" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Toggle" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="stopwatch" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 6. Alt + C: Calendar -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14,12" Margin="0,0,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Calendar}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Calendar &amp; Deadlines" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="Floating sprint calendar view highlighting project deadlines, team releases, and meetings." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="ALT" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="6" Padding="9,4">
                                        <TextBlock Text="C" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Toggle" Command="{Binding ToggleFloatWindowCommand}" CommandParameter="calendar" Height="32" Padding="12,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ── SECTION 5: SYSTEM INFO & UPDATES ───────────────────────── -->
            <Border Style="{StaticResource Border.Card}" Padding="24">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="About OctalPulse Desktop" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock Text="Version " FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding VersionDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                            <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="4" Padding="8,5" Margin="10,0,0,0">
                                <TextBlock Text="X1.X2.X3.X4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version Meaning / Breakdown Card -->
                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionBreakdown}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Version Scheme: [X1] Backend Provider Update • [X2] Desktop Feature • [X3] UI/UX &amp; Theme • [X4] Bug / Error Fixes" 
                                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Built with WPF, C# 13, and .NET 10 following Onion Architecture, Clean MVVM, SignalR Real-Time Collaboration, SQLite Local Cache, and Windows DPAPI." 
                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
