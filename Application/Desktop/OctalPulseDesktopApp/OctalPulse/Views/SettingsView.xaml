                                            BorderBrush="#6010B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostStopwatch, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="📌 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Brush.Success}"
                                                    Text="Over All Windows: ON" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Padding="9,4"
                                            Background="#1564748B"
                                            BorderBrush="#3064748B"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostStopwatch, Converter={StaticResource InvertBoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="🪟 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="Over All Windows: OFF" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="4"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleFloatWindowCommand}"
                                    CommandParameter="stopwatch"
                                    Content="Toggle"
                                    Style="{StaticResource Button.Ghost}" />
                            </Grid>
                        </Border>

                        <!--  6. Alt + C: Calendar  -->
                        <Border
                            Margin="0,0,0,8"
                            Padding="14,12"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.PrimarySoft}"
                                    CornerRadius="8">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource Icon.Calendar}"
                                        Fill="{DynamicResource Brush.Primary}"
                                        Stretch="Uniform" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Calendar &amp; Deadlines" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="Floating sprint calendar view highlighting project deadlines, team releases, and meetings."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Padding="9,4"
                                        Background="{DynamicResource Brush.Card}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1.5"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="Consolas, Segoe UI"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="ALT" />
                                    </Border>
                                    <TextBlock
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="+" />
                                    <Border
                                        Padding="9,4"
                                        Background="{DynamicResource Brush.PrimarySoft}"
                                        BorderBrush="{DynamicResource Brush.Primary}"
                                        BorderThickness="1.5"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="Consolas, Segoe UI"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.Primary}"
                                            Text="C" />
                                    </Border>
                                </StackPanel>

                                <!--  Topmost Permission Toggle Button  -->
                                <Button
                                    Grid.Column="3"
                                    Height="30"
                                    Margin="14,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleFloatTopmostCommand}"
                                    CommandParameter="calendar"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="Click to toggle whether this floating window appears over all windows (Always On Top) or stays in the background">
                                    <Grid>
                                        <Border
                                            Padding="9,4"
                                            Background="#2010B981"
                                            BorderBrush="#6010B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostCalendar, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="📌 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Brush.Success}"
                                                    Text="Over All Windows: ON" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Padding="9,4"
                                            Background="#1564748B"
                                            BorderBrush="#3064748B"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostCalendar, Converter={StaticResource InvertBoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="🪟 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="Over All Windows: OFF" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="4"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleFloatWindowCommand}"
                                    CommandParameter="calendar"
                                    Content="Toggle"
                                    Style="{StaticResource Button.Ghost}" />
                            </Grid>
                        </Border>

                        <!--  7. Alt + O: Notes & Ideas  -->
                        <Border
                            Margin="0,0,0,0"
                            Padding="14,12"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.PrimarySoft}"
                                    CornerRadius="8">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="📝" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="Private Notes &amp; Ideas Drawer" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#1A10B981"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Foreground="#10B981"
                                                Text="Offline &amp; Safe" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="Floating drawer (dockable Left, Right, Top, or Bottom) for private ideas, task checklists, and research bookmarks with emergency backup."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Padding="9,4"
                                        Background="{DynamicResource Brush.Card}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1.5"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="Consolas, Segoe UI"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="ALT" />
                                    </Border>
                                    <TextBlock
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="+" />
                                    <Border
                                        Padding="9,4"
                                        Background="{DynamicResource Brush.PrimarySoft}"
                                        BorderBrush="{DynamicResource Brush.Primary}"
                                        BorderThickness="1.5"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="Consolas, Segoe UI"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.Primary}"
                                            Text="O" />
                                    </Border>
                                </StackPanel>

                                <!--  Topmost Permission Toggle Button  -->
                                <Button
                                    Grid.Column="3"
                                    Height="30"
                                    Margin="14,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleFloatTopmostCommand}"
                                    CommandParameter="notes"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="Click to toggle whether this floating window appears over all windows (Always On Top) or stays in the background">
                                    <Grid>
                                        <Border
                                            Padding="9,4"
                                            Background="#2010B981"
                                            BorderBrush="#6010B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostNotes, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="📌 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Brush.Success}"
                                                    Text="Over All Windows: ON" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Padding="9,4"
                                            Background="#1564748B"
                                            BorderBrush="#3064748B"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding FloatTopmostNotes, Converter={StaticResource InvertBoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Text="🪟 " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="Over All Windows: OFF" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="4"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleFloatWindowCommand}"
                                    CommandParameter="notes"
                                    Content="Toggle"
                                    Style="{StaticResource Button.Ghost}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!--  ── SECTION 5: SYSTEM INFO & UPDATES ─────────────────────────  -->
            <Border Padding="24" Style="{StaticResource Border.Card}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource Text.Heading3}"
                            Text="About OctalPulse Desktop" />
                        <StackPanel Margin="0,2,0,4" Orientation="Horizontal">
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Text="Version " />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.Primary}"
                                Text="{Binding VersionDisplay}" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="8,5"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="X1.X2.X3.X4" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Version Meaning / Breakdown Card  -->
                    <Border
                        Margin="0,0,0,14"
                        Padding="14"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="{Binding VersionBreakdown}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Version Scheme: [X1] Backend Provider Update • [X2] Desktop Feature • [X3] UI/UX &amp; Theme • [X4] Bug / Error Fixes" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        LineHeight="16"
                        Text="Built with WPF, C# 13, and .NET 10 following Onion Architecture, Clean MVVM, SignalR Real-Time Collaboration, SQLite Local Cache, and Windows DPAPI."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
