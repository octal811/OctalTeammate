<UserControl
    x:Class="OctalPulse.Views.TasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="850"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
    </UserControl.Resources>

    <Grid>
        <!--  Main Board Layout  -->
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  1. Header Row  -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Text.Heading1}"
                        Text="Tasks Board" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="Agile Kanban workflow across organization tracks. Add cards and transition their stages." />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="38"
                        Margin="0,0,10,0"
                        Padding="16,0"
                        Command="{Binding LoadAllTasksCommand}"
                        Content="Refresh Board"
                        Style="{StaticResource Button.Secondary}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        Data="{StaticResource Icon.Refresh}"
                                        Fill="{DynamicResource Brush.TextPrimary}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Refresh" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button
                        Height="38"
                        Padding="18,0"
                        Command="{Binding OpenCreateTaskModalCommand}"
                        Style="{StaticResource Button.Primary}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        Data="{StaticResource Icon.Plus}"
                                        Fill="#FFFFFF"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="Add Card" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  2. Controls & Search Toolbar  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,16"
                Padding="14,10"
                Style="{StaticResource Border.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Search Input  -->
                    <Grid Grid.Column="0" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="8,0,10,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource Icon.Search}"
                            Fill="{DynamicResource Brush.TextMuted}"
                            Stretch="Uniform" />
                        <TextBox
                            Grid.Column="1"
                            Height="36"
                            Style="{StaticResource TextBox.Modern}"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!--  Project Selector Filter  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Filter Project:" />
                        <ComboBox
                            Width="200"
                            Height="36"
                            ItemsSource="{Binding AvailableProjects}"
                            SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}"
                            Style="{StaticResource ComboBox.Modern}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  3. Loading Indicator  -->
            <ProgressBar
                Grid.Row="2"
                Margin="0,0,0,12"
                IsIndeterminate="True"
                Style="{StaticResource ProgressBar.Modern}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!--  4. Kanban Columns Grid  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ==================== COLUMN 1: TO DO ====================  -->
                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Column Header  -->
                        <Grid Grid.Row="0" Margin="4,4,4,12">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#94A3B8" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="To Do" />
                                <Border
                                    Padding="8,2"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="{Binding TodoTasks.Count}" />
                                </Border>
                            </StackPanel>

                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenCreateTaskModalCommand}"
                                CommandParameter="Todo"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Add Card to To Do">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource Icon.Plus}"
                                    Fill="{DynamicResource Brush.TextPrimary}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!--  Column Body  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,32,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="No cards in To Do"
                                    Visibility="{Binding TodoTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <ItemsControl ItemsSource="{Binding TodoTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="14"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="10"
                                                Style="{StaticResource Border.Card}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  Card Top Meta  -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Border
                                                                Margin="0,0,6,0"
                                                                Padding="6,2"
                                                                Background="{DynamicResource Brush.Surface}"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                                    Text="{Binding Priority}" />
                                                            </Border>
                                                            <TextBlock
                                                                MaxWidth="120"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="{Binding ProjectAndTrack}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.Icon}"
                                                            ToolTip="Delete Card">
                                                            <Path
                                                                Width="11"
                                                                Height="11"
                                                                Data="{StaticResource Icon.Trash}"
                                                                Fill="{DynamicResource Brush.Danger}"
                                                                Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  Title  -->
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,0,0,6"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />

                                                    <!--  Description  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        MaxHeight="36"
                                                        Margin="0,0,0,8"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                                    <!--  Progress Bar  -->
                                                    <Grid Grid.Row="3" Margin="0,10,10,10">
                                                        <Grid Margin="0,0,0,12">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="Checklist Progress" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource Brush.Primary}"
                                                                Text="{Binding Progress, StringFormat='{}{0}%'}" />
                                                        </Grid>
                                                        <ProgressBar
                                                            Height="4"
                                                            VerticalAlignment="Bottom"
                                                            Maximum="100"
                                                            Style="{StaticResource ProgressBar.Modern}"
                                                            Value="{Binding Progress}" />
                                                    </Grid>

                                                    <!--  Bottom Actions  -->
                                                    <Grid Grid.Row="4">
                                                        <Button
                                                            Height="28"
                                                            Padding="6,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Checklist →"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Ghost}" />

                                                        <Button
                                                            Height="28"
                                                            Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Start →"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Secondary}"
                                                            ToolTip="Advance to In Progress" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  ==================== COLUMN 2: IN PROGRESS ====================  -->
                <Border
                    Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Column Header  -->
                        <Grid Grid.Row="0" Margin="4,4,4,12">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#3B82F6" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="In Progress" />
                                <Border
                                    Padding="8,2"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.Primary}"
                                        Text="{Binding InProgressTasks.Count}" />
                                </Border>
                            </StackPanel>

                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenCreateTaskModalCommand}"
                                CommandParameter="InProgress"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Add Card to In Progress">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource Icon.Plus}"
                                    Fill="{DynamicResource Brush.TextPrimary}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!--  Column Body  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,32,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="No cards in Progress"
                                    Visibility="{Binding InProgressTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <ItemsControl ItemsSource="{Binding InProgressTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="14"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="10"
                                                Style="{StaticResource Border.Card}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  Card Top Meta  -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Border
                                                                Margin="0,0,6,0"
                                                                Padding="6,2"
                                                                Background="{DynamicResource Brush.Surface}"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                                    Text="{Binding Priority}" />
                                                            </Border>
                                                            <TextBlock
                                                                MaxWidth="120"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="{Binding ProjectAndTrack}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.Icon}"
                                                            ToolTip="Delete Card">
                                                            <Path
                                                                Width="11"
                                                                Height="11"
                                                                Data="{StaticResource Icon.Trash}"
                                                                Fill="{DynamicResource Brush.Danger}"
                                                                Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  Title  -->
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,0,0,6"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />

                                                    <!--  Description  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        MaxHeight="36"
                                                        Margin="0,0,0,8"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                                    <!--  Progress Bar  -->
                                                    <Grid Grid.Row="3" Margin="0,10,10,10">
                                                        <Grid Margin="0,0,0,12">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="Checklist Progress" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource Brush.Primary}"
                                                                Text="{Binding Progress, StringFormat='{}{0}%'}" />
                                                        </Grid>
                                                        <ProgressBar
                                                            Height="4"
                                                            VerticalAlignment="Bottom"
                                                            Maximum="100"
                                                            Style="{StaticResource ProgressBar.Modern}"
                                                            Value="{Binding Progress}" />
                                                    </Grid>

                                                    <!--  Bottom Actions  -->
                                                    <Grid Grid.Row="4">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <Button
                                                                Height="28"
                                                                Margin="0,0,4,0"
                                                                Padding="6,0"
                                                                Command="{Binding DataContext.MoveToTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="← To Do"
                                                                FontSize="11"
                                                                Style="{StaticResource Button.Ghost}"
                                                                ToolTip="Move back to To Do" />

                                                            <Button
                                                                Height="28"
                                                                Padding="6,0"
                                                                Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Checklist →"
                                                                FontSize="11"
                                                                Style="{StaticResource Button.Ghost}" />
                                                        </StackPanel>

                                                        <Button
                                                            Height="28"
                                                            Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.MoveToReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Review →"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Secondary}"
                                                            ToolTip="Advance to Review" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  ==================== COLUMN 3: REVIEW ====================  -->
                <Border
                    Grid.Column="4"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Column Header  -->
                        <Grid Grid.Row="0" Margin="4,4,4,12">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#A855F7" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Review" />
                                <Border
                                    Padding="8,2"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#A855F7"
                                        Text="{Binding ReviewTasks.Count}" />
                                </Border>
                            </StackPanel>

                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenCreateTaskModalCommand}"
                                CommandParameter="Review"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Add Card to Review">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource Icon.Plus}"
                                    Fill="{DynamicResource Brush.TextPrimary}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!--  Column Body  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,32,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="No cards in Review"
                                    Visibility="{Binding ReviewTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <ItemsControl ItemsSource="{Binding ReviewTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="14"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="10"
                                                Style="{StaticResource Border.Card}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  Card Top Meta  -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Border
                                                                Margin="0,0,6,0"
                                                                Padding="6,2"
                                                                Background="{DynamicResource Brush.Surface}"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                                    Text="{Binding Priority}" />
                                                            </Border>
                                                            <TextBlock
                                                                MaxWidth="120"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="{Binding ProjectAndTrack}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.Icon}"
                                                            ToolTip="Delete Card">
                                                            <Path
                                                                Width="11"
                                                                Height="11"
                                                                Data="{StaticResource Icon.Trash}"
                                                                Fill="{DynamicResource Brush.Danger}"
                                                                Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  Title  -->
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,0,0,6"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />

                                                    <!--  Description  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        MaxHeight="36"
                                                        Margin="0,0,0,8"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                                    <!--  Progress Bar  -->
                                                    <Grid Grid.Row="3" Margin="0,10,10,10">
                                                        <Grid Margin="0,0,0,12">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="Checklist Progress" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource Brush.Primary}"
                                                                Text="{Binding Progress, StringFormat='{}{0}%'}" />
                                                        </Grid>
                                                        <ProgressBar
                                                            Height="4"
                                                            VerticalAlignment="Bottom"
                                                            Maximum="100"
                                                            Style="{StaticResource ProgressBar.Modern}"
                                                            Value="{Binding Progress}" />
                                                    </Grid>

                                                    <!--  Bottom Actions  -->
                                                    <Grid Grid.Row="4">
                                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <Button
                                                                Height="28"
                                                                Margin="0,0,4,0"
                                                                Padding="6,0"
                                                                Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="← Reopen"
                                                                FontSize="11"
                                                                Style="{StaticResource Button.Ghost}"
                                                                ToolTip="Return to In Progress" />

                                                            <Button
                                                                Height="28"
                                                                Padding="6,0"
                                                                Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Checklist →"
                                                                FontSize="11"
                                                                Style="{StaticResource Button.Ghost}" />
                                                        </StackPanel>

                                                        <Button
                                                            Height="28"
                                                            Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.MoveToDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Complete ✓"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Primary}"
                                                            ToolTip="Mark as Completed" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  ==================== COLUMN 4: COMPLETED ====================  -->
                <Border
                    Grid.Column="6"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Column Header  -->
                        <Grid Grid.Row="0" Margin="4,4,4,12">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#22C55E" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Completed" />
                                <Border
                                    Padding="8,2"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.Success}"
                                        Text="{Binding DoneTasks.Count}" />
                                </Border>
                            </StackPanel>

                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenCreateTaskModalCommand}"
                                CommandParameter="Done"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Add Card to Completed">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource Icon.Plus}"
                                    Fill="{DynamicResource Brush.TextPrimary}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!--  Column Body  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,12,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,32,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="No completed cards"
                                    Visibility="{Binding DoneTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <ItemsControl ItemsSource="{Binding DoneTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="14"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="10"
                                                Opacity="0.92"
                                                Style="{StaticResource Border.Card}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  Card Top Meta  -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Border
                                                                Margin="0,0,6,0"
                                                                Padding="6,2"
                                                                Background="{DynamicResource Brush.Surface}"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                                    Text="{Binding Priority}" />
                                                            </Border>
                                                            <TextBlock
                                                                MaxWidth="120"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="{Binding ProjectAndTrack}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.Icon}"
                                                            ToolTip="Delete Card">
                                                            <Path
                                                                Width="11"
                                                                Height="11"
                                                                Data="{StaticResource Icon.Trash}"
                                                                Fill="{DynamicResource Brush.Danger}"
                                                                Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  Title  -->
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,0,0,6"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Title}"
                                                        TextDecorations="None"
                                                        TextWrapping="Wrap" />

                                                    <!--  Description  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        MaxHeight="36"
                                                        Margin="0,0,0,8"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                                    <!--  Progress Bar  -->
                                                    <Grid Grid.Row="3" Margin="0,10,10,10">
                                                        <Grid Margin="0,0,0,12">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                                Text="Checklist Progress" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource Brush.Success}"
                                                                Text="{Binding Progress, StringFormat='{}{0}%'}" />
                                                        </Grid>
                                                        <ProgressBar
                                                            Height="4"
                                                            VerticalAlignment="Bottom"
                                                            Foreground="{DynamicResource Brush.Success}"
                                                            Maximum="100"
                                                            Style="{StaticResource ProgressBar.Modern}"
                                                            Value="{Binding Progress}" />
                                                    </Grid>

                                                    <!--  Bottom Actions  -->
                                                    <Grid Grid.Row="4">
                                                        <Button
                                                            Height="28"
                                                            Padding="6,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Checklist →"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Ghost}" />

                                                        <Button
                                                            Height="28"
                                                            Padding="8,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="← Reopen"
                                                            FontSize="11"
                                                            Style="{StaticResource Button.Ghost}"
                                                            ToolTip="Move back to In Progress" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ==================== MODAL: ADD NEW CARD ====================  -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateTaskModalOpen, Converter={StaticResource BoolToVis}}">
            <Border
                Width="540"
                MaxHeight="680"
                Margin="20"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Border.Card}">
<ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,8,0"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Modal Header  -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource Text.Heading2}" Text="Add New Card" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding CloseCreateTaskModalCommand}"
                                Style="{StaticResource Button.Icon}">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource Icon.Close}"
                                    Fill="{DynamicResource Brush.TextMuted}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!--  Project & Track Selector  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Target Project &amp; Track *" />
                        <ComboBox
                            Margin="0,0,0,16"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding AvailableTracks}"
                            SelectedItem="{Binding SelectedTrackOption}"
                            Style="{StaticResource ComboBox.Modern}" />

                        <!--  Column / State  -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Board Column / State" />
                                <ComboBox
                                    ItemsSource="{Binding AvailableStates}"
                                    SelectedItem="{Binding NewTaskState}"
                                    Style="{StaticResource ComboBox.Modern}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Priority" />
                                <ComboBox
                                    ItemsSource="{Binding AvailablePriorities}"
                                    SelectedItem="{Binding NewTaskPriority}"
                                    Style="{StaticResource ComboBox.Modern}" />
                            </StackPanel>
                        </Grid>

                        <!--  Card Title  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Card Title *" />
                        <TextBox
                            Margin="0,0,0,16"
                            Style="{StaticResource TextBox.Modern}"
                            Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Due Date  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Due Date" />
                        <DatePicker
                            Height="40"
                            Margin="0,0,0,16"
                            SelectedDate="{Binding NewTaskDueDate}" />

                        <!--  External Work Link  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="External Link (GitHub Issue / Jira / Docs)" />
                        <TextBox
                            Margin="0,0,0,16"
                            Style="{StaticResource TextBox.Modern}"
                            Text="{Binding NewTaskLink, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Description  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Description (Optional)" />
                        <TextBox
                            Height="100"
                            Margin="0,0,0,24"
                            Style="{StaticResource TextBox.Multiline}"
                            Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Modal Actions  -->
                        <Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Command="{Binding CloseCreateTaskModalCommand}"
                                Content="Cancel"
                                Style="{StaticResource Button.Ghost}" />
                            <Button
                                Padding="22,0"
                                HorizontalAlignment="Right"
                                Command="{Binding SubmitCreateTaskCommand}"
                                Content="Create Card"
                                Style="{StaticResource Button.Primary}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
