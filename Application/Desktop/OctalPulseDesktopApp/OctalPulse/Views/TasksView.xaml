<UserControl x:Class="OctalPulse.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Tasks Center" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
                    <TextBlock Text="Unified view of your major deliverables across all organization projects." Style="{StaticResource Text.Subtitle}" />
                </StackPanel>

                <Button Style="{StaticResource Button.Secondary}" Content="Refresh Tasks" Command="{Binding LoadAllTasksCommand}" HorizontalAlignment="Right" Height="36" Padding="14,0" />
            </Grid>

            <!-- Filters Bar -->
            <Border Style="{StaticResource Border.Card}" Padding="14" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filter State:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ComboBox SelectedValue="{Binding FilterStatus}" Style="{StaticResource ComboBox.Modern}" Width="160" Height="36">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Todo" />
                        <ComboBoxItem Content="InProgress" />
                        <ComboBoxItem Content="Done" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Loading Progress -->
            <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

            <!-- Empty State -->
            <Border Style="{StaticResource Border.Card}" Padding="40" Visibility="{Binding DisplayedTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.TextMuted}" Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,16" />
                    <TextBlock Text="No tasks found matching your filter." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Tasks assigned or created across your project tracks will appear here." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Tasks List -->
            <ItemsControl ItemsSource="{Binding DisplayedTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Border.Card}" Margin="0,0,0,14" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Task Info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,12,0" />
                                        <Border CornerRadius="8" Padding="6,2" Margin="0,0,6,0" Background="{DynamicResource Brush.SurfaceElevated}">
                                            <TextBlock Text="{Binding Priority}" FontSize="10" FontWeight="Bold" Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                                        </Border>
                                        <Border CornerRadius="8" Padding="6,2" Background="{DynamicResource Brush.SurfaceElevated}">
                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource StatusToBrush}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description, FallbackValue='No details provided.'}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Progress Bar -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Sub-tasks Progress" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                        <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                                </StackPanel>

                                <!-- Open Button -->
                                <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Checklist →" 
                                        Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Height="34" Padding="14,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
