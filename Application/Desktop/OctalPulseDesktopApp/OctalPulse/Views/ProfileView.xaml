<UserControl
    x:Class="OctalPulse.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InvertNullToVis" Invert="True" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
        <converters:RelativeUrlToImageSourceConverter x:Key="RelativeUrlToImage" />
    </UserControl.Resources>

    <ScrollViewer
        Padding="24,16,24,36"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1140" HorizontalAlignment="Center">

            <!-- Top Header & Loading Indicator -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Member Profile" Style="{StaticResource Text.Heading2}" Margin="0,0,0,2" />
                    <TextBlock Text="Manage your public identity, engineering bio, and team highlights." Style="{StaticResource Text.Subtitle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource Button.Secondary}"
                    Height="36"
                    Padding="14,0"
                    Command="{Binding RefreshProfileCommand}"
                    ToolTip="Refresh Profile">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Brush.TextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar
                IsIndeterminate="True"
                Style="{StaticResource ProgressBar.Modern}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,16" />

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ── HERO PROFILE CARD (Facebook & LinkedIn Style) ──────────────── -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Border
                Style="{StaticResource Border.Card}"
                CornerRadius="16"
                Padding="0"
                Margin="0,0,0,24"
                ClipToBounds="True">
                <StackPanel>
                    <!-- ── COVER PHOTO BANNER ─────────────────────────────────── -->
                    <Grid Height="260">
                        <!-- Fallback Artistic Background if no image is uploaded -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}">
                            <Grid>
                                <!-- Modern Geometric Gradients -->
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E1B4B" Offset="0" />
                                            <GradientStop Color="#312E81" Offset="0.5" />
                                            <GradientStop Color="#0F172A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Ambient Glowing Shapes -->
                                <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-60,0" Opacity="0.35">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{DynamicResource Color.Primary}" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-80" Opacity="0.25">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#38BDF8" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Tech Grid Accent Watermark -->
                                <Path
                                    Data="{StaticResource Icon.Logo}"
                                    Fill="#FFFFFF"
                                    Opacity="0.04"
                                    Width="180"
                                    Height="180"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,100,0" />
                            </Grid>
                        </Border>

                        <!-- Actual Cover Image (When present) -->
                        <Border Visibility="{Binding BackgroundImageUrl, Converter={StaticResource NullToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding BackgroundImageUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Bottom Vignette / Overlay for legibility -->
                        <Border VerticalAlignment="Bottom" Height="90">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#90000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- ── OVERLAID COVER UPLOAD BUTTON (LinkedIn / Facebook Top-Right or Bottom-Right) ── -->
                        <Button
                            Command="{Binding UploadBackgroundImageCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,20"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="CoverBtnBorder"
                                        Background="#CC0F172A"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="16,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Camera Icon -->
                                            <Path
                                                x:Name="CoverCameraIcon"
                                                Data="{StaticResource Icon.Camera}"
                                                Fill="#FFFFFF"
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />

                                            <!-- Button Label with Uploading State -->
                                            <TextBlock
                                                x:Name="CoverBtnText"
                                                Text="Update Cover"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CoverBtnBorder" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter TargetName="CoverBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsUploadingBackground}" Value="True">
                                            <Setter TargetName="CoverBtnText" Property="Text" Value="Uploading..." />
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter TargetName="CoverBtnBorder" Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ── IDENTITY HEADER (With Overlapping Avatar) ───────────── -->
                    <Grid Margin="32,0,32,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ── OVERLAPPING CIRCULAR AVATAR ────────────────────── -->
                        <Grid
                            Grid.Column="0"
                            Width="132"
                            Height="132"
                            Margin="0,-64,24,0"
                            VerticalAlignment="Top">

                            <!-- Drop shadow / outer cutout ring using Card background -->
                            <Ellipse
                                Fill="{DynamicResource Brush.Primary}"
                                Stroke="{DynamicResource Brush.CardBackground}"
                                StrokeThickness="5" />

                            <!-- Fallback Initial -->
                            <TextBlock
                                Text="{Binding ProfileName, Converter={StaticResource StringToInitial}}"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <!-- Uploaded Profile Picture Layer -->
                            <Ellipse
                                Stroke="{DynamicResource Brush.CardBackground}"
                                StrokeThickness="5"
                                Visibility="{Binding ProfileImageUrl, Converter={StaticResource NullToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImageUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Avatar Upload Camera Badge Button (Bottom Right of Avatar) -->
                            <Button
                                Command="{Binding UploadProfileImageCommand}"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,0"
                                ToolTip="Update profile photo"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse
                                                x:Name="AvatarBtnBg"
                                                Fill="{DynamicResource Brush.SurfaceElevated}"
                                                Stroke="{DynamicResource Brush.CardBackground}"
                                                StrokeThickness="3" />
                                            <Path
                                                x:Name="AvatarCameraIcon"
                                                Data="{StaticResource Icon.Camera}"
                                                Fill="{DynamicResource Brush.TextPrimary}"
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AvatarBtnBg" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                <Setter TargetName="AvatarCameraIcon" Property="Fill" Value="#FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsUploadingProfile}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter TargetName="AvatarBtnBg" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ── USER IDENTITY DETAILS ──────────────────────────── -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,12,0,0">
                            <!-- Name and Online/Active Chip -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding ProfileName, FallbackValue='Team Member'}"
                                    Style="{StaticResource Text.Heading1}"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                <!-- Active Status Indicator -->
                                <Border
                                    Background="#16A34A"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Role & Rank Badges Row -->
                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <!-- Role Badge -->
                                <Border
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,4"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Briefcase}" Fill="{DynamicResource Brush.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ProfileRole, FallbackValue='Software Engineer'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Rank Badge -->
                                <Border
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,4"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Shield}" Fill="{DynamicResource Brush.Warning}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ProfileRank, FallbackValue='Member'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Email -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="· " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProfileEmail, FallbackValue='member@octalpulse.io'}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- Short Bio excerpt in identity header (if available) -->
                            <TextBlock
                                Text="{Binding Bio}"
                                Style="{StaticResource Text.Subtitle}"
                                FontSize="13"
                                MaxHeight="38"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,8,0,0"
                                Visibility="{Binding Bio, Converter={StaticResource NullToVis}}" />
                        </StackPanel>

                        <!-- ── TOP ACTIONS ────────────────────────────────────── -->
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0">

                            <Button
                                Style="{StaticResource Button.Primary}"
                                Height="40"
                                Padding="20,0"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Commit and save all profile details">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Save Changes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ── MAIN 2-COLUMN PROFESSIONAL GRID (LinkedIn Desktop Style) ──── -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- ═════════════════════════════════════════════════════════════ -->
                <!-- ── LEFT COLUMN: About, Badges, Posts & Notes ──────────────── -->
                <!-- ═════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <!-- ── ABOUT & BIO CARD ──────────────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.User}" Fill="{DynamicResource Brush.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="About" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Bio Display Text -->
                            <TextBlock
                                Text="{Binding Bio, FallbackValue='No bio written yet. Add a short introduction in the Edit Profile panel to tell teammates about your technical focus and expertise.'}"
                                Style="{StaticResource Text.Body}"
                                FontSize="13.5"
                                LineHeight="20"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Margin="0,0,0,16" />

                            <!-- Expertise / Focus Pills -->
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,5" Margin="0,0,8,6">
                                    <TextBlock Text="Team Collaboration" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,5" Margin="0,0,8,6">
                                    <TextBlock Text="Sprint Delivery" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,5" Margin="0,0,8,6">
                                    <TextBlock Text="Architecture" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,5" Margin="0,0,8,6">
                                    <TextBlock Text="Code Quality" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── ACHIEVEMENTS & BADGES ────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Section Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Trophy}" Fill="#F59E0B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Achievements &amp; Badges" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Earn tokens, level up in sprints, and highlight core milestones." Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Badge Cards Grid -->
                            <ItemsControl ItemsSource="{Binding Badges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{Binding AccentBrush}"
                                            BorderBrush="{Binding AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,10,12"
                                            ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Gloss Overlay (Gold+) -->
                                                <Border
                                                    Grid.ColumnSpan="2"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    IsHitTestVisible="False"
                                                    Opacity="0.25"
                                                    Visibility="{Binding HasShine, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                                            <GradientStop Color="#AAFFFFFF" Offset="0.45" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Legend shimmer overlay -->
                                                <Border
                                                    Grid.ColumnSpan="2"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    IsHitTestVisible="False"
                                                    Opacity="0.4"
                                                    Visibility="{Binding IsLegend, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                                            <GradientStop Color="#33FFFFFF" Offset="0.0" />
                                                            <GradientStop Color="#88FFFFFF" Offset="0.3" />
                                                            <GradientStop Color="#33FFFFFF" Offset="0.6" />
                                                            <GradientStop Color="#88FFFFFF" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Icon Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="46"
                                                    Height="46"
                                                    CornerRadius="10"
                                                    Background="#33FFFFFF"
                                                    Margin="0,0,14,0"
                                                    VerticalAlignment="Top">
                                                    <Path
                                                        Data="{StaticResource Icon.Trophy}"
                                                        Fill="#FFFFFFFF"
                                                        Width="20"
                                                        Height="20"
                                                        Stretch="Uniform"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Content -->
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFFFF" />
                                                        <Border
                                                            HorizontalAlignment="Right"
                                                            Background="#44FFFFFF"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock
                                                        Text="{Binding Description}"
                                                        FontSize="11.5"
                                                        Foreground="#CCFFFFFF"
                                                        TextWrapping="Wrap"
                                                        Margin="0,4,0,8" />

                                                    <!-- Progress Bar -->
                                                    <ProgressBar
                                                        Value="{Binding ProgressPercent}"
                                                        Maximum="100"
                                                        Height="5"
                                                        Foreground="#FFFFFFFF"
                                                        Background="#33FFFFFF"
                                                        Style="{StaticResource ProgressBar.Modern}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── POSTS & NOTES FEED ───────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24">
                        <StackPanel>
                            <!-- Section Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.MessageSquare}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Activity &amp; Engineering Notes" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Share retrospectives, architecture decisions, and code snippets with your team." Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Feed Items -->
                            <ItemsControl ItemsSource="{Binding Posts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18"
                                            Margin="0,0,0,14">
                                            <StackPanel>
                                                <!-- Post Header -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                            <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="1"
                                                        Style="{StaticResource Button.Icon}"
                                                        Width="28"
                                                        Height="28"
                                                        ToolTip="Post Options">
                                                        <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>

                                                <!-- Post Content -->
                                                <TextBlock
                                                    Text="{Binding Content}"
                                                    FontSize="13"
                                                    LineHeight="19"
                                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,10" />

                                                <!-- Post Image -->
                                                <Border
                                                    CornerRadius="10"
                                                    Margin="0,0,0,10"
                                                    ClipToBounds="True"
                                                    Visibility="{Binding PhotoUrl, Converter={StaticResource NullToVis}}">
                                                    <Image
                                                        Source="{Binding PhotoUrl, Converter={StaticResource RelativeUrlToImage}}"
                                                        Stretch="UniformToFill"
                                                        MaxHeight="240" />
                                                </Border>

                                                <!-- Tags -->
                                                <TextBlock
                                                    Text="{Binding Tags}"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource Brush.Primary}"
                                                    FontWeight="SemiBold"
                                                    Margin="0,0,0,12"
                                                    Visibility="{Binding Tags, Converter={StaticResource NullToVis}}" />

                                                <!-- Social Reactions Bar -->
                                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Likes -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource Icon.Heart}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding LikesCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                                                <TextBlock Text=" Likes" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Comments -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource Icon.MessageSquare}" Fill="{DynamicResource Brush.TextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CommentsCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                                                <TextBlock Text=" Comments" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Button
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Height="28"
                                                            Padding="8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Share}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Share" FontSize="11.5" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════════════════════════════════════════════════════════════ -->
                <!-- ── RIGHT COLUMN: Edit Profile & Account Information ───────── -->
                <!-- ═════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="1">

                    <!-- ── EDIT PROFILE CARD ─────────────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="22" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Edit Profile" Style="{StaticResource Text.Heading3}" />
                                <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Brush.Primary}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Update your identity and technical description." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />

                            <!-- Full Name -->
                            <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                            <TextBox
                                Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Modern}"
                                Margin="0,0,0,14" />

                            <!-- Main Engineering Role -->
                            <TextBlock Text="Engineering Role *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                            <ComboBox
                                ItemsSource="{Binding AvailableRoles}"
                                SelectedItem="{Binding ProfileRole}"
                                Style="{StaticResource ComboBox.Modern}"
                                Margin="0,0,0,14" />

                            <!-- Bio -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Short Bio" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="Max 500 chars" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox
                                Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Multiline}"
                                MaxLength="500"
                                MinHeight="110"
                                Margin="0,0,0,16"
                                Tag="Describe your focus, stack, and current team projects..." />

                            <!-- Save Button -->
                            <Button
                                Style="{StaticResource Button.Primary}"
                                Content="Save Changes"
                                Command="{Binding SaveProfileCommand}"
                                Height="42"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <!-- ── ACCOUNT OVERVIEW & DETAILS ────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="22" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Account &amp; Workspace" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                            <TextBlock Text="Your team workspace credentials and permissions." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />

                            <!-- Workspace Row -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Organization" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="OctalPulse Workspace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Rank Row -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Permission Level" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ProfileRank}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Email Row -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Account Email" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ProfileEmail}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Supported Media Uploads" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                                    <TextBlock Text="PNG, JPEG, WebP or GIF up to 5 MB. Photos are synchronized across team workstations." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>