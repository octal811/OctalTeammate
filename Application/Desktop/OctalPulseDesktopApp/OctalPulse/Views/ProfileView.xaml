<UserControl
    x:Class="OctalPulse.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InvertNullToVis" Invert="True" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
        <converters:RelativeUrlToImageSourceConverter x:Key="RelativeUrlToImage" />
    </UserControl.Resources>

    <ScrollViewer
        Padding="24,16,24,36"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1140" HorizontalAlignment="Center">

            <!-- Top Header & Loading Indicator -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Member Profile" Style="{StaticResource Text.Heading2}" Margin="0,0,0,2" />
                    <TextBlock Text="Manage your public identity, engineering bio, and team highlights." Style="{StaticResource Text.Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        x:Name="MemberSearchBox"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path
                                Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Icon.Search}"
                                Fill="{DynamicResource Brush.TextMuted}"
                                Stretch="Uniform" />
                            <TextBox
                                Grid.Column="1"
                                Width="210"
                                Height="36"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource TextBox.Modern}"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Search any registered member by name or email" />
                            <ProgressBar
                                Grid.Column="2"
                                Width="14"
                                Height="14"
                                Margin="6,0,10,0"
                                IsIndeterminate="True"
                                Maximum="100"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSearchingUsers, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <Button
                        Style="{StaticResource Button.Secondary}"
                        Height="36"
                        Padding="14,0"
                        Command="{Binding RefreshProfileCommand}"
                        ToolTip="Refresh Profile">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Brush.TextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── READ-ONLY VIEWING BANNER (another member's profile) ────────── -->
            <Border
                Visibility="{Binding IsOwnProfile, Converter={StaticResource InvertBoolToVis}}"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Primary}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Viewing member's profile" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Read-only — you cannot edit this member's profile." FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button
                        Command="{Binding BackToMyProfileCommand}"
                        Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="32"
                        Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.ChevronLeft}" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Back to my profile" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── SEARCH RESULTS DROPDOWN (in-flow card, fully visible) ── -->
            <Border
                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,0,0,12">
                <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Padding>
                        <Thickness>6</Thickness>
                    </ScrollViewer.Padding>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource Button.Ghost}"
                                    Height="Auto"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,8"
                                    Margin="0,2"
                                    Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.Primary}" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource StringToInitial}}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,1,0,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MainRole}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ProgressBar
                IsIndeterminate="True"
                Style="{StaticResource ProgressBar.Modern}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,16" />

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ── HERO PROFILE CARD (Facebook & LinkedIn Style) ──────────────── -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Border
                Style="{StaticResource Border.Card}"
                CornerRadius="0"
                Padding="0"
                Margin="0,0,0,24"
                ClipToBounds="True">
                <StackPanel>
                    <!-- ── COVER PHOTO BANNER ─────────────────────────────────── -->
                    <Grid Height="260">
                        <!-- Fallback Artistic Background if no image is uploaded -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}">
                            <Grid>
                                <!-- Modern Geometric Gradients -->
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E1B4B" Offset="0" />
                                            <GradientStop Color="#312E81" Offset="0.5" />
                                            <GradientStop Color="#0F172A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Ambient Glowing Shapes -->
                                <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-60,0" Opacity="0.35">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{DynamicResource Color.Primary}" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-80" Opacity="0.25">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#38BDF8" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Tech Grid Accent Watermark -->
                                <Path
                                    Data="{StaticResource Icon.Logo}"
                                    Fill="#FFFFFF"
                                    Opacity="0.04"
                                    Width="180"
                                    Height="180"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,100,0" />
                            </Grid>
                        </Border>

                        <!-- Actual Cover Image (When present) -->
                        <Border Visibility="{Binding BackgroundImageUrl, Converter={StaticResource NullToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding BackgroundImageUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Bottom Vignette / Overlay for legibility -->
                        <Border VerticalAlignment="Bottom" Height="90">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#90000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- ── OVERLAID COVER UPLOAD BUTTON (LinkedIn / Facebook Top-Right or Bottom-Right) ── -->
                        <Button
                            Command="{Binding UploadBackgroundImageCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,20"
                            Cursor="Hand"
                            Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="CoverBtnBorder"
                                        Background="#CC0F172A"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="16,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Camera Icon -->
                                            <Path
                                                x:Name="CoverCameraIcon"
                                                Data="{StaticResource Icon.Camera}"
                                                Fill="#FFFFFF"
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />

                                            <!-- Button Label with Uploading State -->
                                            <TextBlock
                                                x:Name="CoverBtnText"
                                                Text="Update Cover"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CoverBtnBorder" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter TargetName="CoverBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsUploadingBackground}" Value="True">
                                            <Setter TargetName="CoverBtnText" Property="Text" Value="Uploading..." />
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter TargetName="CoverBtnBorder" Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ── IDENTITY HEADER (With Overlapping Avatar) ───────────── -->
                    <Grid Margin="32,0,32,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ── OVERLAPPING CIRCULAR AVATAR ────────────────────── -->
                        <Grid
                            Grid.Column="0"
                            Width="132"
                            Height="132"
                            Margin="0,-64,24,0"
                            VerticalAlignment="Top">

                            <!-- Drop shadow / outer cutout ring using Card background -->
                            <Ellipse
                                Fill="{DynamicResource Brush.Primary}"
                                Stroke="{DynamicResource Brush.CardBackground}"
                                StrokeThickness="5" />

                            <!-- Fallback Initial -->
                            <TextBlock
                                Text="{Binding ProfileName, Converter={StaticResource StringToInitial}}"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <!-- Uploaded Profile Picture Layer -->
                            <Ellipse
                                Stroke="{DynamicResource Brush.CardBackground}"
                                StrokeThickness="5"
                                Visibility="{Binding ProfileImageUrl, Converter={StaticResource NullToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImageUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Avatar Upload Camera Badge Button (Bottom Right of Avatar) -->
                            <Button
                                Command="{Binding UploadProfileImageCommand}"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,0"
                                ToolTip="Update profile photo"
                                Cursor="Hand"
                                Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse
                                                x:Name="AvatarBtnBg"
                                                Fill="{DynamicResource Brush.SurfaceElevated}"
                                                Stroke="{DynamicResource Brush.CardBackground}"
                                                StrokeThickness="3" />
                                            <Path
                                                x:Name="AvatarCameraIcon"
                                                Data="{StaticResource Icon.Camera}"
                                                Fill="{DynamicResource Brush.TextPrimary}"
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AvatarBtnBg" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                                <Setter TargetName="AvatarCameraIcon" Property="Fill" Value="#FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsUploadingProfile}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter TargetName="AvatarBtnBg" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ── USER IDENTITY DETAILS ──────────────────────────── -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,12,0,0">
                            <!-- Name and Online/Active Chip -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding ProfileName, FallbackValue='Team Member'}"
                                    Style="{StaticResource Text.Heading1}"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                <!-- Active Status Indicator -->
                                <Border
                                    Background="#16A34A"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Role & Rank Badges Row -->
                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <!-- Role Badge -->
                                <Border
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,4"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Briefcase}" Fill="{DynamicResource Brush.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ProfileRole, FallbackValue='Software Engineer'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Rank Badge -->
                                <Border
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,4"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Shield}" Fill="{DynamicResource Brush.Warning}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ProfileRank, FallbackValue='Member'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Email -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="· " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProfileEmail, FallbackValue='member@octalpulse.io'}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- Short Bio excerpt in identity header (if available) -->
                            <TextBlock
                                Text="{Binding Bio}"
                                Style="{StaticResource Text.Subtitle}"
                                FontSize="13"
                                MaxHeight="38"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,8,0,0"
                                Visibility="{Binding Bio, Converter={StaticResource NullToVis}}" />
                        </StackPanel>

                        <!-- ── TOP ACTIONS ────────────────────────────────────── -->
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0">

                            <Button
                                Style="{StaticResource Button.Primary}"
                                Height="40"
                                Padding="20,0"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Commit and save all profile details"
                                Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Save Changes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ── MAIN 2-COLUMN PROFESSIONAL GRID (LinkedIn Desktop Style) ──── -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- ═════════════════════════════════════════════════════════════ -->
                <!-- ── LEFT COLUMN: About, Badges, Posts & Notes ──────────────── -->
                <!-- ═════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <!-- ── ABOUT & BIO CARD ──────────────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.User}" Fill="{DynamicResource Brush.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="About" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Bio Display Text -->
                            <TextBlock
                                Text="{Binding Bio, FallbackValue='No bio written yet. Add a short introduction in the Edit Profile panel to tell teammates about your technical focus and expertise.'}"
                                Style="{StaticResource Text.Body}"
                                FontSize="13.5"
                                LineHeight="20"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Margin="0" />
                        </StackPanel>
                    </Border>

                    <!-- ── ACHIEVEMENTS & BADGES ────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Section Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Trophy}" Fill="#F59E0B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Achievements &amp; Badges" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="Calculated from your tracked work — focus time, solved bugs, and major-task contribution."
                                        Style="{StaticResource Text.Subtitle}"
                                        TextWrapping="Wrap"
                                        Margin="0,4,0,0" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,6"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding Badges.Count, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Text="{Binding UnlockedBadgeSummary}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                            </Grid>

                            <!-- Load error -->
                            <Border
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,8"
                                Visibility="{Binding BadgesLoadFailed, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Celebrate}" Fill="{DynamicResource Brush.Warning}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="Could not load badges from the server. Refresh your profile to try again."
                                        FontSize="12.5"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Empty (no rows yet / not loaded) -->
                            <Border
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="22">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Badges.Count}" Value="0" />
                                                    <Condition Binding="{Binding BadgesLoadFailed}" Value="False" />
                                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Trophy}" Fill="{DynamicResource Brush.TextMuted}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="No badge progress yet" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Track task time, solve bugs, and finish major tasks to start unlocking levels."
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Margin="0,4,0,0"
                                        MaxWidth="360" />
                                </StackPanel>
                            </Border>

                            <!-- Badge Cards Grid -->
                            <ItemsControl ItemsSource="{Binding DisplayBadges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="0"
                                            Margin="0,0,12,12"
                                            ClipToBounds="True"
                                            MinHeight="148">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.72" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Level accent strip -->
                                                <Border Grid.RowSpan="3" Height="138" Width="5" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="{Binding AccentBrush}" />

                                                <!-- Shine for higher tiers -->
                                                <Border
                                                    Grid.RowSpan="3"
                                                    IsHitTestVisible="False"
                                                    Opacity="0.12"
                                                    Margin="4,0,0,0"
                                                    Visibility="{Binding HasShine, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#AAFFFFFF" Offset="0.5" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Header: icon + title + level -->
                                                <Grid Grid.Row="0" Margin="18,16,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Grid.Column="0"
                                                        Width="44"
                                                        Height="44"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Top">
                                                        <Border CornerRadius="12" Background="{Binding AccentBrush}" Opacity="0.22" />
                                                        <Path
                                                            Data="{Binding IconGeometry}"
                                                            Fill="{Binding AccentBrush}"
                                                            Width="20"
                                                            Height="20"
                                                            Stretch="Uniform"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                                        <Path
                                                            Data="{StaticResource Icon.Lock}"
                                                            Fill="{DynamicResource Brush.TextMuted}"
                                                            Width="18"
                                                            Height="18"
                                                            Stretch="Uniform"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource InvertBoolToVis}}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock
                                                                Text="{Binding Title}"
                                                                FontWeight="Bold"
                                                                FontSize="13.5"
                                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="0,0,64,0" />
                                                            <Border
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="{Binding AccentBrush}"
                                                                CornerRadius="6"
                                                                Padding="8,3">
                                                                <TextBlock
                                                                    Text="{Binding Level}"
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="#FFFFFFFF" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock
                                                            Text="{Binding StatusText}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource Brush.TextMuted}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Description -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="{Binding Description}"
                                                    FontSize="12"
                                                    LineHeight="17"
                                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                                    TextWrapping="Wrap"
                                                    Margin="18,10,16,0"
                                                    VerticalAlignment="Top" />

                                                <!-- Progress -->
                                                <StackPanel Grid.Row="2" Margin="18,12,16,16">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock
                                                            Text="{Binding ProgressLabel}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource Brush.TextPrimary}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding AccentBrush}"
                                                            Text="{Binding ProgressPercentText}" />
                                                    </Grid>
                                                    <ProgressBar
                                                        Value="{Binding ProgressPercent}"
                                                        Maximum="100"
                                                        Height="6"
                                                        Foreground="{Binding AccentBrush}"
                                                        Background="{DynamicResource Brush.Border}"
                                                        Style="{StaticResource ProgressBar.Modern}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Show All / Show Less Toggle -->
                            <Button
                                Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                Padding="16,8"
                                Command="{Binding ToggleBadgesCommand}"
                                Visibility="{Binding CanExpandBadges, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ShowAllBadgesText}" FontSize="12" FontWeight="SemiBold" />
                                    <Path
                                        Data="{StaticResource Icon.ChevronDown}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform"
                                        Margin="6,0,0,0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowAllBadges}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── POSTS & NOTES FEED ───────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="24">
                        <StackPanel>
                            <!-- Section Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.MessageSquare}" Fill="{DynamicResource Brush.Primary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Activity &amp; Engineering Notes" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Share retrospectives, architecture decisions, and code snippets with your team." Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Feed Items -->
                            <ItemsControl ItemsSource="{Binding Posts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18"
                                            Margin="0,0,0,14">
                                            <StackPanel>
                                                <!-- Post Header -->
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                        <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Post Content -->
                                                <TextBlock
                                                    Text="{Binding Content}"
                                                    FontSize="13"
                                                    LineHeight="19"
                                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,10" />

                                                <!-- Post Image -->
                                                <Border
                                                    CornerRadius="10"
                                                    Margin="0,0,0,10"
                                                    ClipToBounds="True"
                                                    Visibility="{Binding PhotoUrl, Converter={StaticResource NullToVis}}">
                                                    <Image
                                                        Source="{Binding PhotoUrl, Converter={StaticResource RelativeUrlToImage}}"
                                                        Stretch="UniformToFill"
                                                        MaxHeight="240" />
                                                </Border>

                                                <!-- Tags -->
                                                <TextBlock
                                                    Text="{Binding Tags}"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource Brush.Primary}"
                                                    FontWeight="SemiBold"
                                                    Margin="0,0,0,12"
                                                    Visibility="{Binding Tags, Converter={StaticResource NullToVis}}" />

                                                <!-- Social Reactions Bar -->
                                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Likes -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource Icon.Heart}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding LikesCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                                            <TextBlock Text=" Likes" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Comments -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource Icon.MessageSquare}" Fill="{DynamicResource Brush.TextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CommentsCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                                            <TextBlock Text=" Comments" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════════════════════════════════════════════════════════════ -->
                <!-- ── RIGHT COLUMN: Contributions, Edit Profile & Account ── -->
                <!-- ═════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="1">

                    <!-- ── CONTRIBUTIONS CARD ─────────────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="22" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Calendar}" Fill="{DynamicResource Brush.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Contributions" Style="{StaticResource Text.Heading3}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Completed tasks contribution for this month." Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Month + total -->
                            <Grid Margin="0,12,0,16">
                                <TextBlock Text="{Binding ActivityMonthLabel}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding ActivityTotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Loading -->
                            <ProgressBar
                                IsIndeterminate="True"
                                Height="4"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsActivityLoading, Converter={StaticResource BoolToVis}}" />

                            <!-- Load error -->
                            <Border
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,10"
                                Visibility="{Binding ActivityLoadFailed, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Celebrate}" Fill="{DynamicResource Brush.Warning}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Could not load activity data. Refresh your profile to try again." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Heatmap: days of the month, Sun–Sat rows with day numbers -->
                            <Grid
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14"
                                Visibility="{Binding ActivityLoadFailed, Converter={StaticResource InvertBoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Sun" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Mon" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Tue" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Wed" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Thu" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Fri" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,0" Width="28" Text="Sat" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />

                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="6" Grid.RowSpan="7" ItemsSource="{Binding ContributionCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Grid.Row" Value="{Binding Row}" />
                                            <Setter Property="Grid.Column" Value="{Binding Column}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="24"
                                                Height="24"
                                                CornerRadius="6"
                                                Margin="2"
                                                ToolTipService.ToolTip="{Binding ToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{Binding Fill}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    Text="{Binding DayNumber}"
                                                    FontSize="9"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Brush.TextPrimary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding ActivityLoadFailed, Converter={StaticResource InvertBoolToVis}}">
                                <TextBlock Text="Less" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Border Width="12" Height="12" CornerRadius="3" Margin="2" Background="#6610B981" />
                                <Border Width="12" Height="12" CornerRadius="3" Margin="2" Background="#9910B981" />
                                <Border Width="12" Height="12" CornerRadius="3" Margin="2" Background="#CC10B981" />
                                <Border Width="12" Height="12" CornerRadius="3" Margin="2" Background="#FF10B981" />
                                <TextBlock Text="More" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── EDIT PROFILE CARD ─────────────────────────────────── -->
                    <Border
                        Style="{StaticResource Border.Card}"
                        Padding="22"
                        Margin="0,0,0,20"
                        Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Edit Profile" Style="{StaticResource Text.Heading3}" />
                                <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Brush.Primary}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Update your identity and technical description." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />

                            <!-- Full Name -->
                            <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                            <TextBox
                                Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Modern}"
                                Margin="0,0,0,14" />

                            <!-- Main Engineering Role -->
                            <TextBlock Text="Engineering Role *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                            <ComboBox
                                ItemsSource="{Binding AvailableRoles}"
                                SelectedItem="{Binding ProfileRole}"
                                Style="{StaticResource ComboBox.Modern}"
                                Margin="0,0,0,14" />

                            <!-- Bio -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Short Bio" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="Max 500 chars" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox
                                Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Multiline}"
                                MaxLength="500"
                                MinHeight="110"
                                Margin="0,0,0,16"
                                Tag="Describe your focus, stack, and current team projects..." />

                            <!-- Save Button -->
                            <Button
                                Style="{StaticResource Button.Primary}"
                                Content="Save Changes"
                                Command="{Binding SaveProfileCommand}"
                                Height="42"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <!-- ── ACCOUNT OVERVIEW & DETAILS ────────────────────────── -->
                    <Border Style="{StaticResource Border.Card}" Padding="22" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Account &amp; Workspace" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                            <TextBlock Text="Your team workspace credentials and permissions." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />

                            <!-- Workspace Row -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Organization" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="OctalPulse Workspace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Rank Row -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Permission Level" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ProfileRank}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Email Row -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Account Email" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ProfileEmail}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Supported Media Uploads" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                                    <TextBlock Text="PNG, JPEG, WebP or GIF up to 5 MB. Photos are synchronized across team workstations." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>