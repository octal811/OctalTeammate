<UserControl x:Class="OctalPulse.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="480" Margin="30,24">
            <Border Style="{StaticResource Border.Card}" Padding="36">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Grid Width="36" Height="36" Margin="0,0,12,0">
                            <Grid.Clip>
                                <EllipseGeometry RadiusX="18" RadiusY="18" Center="18,18" />
                            </Grid.Clip>
                            <Image Source="pack://application:,,,/OctalPulse;component/Assets/OctalPulse.png" Width="36" Height="36" Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock Text="OCTALPULSE" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Create your team account" Style="{StaticResource Text.Heading2}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Join your organization workspace and start collaborating" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <!-- Error Alert Banner -->
                    <Border Background="#2DFE5353" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,14" />

                    <!-- Email -->
                    <TextBlock Text="Work Email" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,14" />

                    <!-- Role Dropdown -->
                    <TextBlock Text="Primary Role" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,14" />

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PwdBox" Style="{StaticResource PasswordBox.Modern}" PasswordChanged="PwdBox_PasswordChanged" Margin="0,0,0,4" />
                    <TextBlock Text="Must be 8+ chars with uppercase, lowercase, number, and special symbol (e.g. !@#$)." Style="{StaticResource Text.Caption}" Margin="0,0,0,14" />

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPwdBox" Style="{StaticResource PasswordBox.Modern}" PasswordChanged="ConfirmPwdBox_PasswordChanged" Margin="0,0,0,22" />

                    <!-- Submit Button -->
                    <Button Style="{StaticResource Button.Primary}" Content="Create Account" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,0,0,16" />

                    <!-- Busy Progress -->
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

                    <!-- Back to Login -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Already have an account?" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Sign in" Command="{Binding NavigateToLoginCommand}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Padding="0" Height="Auto" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
