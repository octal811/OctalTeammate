<Window
    x:Class="OctalPulse.Views.FastAddWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OctalPulse.ViewModels"
    Title="Fast Add • AI Plan Importer"
    Width="940"
    Height="720"
    MinWidth="780"
    MinHeight="580"
    Background="{DynamicResource Brush.Background}"
    ResizeMode="CanResizeWithGrip"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />

        <!-- Title bar button style -->
        <Style x:Key="FastAddTitleButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="FastAddTitleCloseButton"
            BasedOn="{StaticResource FastAddTitleButton}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!--  0. Window Custom Titlebar  -->
                <RowDefinition Height="40" />
                <!--  1. Main Content Area  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ==================== TITLE BAR ====================  -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <!--  Window Title with Sparkles Icon  -->
                    <StackPanel
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Path
                            Width="16"
                            Height="16"
                            Margin="0,0,10,0"
                            Data="{StaticResource Icon.Sparkles}"
                            Fill="{DynamicResource Brush.Primary}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Fast Add • AI Plan Importer" />

                        <!--  Step Indicator Pills  -->
                        <Border
                            Margin="20,0,0,0"
                            Padding="8,3"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Step 1: Paste &amp; Validate Plan" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInputStep}" Value="False">
                                                <Setter Property="Text" Value="Step 2: Live Import Execution" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!--  Titlebar Action Controls  -->
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="CloseButton_Click"
                            Style="{StaticResource FastAddTitleCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path
                                Width="10"
                                Height="10"
                                Data="{StaticResource Icon.Close}"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ==================== STEP 1: INPUT & PREVIEW ====================  -->
            <Grid Grid.Row="1" Visibility="{Binding IsInputStep, Converter={StaticResource BoolToVis}}">
                <Grid Margin="24,18,24,20">
                    <Grid.RowDefinitions>
                        <!--  Row 0: Target Selector Bar  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 1: AI Prompt Helper Banner  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 2: JSON Editor with Toolbar  -->
                        <RowDefinition Height="*" />
                        <!--  Row 3: Validation & Preview Section  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 4: Action Footer  -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0: Target Scope & Track / Major Task  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="16,12"
                        Style="{StaticResource Border.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,24,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Import Scope:" />
                                <Border
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    Background="{DynamicResource Brush.Primary}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.PrimaryForeground}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Major Tasks (with Subtasks)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMinorTasksScope}" Value="True">
                                                        <Setter Property="Text" Value="Minor Tasks (Checklist)" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!--  Track Picker for Major Tasks  -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="{Binding IsMajorTasksScope, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Target Track:" />
                                <ComboBox
                                    Width="320"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding AvailableTracks}"
                                    SelectedItem="{Binding SelectedTrack}"
                                    Style="{StaticResource ComboBox.Modern}" />
                            </StackPanel>

                            <!--  Locked Major Task display for Minor Tasks  -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="{Binding IsMinorTasksScope, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Target Major Task:" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="{Binding TargetMajorTaskTitle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Row 1: AI Prompt Helper Banner  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,14"
                        Padding="16,12"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.Primary}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="🤖 Ask your AI (ChatGPT / Claude / Gemini) to output your plan in JSON" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Copy the prompt template below, give it to your AI, and paste the JSON output here. Nullable are fully supported!" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Padding="10,0"
                                    Command="{Binding CopyMajorPromptCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Copy prompt for Major Tasks with nested subtasks"
                                    Visibility="{Binding IsMajorTasksScope, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="📋" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="Copy AI Prompt" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Padding="10,0"
                                    Command="{Binding CopyMinorPromptCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Copy prompt for Minor Tasks checklist"
                                    Visibility="{Binding IsMinorTasksScope, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="📋" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="Copy Sub-tasks Prompt" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Height="28"
                                    Padding="10,0"
                                    Command="{Binding LoadSampleJsonCommand}"
                                    Style="{StaticResource Button.Secondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="💡" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="Load Sample" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Row 2: JSON Editor with Toolbar  -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Editor Toolbar  -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Task JSON Content" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="(Markdown code blocks like ```json ... ``` are automatically stripped)" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Height="30"
                                    Margin="0,0,6,0"
                                    Padding="10,0"
                                    Command="{Binding PasteFromClipboardCommand}"
                                    Content="Paste Clipboard"
                                    Style="{StaticResource Button.Ghost}" />
                                <Button
                                    Height="30"
                                    Margin="0,0,6,0"
                                    Padding="10,0"
                                    Command="{Binding FormatJsonCommand}"
                                    Content="Format JSON"
                                    Style="{StaticResource Button.Ghost}" />
                                <Button
                                    Height="30"
                                    Padding="10,0"
                                    Command="{Binding ClearInputCommand}"
                                    Content="Clear"
                                    Style="{StaticResource Button.Ghost}" />
                            </StackPanel>
                        </Grid>

                        <!--  JSON Input TextBox  -->
                        <TextBox
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            FontFamily="Consolas, Cascadia Code, Courier New"
                            FontSize="13"
                            HorizontalScrollBarVisibility="Auto"
                            Style="{StaticResource TextBox.Multiline}"
                            Text="{Binding RawJsonInput, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <!--  Row 3: Validation Status & Warnings  -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <!--  Valid Status Banner  -->
                        <Border
                            Margin="0,0,0,6"
                            Padding="12,8"
                            Background="#1A10B981"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#10B981"
                                Text="{Binding ValidationStatusMessage}" />
                        </Border>

                        <!--  Error Status Banner  -->
                        <Border
                            Margin="0,0,0,6"
                            Padding="12,8"
                            Background="#1AEF4444"
                            BorderBrush="#EF4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#EF4444"
                                    Text="{Binding ValidationStatusMessage}" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ValidationErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,2"
                                                FontSize="12"
                                                Foreground="#EF4444"
                                                Text="{Binding StringFormat='• {0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Warnings Expander  -->
                        <Border
                            Padding="12,6"
                            Background="#1AF59E0B"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <Expander
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#F59E0B"
                                Header="{Binding ValidationWarnings.Count, StringFormat='⚠️ {0} non-blocking warning(s) found (default values applied)'}">
                                <ItemsControl Margin="16,6,0,4" ItemsSource="{Binding ValidationWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,2"
                                                FontSize="12"
                                                Foreground="#F59E0B"
                                                Text="{Binding StringFormat='• {0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <!--  Row 4: Action Footer  -->
                    <Grid Grid.Row="4">
                        <Button
                            Height="40"
                            Padding="18,0"
                            HorizontalAlignment="Left"
                            Click="CloseButton_Click"
                            Content="Cancel"
                            Style="{StaticResource Button.Ghost}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Height="40"
                                Margin="0,0,10,0"
                                Padding="16,0"
                                Command="{Binding ValidateJsonCommand}"
                                Content="Check &amp; Validate"
                                Style="{StaticResource Button.Secondary}" />

                            <Button
                                Height="40"
                                Padding="24,0"
                                Command="{Binding StartFastAddCommand}"
                                IsEnabled="{Binding IsValid}"
                                Style="{StaticResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="⚡" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="Start Fast Add" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!--  ==================== STEP 2: LIVE EXECUTION PROGRESS ====================  -->
            <Grid Grid.Row="1" Visibility="{Binding IsInputStep, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <!--  Row 0: Execution Header & Progress Bar  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 1: Real-time Live Tasks List  -->
                        <RowDefinition Height="*" />
                        <!--  Row 2: Execution Actions Footer  -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0: Progress Header & Bar  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        Padding="20,16"
                        Style="{StaticResource Border.Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Importing Tasks to Backend" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Text="{Binding ProgressText}" />
                                </StackPanel>

                                <!--  Progress Counters & Percentage  -->
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Margin="0,0,12,0"
                                        Padding="8,4"
                                        Background="#1A10B981"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#10B981"
                                            Text="{Binding SuccessCount, StringFormat='✓ {0} Created'}" />
                                    </Border>
                                    <Border
                                        Margin="0,0,16,0"
                                        Padding="8,4"
                                        Background="#1AEF4444"
                                        CornerRadius="6"
                                        Visibility="{Binding FailedCount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#EF4444"
                                            Text="{Binding FailedCount, StringFormat='✕ {0} Failed'}" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.Primary}"
                                        Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" />
                                </StackPanel>
                            </Grid>

                            <!--  Progress Bar  -->
                            <ProgressBar
                                Height="8"
                                Maximum="100"
                                Minimum="0"
                                Style="{StaticResource ProgressBar.Modern}"
                                Value="{Binding ProgressPercentage}" />
                        </StackPanel>
                    </Border>

                    <!--  Row 1: Live Real-time Tasks List  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,16"
                        Padding="12"
                        Style="{StaticResource Border.Card}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExecutionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="14,10"
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!--  Col 0: Status Icon  -->
                                                    <ColumnDefinition Width="32" />
                                                    <!--  Col 1: Title & Details  -->
                                                    <ColumnDefinition Width="*" />
                                                    <!--  Col 2: Type Badge & Status Text  -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Status Icon Indicators  -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                    <!--  Pending Icon  -->
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Text="⏳"
                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" />
                                                    <!--  InProgress Icon  -->
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="{DynamicResource Brush.Primary}"
                                                        Text="🔄"
                                                        Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}" />
                                                    <!--  Success Icon  -->
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="#10B981"
                                                        Text="✅"
                                                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" />
                                                    <!--  Failed Icon  -->
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="#EF4444"
                                                        Text="❌"
                                                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                                                    <!--  Skipped Icon  -->
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="#F59E0B"
                                                        Text="⏭️"
                                                        Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}" />
                                                </Grid>

                                                <!--  Title & Status Description  -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Title}" />

                                                    <!--  Parent info for subtasks  -->
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Text="{Binding ParentTitle, StringFormat='Subtask under: {0}'}"
                                                        Visibility="{Binding ParentTitle, Converter={StaticResource BoolToVis}}" />

                                                    <!--  Error message if failed  -->
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        FontWeight="Medium"
                                                        Foreground="#EF4444"
                                                        Text="{Binding ErrorMessage}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!--  Badges & Status  -->
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <!--  Status Text  -->
                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{Binding StatusDisplay}" />

                                                    <!--  Type Badge  -->
                                                    <Border
                                                        Padding="8,3"
                                                        Background="{DynamicResource Brush.Surface}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource Brush.TextMuted}"
                                                            Text="{Binding TypeBadge}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!--  Row 2: Execution Actions Footer  -->
                    <Grid Grid.Row="2">
                        <!--  Back button (visible if finished)  -->
                        <Button
                            Height="40"
                            Padding="16,0"
                            HorizontalAlignment="Left"
                            Command="{Binding BackToInputCommand}"
                            Content="← Back to Input"
                            IsEnabled="{Binding IsExecuting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            Style="{StaticResource Button.Ghost}" />

                        <!--  Right Actions  -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <!--  Copy Error Report (if failures)  -->
                            <Button
                                Height="40"
                                Margin="0,0,10,0"
                                Padding="16,0"
                                Command="{Binding CopyErrorReportCommand}"
                                Content="Copy Error Log"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding FailedCount, Converter={StaticResource BoolToVis}}" />

                            <!--  Retry Failed Tasks  -->
                            <Button
                                Height="40"
                                Margin="0,0,10,0"
                                Padding="18,0"
                                Command="{Binding RetryFailedCommand}"
                                Content="🔄 Retry Failed"
                                IsEnabled="{Binding IsExecuting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding FailedCount, Converter={StaticResource BoolToVis}}" />

                            <!--  Done Button  -->
                            <Button
                                Height="40"
                                Padding="28,0"
                                Command="{Binding CloseDialogCommand}"
                                Content="Done"
                                IsEnabled="{Binding IsExecuting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
