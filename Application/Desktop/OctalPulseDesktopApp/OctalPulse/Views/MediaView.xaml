<UserControl
    x:Class="OctalPulse.Views.MediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:OctalPulse.Views"
    xmlns:vm="clr-namespace:OctalPulse.ViewModels"
    d:DesignHeight="900"
    d:DesignWidth="1100"
    Background="{DynamicResource Brush.Background}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
        <converters:RelativeUrlToImageSourceConverter x:Key="RelativeUrlToImage" />

        <!-- Reaction Button Active Style -->
        <Style x:Key="ReactionButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,40">
            <Grid.RowDefinitions>
                <!-- Header & Filters -->
                <RowDefinition Height="Auto" />
                <!-- Content Stream -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Primary}" Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon.Media}" Fill="{DynamicResource Brush.PrimaryForeground}" Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Media &amp; Community" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                    <TextBlock Margin="44,4,0,0" Text="Browse community posts, project discoveries, personal notes, and team updates."
                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>

                <!-- Filter Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- General Only Toggle -->
                    <CheckBox Content="General Only" IsChecked="{Binding FilterOnlyGeneral}" VerticalAlignment="Center" Margin="0,0,16,0"
                              Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Medium" />

                    <!-- Project Filter Dropdown -->
                    <ComboBox Width="180" Height="36" Margin="0,0,12,0"
                              Style="{StaticResource ComboBox.Modern}"
                              ItemsSource="{Binding FilterProjectOptions}"
                              SelectedItem="{Binding FilterProject}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding FilterOnlyGeneral, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshFeedCommand}" Style="{StaticResource Button.Secondary}" Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Brush.TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Feed Column (Centered Facebook-style card layout) -->
            <StackPanel Grid.Row="1" MaxWidth="780" HorizontalAlignment="Stretch">

                <!-- ── Create Post Composer Card ── -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Composer Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- User Avatar -->
                            <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0">
                                <Border CornerRadius="21" Background="{DynamicResource Brush.Primary}">
                                    <TextBlock Text="{Binding UserSession.Name, Converter={StaticResource StringToInitial}}"
                                               Foreground="{DynamicResource Brush.PrimaryForeground}" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="21"
                                        Visibility="{Binding UserSession.ProfileImageUrl, Converter={StaticResource NullToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding UserSession.ProfileImageUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserSession.Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="Create a post" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>

                            <!-- Scope Picker (Project / Track) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="190" Height="36" Margin="0,0,8,0"
                                          Style="{StaticResource ComboBox.Modern}"
                                          ItemsSource="{Binding AvailableProjects}"
                                          SelectedItem="{Binding SelectedProject}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Select visibility: General (profile &amp; feed) or a specific project" />

                                <ComboBox Width="200" Height="36"
                                          Style="{StaticResource ComboBox.Modern}"
                                          ItemsSource="{Binding AvailableTracks}"
                                          SelectedItem="{Binding SelectedTrack}"
                                          DisplayMemberPath="DisplayName"
                                          Visibility="{Binding IsProjectSelected, Converter={StaticResource BoolToVis}}"
                                          ToolTip="All Tracks = visible to everyone in the project. Select a specific track to narrow visibility." />
                            </StackPanel>
                        </Grid>

                        <!-- Content TextBox (1,800 characters limit) -->
                        <TextBox Text="{Binding NewPostContent, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="1800"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="85"
                                 MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12,10"
                                 FontSize="14"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 CaretBrush="{DynamicResource Brush.Primary}"
                                 SelectionBrush="{DynamicResource Brush.Primary}"
                                 Background="{DynamicResource Brush.Background}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 Margin="0,0,0,12" />

                        <!-- Photo URL Input (External Link or Drive) -->
                        <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Image}" Fill="{DynamicResource Brush.TextMuted}"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding NewPostPhotoUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         CaretBrush="{DynamicResource Brush.Primary}"
                                         SelectionBrush="{DynamicResource Brush.Primary}"
                                         ToolTip="Paste Google Drive image/video link or external photo URL" />
                            </Grid>
                        </Border>

                        <!-- Composer Footer (Char counter & Publish) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RemainingCharacters}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Primary}" FontSize="12" />
                                <TextBlock Text=" / 1800 characters remaining" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CreatePostCommand}" Style="{StaticResource Button.Primary}"
                                    Height="36" Padding="20,0" IsEnabled="{Binding IsCreatingPost, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Send}" Fill="{DynamicResource Brush.PrimaryForeground}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Publish Post" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Loading Feed Spinner -->
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"
                             Visibility="{Binding IsLoadingFeed, Converter={StaticResource BoolToVis}}" />

                <!-- Empty Feed Notice -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="12" Padding="40" Margin="0,0,0,24" HorizontalAlignment="Stretch"
                        Visibility="{Binding Posts.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Media}" Fill="{DynamicResource Brush.TextMuted}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="No posts in this stream yet" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Share something to initiate conversations with your teammates." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ── Feed Posts List ── -->
                <ItemsControl ItemsSource="{Binding Posts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PostCardViewModel}">
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Post Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Author Avatar -->
                                        <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                            <Border CornerRadius="22" Background="{DynamicResource Brush.Primary}">
                                                <TextBlock Text="{Binding AuthorName, Converter={StaticResource StringToInitial}}"
                                                           Foreground="{DynamicResource Brush.PrimaryForeground}" FontSize="15" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="22"
                                                    Visibility="{Binding AuthorAvatarUrl, Converter={StaticResource NullToVis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding AuthorAvatarUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <!-- Author Details & Badges -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AuthorName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,8,0" />

                                                <!-- General Scope Badge -->
                                                <Border Background="#103B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                                    <TextBlock Text="🌐 General" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                </Border>

                                                <!-- Project Scope Badge -->
                                                <Border Background="#1010B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding ProjectTitle, Converter={StaticResource NullToVis}}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📁 " FontSize="10" />
                                                        <TextBlock Text="{Binding ProjectTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Track Scope Badge -->
                                                <Border Background="#108B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding TrackName, Converter={StaticResource NullToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡ " FontSize="10" />
                                                        <TextBlock Text="{Binding TrackName}" FontSize="11" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding AuthorRole}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0" />
                                                <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding TimeAgo}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Delete Post (Author Only) -->
                                        <Button Grid.Column="2" Command="{Binding DeletePostCommand}" Style="{StaticResource Button.Ghost}"
                                                Width="32" Height="32" Padding="0" ToolTip="Delete Post"
                                                Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- Post Content Body -->
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,14" />

                                    <!-- Attached Media (Image / Drive Video / External Link) -->
                                    <Grid Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,14" ClipToBounds="True">
                                        <!-- Inline image (direct or Drive image) -->
                                        <Border Visibility="{Binding IsImageMedia, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1" CornerRadius="8" MaxHeight="380" ClipToBounds="True">
                                            <Image Source="{Binding PhotoUrl, Converter={StaticResource RelativeUrlToImage}}"
                                                   Stretch="Uniform" HorizontalAlignment="Center" />
                                        </Border>

                                        <!-- External link / unsupported media (Drive video, YouTube, Facebook, etc.) -->
                                        <Border Visibility="{Binding IsExternalLink, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Button Style="{StaticResource Button.Ghost}" Height="Auto" Padding="0"
                                                    Background="Transparent" Cursor="Hand"
                                                    Command="{Binding OpenMediaLinkCommand}"
                                                    ToolTip="Open link in your browser">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Data="{StaticResource Icon.Link}" Fill="{DynamicResource Brush.TextMuted}"
                                                              Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="Open link in browser"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </Grid>

                                    <!-- Reactions & Comments Summary Counts -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Reactions Breakdown -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#103B82F6" CornerRadius="10" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding LikeCount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding LikeCount, StringFormat='👍 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                            </Border>
                                            <Border Background="#10EF4444" CornerRadius="10" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding LoveCount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding LoveCount, StringFormat='❤️ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                                            </Border>
                                            <Border Background="#10F59E0B" CornerRadius="10" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding CelebrateCount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CelebrateCount, StringFormat='🎉 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            </Border>
                                            <Border Background="#1010B981" CornerRadius="10" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding InsightfulCount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding InsightfulCount, StringFormat='💡 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                            </Border>
                                            <TextBlock Text="{Binding TotalReactions, StringFormat='{}{0} total'}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Visibility="{Binding TotalReactions, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Comments Count -->
                                        <Button Grid.Column="1" Command="{Binding ToggleCommentsCommand}" Style="{StaticResource Button.Ghost}"
                                                Padding="0" Height="24">
                                            <TextBlock Text="{Binding CommentsCount, StringFormat='{}{0} Comments'}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Button>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,8" />

                                    <!-- Action Buttons Bar (Like, Love, Celebrate, Insightful, Comments) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <!-- Like -->
                                            <Button Style="{StaticResource ReactionButtonStyle}"
                                                    Command="{Binding ToggleReactionCommand}" CommandParameter="Like">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👍 " />
                                                    <TextBlock Text="Like" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Love -->
                                            <Button Style="{StaticResource ReactionButtonStyle}"
                                                    Command="{Binding ToggleReactionCommand}" CommandParameter="Love">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="❤️ " />
                                                    <TextBlock Text="Love" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Celebrate -->
                                            <Button Style="{StaticResource ReactionButtonStyle}"
                                                    Command="{Binding ToggleReactionCommand}" CommandParameter="Celebrate">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎉 " />
                                                    <TextBlock Text="Celebrate" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Insightful -->
                                            <Button Style="{StaticResource ReactionButtonStyle}"
                                                    Command="{Binding ToggleReactionCommand}" CommandParameter="Insightful">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💡 " />
                                                    <TextBlock Text="Insightful" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Toggle Comments Button -->
                                        <Button Grid.Column="1" Style="{StaticResource ReactionButtonStyle}" Command="{Binding ToggleCommentsCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.MessageSquare}" Fill="{DynamicResource Brush.TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Comments" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- ── Expandable Comments Section ── -->
                                    <StackPanel Visibility="{Binding IsCommentsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14" />

                                        <!-- New Comment Input (800 chars limit) -->
                                        <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="800" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="48" MaxHeight="120"
                                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                                         CaretBrush="{DynamicResource Brush.Primary}"
                                                         SelectionBrush="{DynamicResource Brush.Primary}" />
                                                <Grid Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding RemainingCommentCharacters, StringFormat='{}{0} / 800 chars'}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                    <Button Command="{Binding SubmitCommentCommand}" Style="{StaticResource Button.Primary}"
                                                            HorizontalAlignment="Right" Height="28" Padding="14,0"
                                                            IsEnabled="{Binding IsSubmittingComment, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                        <TextBlock Text="Comment" FontSize="12" FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Comments Items Control -->
                                        <ItemsControl ItemsSource="{Binding Comments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CommentCardViewModel}">
                                                    <Border Margin="0,0,0,12" Background="{DynamicResource Brush.Background}" CornerRadius="8" Padding="12">
                                                        <StackPanel>
                                                            <!-- Comment Header -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,10,0">
                                                                    <Border CornerRadius="15" Background="{DynamicResource Brush.Primary}">
                                                                        <TextBlock Text="{Binding UserName, Converter={StaticResource StringToInitial}}"
                                                                                   Foreground="{DynamicResource Brush.PrimaryForeground}" FontSize="12" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border CornerRadius="15" Visibility="{Binding UserAvatarUrl, Converter={StaticResource NullToVis}}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding UserAvatarUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                                </StackPanel>

                                                                <!-- Delete Comment Button (Author Only) -->
                                                                <Button Grid.Column="2" Command="{Binding DeleteCommentCommand}" Style="{StaticResource Button.Ghost}"
                                                                        Width="24" Height="24" Padding="0" ToolTip="Delete Comment"
                                                                        Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVis}}">
                                                                    <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="11" Height="11" Stretch="Uniform" />
                                                                </Button>
                                                            </Grid>

                                                            <!-- Comment Text -->
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                                                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="40,6,0,8" />

                                                            <!-- Reply Link -->
                                                            <StackPanel Orientation="Horizontal" Margin="40,0,0,6">
                                                                <Button Command="{Binding ToggleReplyCommand}" Style="{StaticResource Button.Ghost}"
                                                                        Padding="0" Height="20">
                                                                    <TextBlock Text="Reply" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Inline Reply Input (800 chars limit) -->
                                                            <Border Visibility="{Binding IsReplying, Converter={StaticResource BoolToVis}}"
                                                                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="40,4,0,8">
                                                                <StackPanel>
                                                                    <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                                                             MaxLength="800" AcceptsReturn="True" TextWrapping="Wrap"
                                                                             MinHeight="40" MaxHeight="90" Background="Transparent" BorderThickness="0"
                                                                             FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"
                                                                             CaretBrush="{DynamicResource Brush.Primary}"
                                                                             SelectionBrush="{DynamicResource Brush.Primary}" />
                                                                    <Grid Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding RemainingReplyCharacters, StringFormat='{}{0} / 800 chars'}"
                                                                                   FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                                        <Button Command="{Binding SubmitReplyCommand}" Style="{StaticResource Button.Primary}"
                                                                                HorizontalAlignment="Right" Height="24" Padding="10,0"
                                                                                IsEnabled="{Binding IsSubmittingReply, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                                            <TextBlock Text="Send Reply" FontSize="11" FontWeight="SemiBold" />
                                                                        </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Nested Replies -->
                                                            <ItemsControl ItemsSource="{Binding Replies}" Margin="40,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CommentCardViewModel}">
                                                                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0">
                                                                                        <!-- Fallback initial -->
                                                                                        <Border CornerRadius="12" Background="{DynamicResource Brush.Primary}">
                                                                                            <TextBlock Text="{Binding UserName, Converter={StaticResource StringToInitial}}"
                                                                                                       Foreground="{DynamicResource Brush.PrimaryForeground}" FontSize="10" FontWeight="Bold"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <!-- Avatar image overlay -->
                                                                                        <Border CornerRadius="12" Visibility="{Binding UserAvatarUrl, Converter={StaticResource NullToVis}}">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{Binding UserAvatarUrl, Converter={StaticResource RelativeUrlToImage}}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,6,0" />
                                                                                            <TextBlock Text="{Binding TimeAgo}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <Button Grid.Column="2" Command="{Binding DeleteCommentCommand}" Style="{StaticResource Button.Ghost}"
                                                                                            Width="20" Height="20" Padding="0" ToolTip="Delete Reply"
                                                                                            Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVis}}">
                                                                                        <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="10" Height="10" Stretch="Uniform" />
                                                                                    </Button>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" LineHeight="17"
                                                                                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="32,4,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Load More Button -->
                <Button Command="{Binding LoadMoreCommand}" Style="{StaticResource Button.Secondary}"
                        Height="40" Margin="0,10,0,40" HorizontalAlignment="Center" Padding="32,0"
                        Visibility="{Binding HasNextPage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Load More Posts" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
