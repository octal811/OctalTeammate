<UserControl x:Class="OctalPulse.Views.TrackDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
            <StackPanel>
                <!-- Back Navigation -->
                <Button Style="{StaticResource Button.Ghost}" Content="← Back to Project" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="0" />

                <!-- Track Header Card -->
                <Border Style="{StaticResource Border.Card}" Padding="24" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TrackName}" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
                            <TextBlock Text="Major deliverables owned by this track. Complete sub-tasks to drive track and project progress." Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenFastAddCommand}"
                                    Margin="0,0,10,0"
                                    ToolTip="Import group of tasks from AI Plan"
                                    Height="40" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Margin="0,0,6,0" Data="{StaticResource Icon.Sparkles}" Fill="{DynamicResource Brush.Primary}" Stretch="Uniform" />
                                    <TextBlock Text="⚡ Fast Add" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" Content="+ New Major Task" Command="{Binding OpenCreateMajorTaskModalCommand}" Height="40" Padding="18,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loading Bar -->
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

                <!-- Empty State -->
                <Border Style="{StaticResource Border.Card}" Padding="40" Visibility="{Binding MajorTasks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.TextMuted}" Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,16" />
                        <TextBlock Text="No major tasks in this track yet." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Create a major task to break down features or deliverables." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Button Style="{StaticResource Button.Primary}" Content="Create Major Task" Command="{Binding OpenCreateMajorTaskModalCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Major Tasks Cards -->
                <ItemsControl ItemsSource="{Binding MajorTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Border.Card}" Margin="0,0,0,16" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Title, Priority, State -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                FontSize="26"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding Item.Title}" />
                                            <!--  Priority Badge  -->
                                            <Border
                                                Margin="0,0,8,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Item.Priority, Converter={StaticResource PriorityToBrush}}"
                                                    Text="{Binding Item.Priority}" />
                                            </Border>
                                            <!--  State Badge  -->
                                            <Border
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                CornerRadius="6">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="{Binding Item.State, Converter={StaticResource StatusToBrush}}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding Item.State}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions (owner only) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource Button.Icon}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenEditMajorTaskModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Edit Task">
                                                <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Brush.TextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Icon}"
                                                    Command="{Binding DataContext.DeleteMajorTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Delete Task">
                                                <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Item.Description, FallbackValue='No description provided.'}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- Details -->
                                    <TextBlock Grid.Row="2" Text="{Binding Item.Details}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Visibility="{Binding Item.Details, Converter={StaticResource NullToVis}}" />

                                    <!-- External Work Link Tile -->
                                    <Border Grid.Row="3" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                                            Visibility="{Binding Item.Link, Converter={StaticResource NullToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Surface}" Margin="0,0,12,0">
                                                <Path Data="{StaticResource Icon.GitHub}" Fill="{DynamicResource Brush.TextPrimary}" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Linked External Work" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding Item.Link}" FontSize="12" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Open Link ↗"
                                                    Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Item.Link}" Height="30" Padding="12,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Row: Progress & Open Checklist -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Progress Bar -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Progress from Checklist" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding Item.Progress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Item.Progress}" Maximum="100" Style="{StaticResource ProgressBar.Modern}" />
                                        </StackPanel>

                                        <!-- Open Sub-tasks Button -->
                                        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Sub-tasks Checklist →" 
                                                Command="{Binding DataContext.OpenMajorTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Height="34" Padding="14,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Modal: Create Major Task ────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateMajorTaskModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="520" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Create Major Task" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseCreateMajorTaskModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Task Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Priority" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding NewTaskPriority}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Due Date" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding NewTaskDueDate}" Height="40" Margin="0,0,0,16" />

                        <TextBlock Text="External Work Link (GitHub / Jira / Docs)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTaskLink, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="130" Margin="0,0,0,16" />

                        <TextBlock Text="Details (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewTaskDetails, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="90" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseCreateMajorTaskModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Create Task" Command="{Binding SubmitCreateMajorTaskCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Modal: Edit Major Task ────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsEditMajorTaskModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="520" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Edit Major Task" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseEditMajorTaskModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Task Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditTaskTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="State" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding AvailableTaskStates}" SelectedItem="{Binding EditTaskState}" Style="{StaticResource ComboBox.Modern}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Priority" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding EditTaskPriority}" Style="{StaticResource ComboBox.Modern}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Due Date" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding EditTaskDueDate}" Height="40" Margin="0,0,0,16" />

                        <TextBlock Text="External Work Link (GitHub / Jira / Docs)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditTaskLink, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditTaskDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="130" Margin="0,0,0,16" />

                        <TextBlock Text="Details (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditTaskDetails, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="90" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseEditMajorTaskModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Save Changes" Command="{Binding SubmitEditMajorTaskCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
