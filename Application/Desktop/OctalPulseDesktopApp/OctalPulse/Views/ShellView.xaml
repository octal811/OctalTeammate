<UserControl
    x:Class="OctalPulse.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:OctalPulse.Views"
    xmlns:vm="clr-namespace:OctalPulse.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Background="{DynamicResource Brush.Background}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
        <converters:RelativeUrlToImageSourceConverter x:Key="RelativeUrlToImage" />

        <!--  DataTemplates for Main Shell Content Area  -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrackDetailViewModel}">
            <views:TrackDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MajorTaskDetailViewModel}">
            <views:MajorTaskDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
            <views:CalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <views:TasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OctoViewModel}">
            <views:OctoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StopwatchViewModel}">
            <views:StopwatchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaViewModel}">
            <views:MediaView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--  Sidebar Navigation (Auto width shrinks to 0 when collapsed)  -->
            <ColumnDefinition Width="Auto" />
            <!--  Main Work Area  -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ── Left Sidebar Navigation ────────────────────────────────────  -->
        <Border
            Grid.Column="0"
            Width="250"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0"
            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid>
                <Grid.RowDefinitions>
                    <!--  Brand / Workspace  -->
                    <RowDefinition Height="Auto" />
                    <!--  Navigation Links  -->
                    <RowDefinition Height="*" />
                    <!--  User Profile & Sign Out  -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Brand Header  -->
                <StackPanel Grid.Row="0" Margin="0,20,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Margin="26,0,0,0"
                            Orientation="Horizontal">
                            <Grid
                                Width="40"
                                Height="40"
                                Margin="0,0,12,0">
                                <Grid.Clip>
                                    <EllipseGeometry
                                        RadiusX="20"
                                        RadiusY="20"
                                        Center="20,20" />
                                </Grid.Clip>
                                <Image
                                    Width="40"
                                    Height="40"
                                    Source="pack://application:,,,/OctalPulse;component/Assets/OctalPulse.png"
                                    Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="OCTALPULSE" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="Team Workspace" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border
                        Height="1"
                        Margin="0,18,0,0"
                        Background="{DynamicResource Brush.Border}" />
                </StackPanel>

                <!--  Navigation Items  -->
                <ScrollViewer
                    Grid.Row="1"
                    Margin="12,0"
                    Padding="0,0,8,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Section Label  -->
                        <TextBlock
                            Margin="12,0,0,10"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="MENU" />

                        <!--  Dashboard  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Dashboard}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Dashboard" />
                            </StackPanel>
                        </Button>

                        <!--  Projects  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateProjectsCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Projects}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Projects" />
                            </StackPanel>
                        </Button>

                        <!--  Calendar  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCalendarCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Calendar}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Calendar" />
                            </StackPanel>
                        </Button>

                        <!--  Tasks Center  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateTasksCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Tasks}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Tasks Center" />
                            </StackPanel>
                        </Button>

                        <!--  Octo AI Supporter  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateOctoCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <Grid Width="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Grid
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,12,0">
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource Icon.Sparkles}"
                                            Fill="{DynamicResource Brush.Primary}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Octo AI" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="6,1"
                                    Background="{DynamicResource Brush.PrimarySoft}"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.Primary}"
                                        Text="AGENT" />
                                </Border>
                            </Grid>
                        </Button>

                        <!--  Stopwatch  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateStopwatchCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Stopwatch}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Stopwatch" />
                            </StackPanel>
                        </Button>

                        <!--  Profile  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateProfileCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.User}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Profile" />
                            </StackPanel>
                        </Button>

                        <!--  Media  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateMediaCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Media}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Media" />
                            </StackPanel>
                        </Button>

                        <!--  Section: Preferences  -->
                        <TextBlock
                            Margin="12,24,0,10"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="PREFERENCES" />

                        <!--  Settings  -->
                        <Button
                            Height="42"
                            Margin="0,2"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{StaticResource Button.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Icon.Settings}"
                                        Fill="{DynamicResource Brush.TextSecondary}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="Settings &amp; GitHub" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!--  Bottom Profile Bar  -->
                <Border
                    Grid.Row="2"
                    Margin="12,12,12,16"
                    Padding="16"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Avatar Initial Circle  -->
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                            <Border
                                Background="{DynamicResource Brush.Primary}"
                                CornerRadius="18">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Text="{Binding UserSession.Name, Converter={StaticResource StringToInitial}}" />
                            </Border>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush
                                        ImageSource="{Binding UserSession.ProfileImageUrl, Converter={StaticResource RelativeUrlToImage}}"
                                        Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!--  User Info  -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="{Binding UserSession.Name, FallbackValue='Team Member'}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="{Binding UserSession.MainRole, FallbackValue='Engineer'}" />
                        </StackPanel>

                        <!--  Sign Out Button  -->
                        <Button
                            Grid.Column="2"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Sign Out">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{StaticResource Icon.Logout}"
                                Fill="{DynamicResource Brush.Danger}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ── Main Work Area ───────────────────────────────────────────  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!--  Top Shell Header  -->
                <RowDefinition Height="56.05" />
                <RowDefinition Height="7.95" />
                <!--  Active Content View  -->
                <RowDefinition Height="0*" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--  Top Header Bar  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Padding="28,0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Route Title & Sidebar Toggle  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,0,14,0"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Toggle Sidebar">
                            <Path
                                Width="18"
                                Height="14"
                                Data="M3 12h18M3 6h18M3 18h18"
                                Stretch="Uniform"
                                Stroke="{DynamicResource Brush.TextSecondary}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </Button>
                        <!--  Breadcrumb Trail  -->
                        <ItemsControl
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Navigation.Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--  Separator (chevron between crumbs)  -->
                                        <TextBlock
                                            Margin="6,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="›"
                                            Visibility="{Binding IsFirst, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                        <!--  Navigable ancestor crumb  -->
                                        <Button
                                            Padding="6,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding NavigateCommand}"
                                            Content="{Binding Label}"
                                            Cursor="Hand"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Style="{StaticResource Button.Ghost}"
                                            ToolTip="Navigate here"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                        <!--  Current page crumb  -->
                                        <TextBlock
                                            MaxWidth="260"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Label}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Header Controls & Indicators  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  SignalR Realtime Indicator (Click to Reconnect)  -->
                        <Button
                            Height="Auto"
                            Margin="0,0,16,0"
                            Padding="0"
                            Command="{Binding ReconnectSignalRCommand}"
                            Cursor="Hand"
                            Style="{StaticResource Button.Ghost}">
                            <Button.ToolTip>
                                <ToolTip Content="Real-time collaboration status. Click to reconnect immediately." />
                            </Button.ToolTip>
                            <Border
                                Padding="12,6"
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                CornerRadius="16">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <!--  Pulsing Dot  -->
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#F59E0B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Brush.TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Offline (Retry)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                        <Setter Property="Text" Value="Live Sync" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>



                    </StackPanel>
                </Grid>
            </Border>

            <!--  Main Dynamic Content  -->
            <ContentControl
                Grid.Row="2"
                Grid.RowSpan="2"
                Content="{Binding CurrentView}" />
        </Grid>

        <!--  ── In-App Floating Toast Notification ───────────────────────  -->
        <Border
            Grid.ColumnSpan="2"
            Width="340"
            Margin="0,24,24,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource Brush.CardBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Opacity="0.3"
                    ShadowDepth="4"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Indicator Bar  -->
                <Border
                    Grid.Column="0"
                    Width="4"
                    Margin="0,0,12,0"
                    CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Info}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastType}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!--  Toast Text  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Text="{Binding ToastTitle}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="{Binding ToastMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Dismiss Button  -->
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Command="{Binding DismissToastCommand}"
                    Style="{StaticResource Button.Icon}">
                    <Path
                        Width="10"
                        Height="10"
                        Data="{StaticResource Icon.Close}"
                        Fill="{DynamicResource Brush.TextMuted}"
                        Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
