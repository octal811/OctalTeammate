<UserControl x:Class="OctalPulse.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             xmlns:vm="clr-namespace:OctalPulse.ViewModels"
             xmlns:views="clr-namespace:OctalPulse.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />

        <!-- DataTemplates for Main Shell Content Area -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrackDetailViewModel}">
            <views:TrackDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MajorTaskDetailViewModel}">
            <views:MajorTaskDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
            <views:CalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <views:TasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation (Auto width shrinks to 0 when collapsed) -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Work Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left Sidebar Navigation ──────────────────────────────────── -->
        <Border Grid.Column="0" Width="250" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand / Workspace -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Links -->
                    <RowDefinition Height="*" />
                    <!-- User Profile & Sign Out -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.Primary}" Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.Logo}" Fill="{DynamicResource Brush.PrimaryForeground}" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="OCTALPULSE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="Team Workspace" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="Medium" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Command="{Binding ToggleSidebarCommand}" ToolTip="Close Sidebar" Width="30" Height="30" VerticalAlignment="Center">
                            <Path Data="M15 18l-6-6 6-6" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,18,0,0" />
                </StackPanel>

                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0">
                    <StackPanel>
                        <!-- Section Label -->
                        <TextBlock Text="MENU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,0,0,10" />

                        <!-- Dashboard -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding NavigateDashboardCommand}" HorizontalContentAlignment="Left" Height="42" Padding="12,0" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Dashboard}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Dashboard" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Projects -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding NavigateProjectsCommand}" HorizontalContentAlignment="Left" Height="42" Padding="12,0" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Projects}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Projects" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Calendar -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding NavigateCalendarCommand}" HorizontalContentAlignment="Left" Height="42" Padding="12,0" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Calendar}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Calendar" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tasks Center -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding NavigateTasksCommand}" HorizontalContentAlignment="Left" Height="42" Padding="12,0" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Tasks}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Tasks Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Preferences -->
                        <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,24,0,10" />

                        <!-- Settings -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding NavigateSettingsCommand}" HorizontalContentAlignment="Left" Height="42" Padding="12,0" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Settings &amp; GitHub" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Profile Bar -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceElevated}" Padding="16" Margin="12,12,12,16" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Initial Circle -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.Primary}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding UserSession.Name, Converter={StaticResource StringToInitial}}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserSession.Name, FallbackValue='Team Member'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserSession.MainRole, FallbackValue='Engineer'}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>

                        <!-- Sign Out Button -->
                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding LogoutCommand}" ToolTip="Sign Out">
                            <Path Data="{StaticResource Icon.Logout}" Fill="{DynamicResource Brush.Danger}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ── Main Work Area ─────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Shell Header -->
                <RowDefinition Height="64" />
                <!-- Active Content View -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Route Title & Sidebar Toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleSidebarCommand}" 
                                ToolTip="Toggle Sidebar" Margin="0,0,14,0" Width="32" Height="32">
                            <Path Data="M3 12h18M3 6h18M3 18h18" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="{Binding CurrentRoute}" Style="{StaticResource Text.Heading3}" />
                    </StackPanel>

                    <!-- Header Controls & Indicators -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- SignalR Realtime Indicator (Click to Reconnect) -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding ReconnectSignalRCommand}"
                                Padding="0" Height="Auto" Margin="0,0,16,0" Cursor="Hand">
                            <Button.ToolTip>
                                <ToolTip Content="Real-time collaboration status. Click to reconnect immediately." />
                            </Button.ToolTip>
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="16" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pulsing Dot -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#F59E0B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Brush.TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Offline (Retry)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                        <Setter Property="Text" Value="Live Sync" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>



                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dynamic Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- ── In-App Floating Toast Notification ─────────────────────── -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                CornerRadius="10" Padding="16" Width="340"
                Background="{DynamicResource Brush.CardBackground}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Indicator Bar -->
                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Info}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastType}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Toast Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ToastMessage}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Dismiss Button -->
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" Command="{Binding DismissToastCommand}">
                    <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
