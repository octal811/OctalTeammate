<UserControl x:Class="OctalPulse.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:DateFormattingConverter x:Key="DateFormatter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
            <StackPanel>
                <!-- Header & Project Selector Row -->
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Team Calendar &amp; Schedule" Style="{StaticResource Text.Heading1}" Margin="0,0,0,4" />
                        <TextBlock Text="Coordinate sprint releases, team meetings, milestones, and project deadlines." Style="{StaticResource Text.Subtitle}" />
                    </StackPanel>

                    <!-- Project Selector -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Project:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Title" Style="{StaticResource ComboBox.Modern}" Width="220" Height="40" />
                    </StackPanel>
                </Grid>

                <!-- Month Navigation Header -->
                <Border Style="{StaticResource Border.Card}" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding PreviousMonthCommand}">
                                <Path Data="{StaticResource Icon.ChevronLeft}" Fill="{DynamicResource Brush.TextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="{Binding MonthTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="16,0" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding NextMonthCommand}">
                                <Path Data="{StaticResource Icon.ChevronRight}" Fill="{DynamicResource Brush.TextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <Button Style="{StaticResource Button.Primary}" Content="+ Add Event" Command="{Binding OpenCreateEventModalCommand}" HorizontalAlignment="Right" Height="36" Padding="16,0" />
                    </Grid>
                </Border>

                <!-- Loading Bar -->
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

                <!-- Calendar Content Grid: Left 7-column Calendar, Right Selected Day Inspector -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 7-column Days Grid -->
                    <Border Grid.Column="0" Style="{StaticResource Border.Card}" Padding="16">
                        <StackPanel>
                            <!-- Weekday Headers -->
                            <UniformGrid Columns="7" Margin="0,0,0,12">
                                <TextBlock Text="MON" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="TUE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="WED" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="THU" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="FRI" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="SAT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="SUN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                            </UniformGrid>

                            <!-- Day Cells Grid (42 Cells) -->
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Interactive Day Cell -->
                                        <Border Height="74" Margin="2" CornerRadius="8" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" 
                                                              Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <!-- Day Number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" />

                                                <!-- Event Indicator Dots -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Primary}" Margin="2,0,0,0"
                                                             Visibility="{Binding DayEvents.Count, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Event Count Chip -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="4,1"
                                                        Visibility="{Binding DayEvents.Count, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DayEvents.Count, StringFormat='{}{0} ev'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right Inspector: Selected Day Events -->
                    <Border Grid.Column="2" Style="{StaticResource Border.Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDay.Date, Converter={StaticResource DateFormatter}, ConverterParameter='dddd, MMMM dd'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedDayEvents.Count, StringFormat='{}{0} event(s) scheduled'}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,16" />

                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,16" />

                            <!-- Empty Events Notice -->
                            <TextBlock Text="No events on this day." FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" 
                                       Visibility="{Binding SelectedDayEvents.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" 
                                       Margin="0,20" HorizontalAlignment="Center" />

                            <!-- Day Events List -->
                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Width="160" HorizontalAlignment="Left" />
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource Button.Icon}" Width="20" Height="20"
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Delete Event">
                                                        <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="10" Height="10" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Modal: Create Event ──────────────────────────────────────── -->
        <Grid Background="#7F000000" Visibility="{Binding IsCreateEventModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Border.Card}" Width="500" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Add Calendar Event" Style="{StaticResource Text.Heading2}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseCreateEventModalCommand}" HorizontalAlignment="Right">
                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Event Title" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewEventTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Event Type" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableEventTypes}" SelectedItem="{Binding NewEventType}" Style="{StaticResource ComboBox.Modern}" Margin="0,0,0,16" />

                        <TextBlock Text="Event Date" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding NewEventDate}" Height="40" Margin="0,0,0,16" />

                        <TextBlock Text="Description (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewEventDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="110" Margin="0,0,0,24" />

                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CloseCreateEventModalCommand}" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Primary}" Content="Save Event" Command="{Binding SubmitCreateEventCommand}" HorizontalAlignment="Right" Padding="20,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
