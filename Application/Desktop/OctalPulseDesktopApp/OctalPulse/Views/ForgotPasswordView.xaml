<UserControl x:Class="OctalPulse.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Margin="30,24">
            <Border Style="{StaticResource Border.Card}" Padding="36">
                <StackPanel>
                    <!-- Icon -->
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Path Data="{StaticResource Icon.Lock}" Fill="{DynamicResource Brush.Primary}" Width="24" Height="24" Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="Reset your password" Style="{StaticResource Text.Heading2}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    
                    <!-- Step 1 Subtitle -->
                    <TextBlock Text="Enter your verified email to receive a password reset code." 
                               Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"
                               Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}" />
                    
                    <!-- Step 2 Subtitle -->
                    <TextBlock Text="Enter the 8-digit OTP code sent to your email and set your new password." 
                               Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"
                               Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}" />

                    <!-- Error Alert Banner -->
                    <Border Background="#2DFE5353" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Success Alert Banner -->
                    <Border Background="#2D10B981" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource Brush.Success}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- STEP 1: Enter email alone -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Work Email" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,20" />

                        <!-- Step 1 Button: Send reset code -->
                        <Button Style="{StaticResource Button.Primary}" Content="Send Reset Code" Command="{Binding RequestResetCodeCommand}" 
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" 
                                Margin="0,0,0,16" />
                    </StackPanel>

                    <!-- STEP 2: Enter OTP code and new password -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <!-- Email badge with option to change email -->
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Reset code sent to" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Change" Command="{Binding BackToStep1Command}" FontSize="12" Height="Auto" Padding="8,4" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- OTP Code -->
                        <TextBlock Text="8-Digit Reset OTP" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBox.Modern}" 
                                 FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" MaxLength="8"
                                 Margin="0,0,0,16" />

                        <!-- New Password -->
                        <TextBlock Text="New Password" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="NewPwdBox" Style="{StaticResource PasswordBox.Modern}" PasswordChanged="NewPwdBox_PasswordChanged" Margin="0,0,0,16" />

                        <!-- Confirm New Password -->
                        <TextBlock Text="Confirm New Password" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="ConfirmNewPwdBox" Style="{StaticResource PasswordBox.Modern}" PasswordChanged="ConfirmNewPwdBox_PasswordChanged" Margin="0,0,0,22" />

                        <!-- Step 2 Button: Confirm reset password -->
                        <Button Style="{StaticResource Button.Primary}" Content="Reset Password" Command="{Binding ConfirmResetPasswordCommand}" 
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" 
                                Margin="0,0,0,14" />

                        <!-- Resend Code helper -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="Didn't receive the code?" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Resend Code" Command="{Binding RequestResetCodeCommand}" 
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Padding="0" Height="Auto" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Busy Progress Indicator -->
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

                    <!-- Return to Login -->
                    <Button Style="{StaticResource Button.Ghost}" Content="Back to Sign In" Command="{Binding NavigateToLoginCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
