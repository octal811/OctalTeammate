<UserControl x:Class="OctalPulse.Views.MajorTaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StateToBoolConverter x:Key="StateToBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel>
            <!-- Back Navigation -->
            <Button Style="{StaticResource Button.Ghost}" Content="← Back to Track" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="0" />

            <!-- Major Task Header Card -->
            <Border Style="{StaticResource Border.Card}" Padding="28" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title & Progress -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TaskTitle}" Style="{StaticResource Text.Heading1}" Width="600" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <!-- Progress Pill -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Progress: " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Grid.Row="1" Text="{Binding TaskDescription, FallbackValue='Checklist of actionable sub-tasks. Check off items as you complete them.'}" 
                               FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,18" />

                    <!-- External Work Link Tile -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="16"
                            Visibility="{Binding TaskLink, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.Surface}" Margin="0,0,14,0">
                                <Path Data="{StaticResource Icon.GitHub}" Fill="{DynamicResource Brush.TextPrimary}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Linked External Work" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding TaskLink}" FontSize="13" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Open Link ↗" 
                                    Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding TaskLink}" Height="34" Padding="14,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20" />

            <!-- Minor Tasks Checklist Section -->
            <Border Style="{StaticResource Border.Card}" Padding="28">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Minor Tasks (Sub-tasks Checklist)" Style="{StaticResource Text.Heading2}" />
                        <Button
                            Height="36"
                            Padding="18,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleAddMinorCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                    <Setter Property="Content" Value="+ Add Minor Task" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingMinor}" Value="True">
                                            <Setter Property="Content" Value="✕ Close" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Checking off items automatically recalculates and cascades progress upward to the Major Task and Track." Style="{StaticResource Text.Subtitle}" Margin="0,0,0,20" />

                    <!-- Add Minor Task Form Card (toggled by the Add button) -->
                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="20" Margin="0,0,0,24"
                            Visibility="{Binding IsAddingMinor, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Field 1: Title -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Minor Task Title *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding NewMinorTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" />
                                </StackPanel>

                                <!-- Field 2: Target Acceptance Criteria -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Target / Acceptance Criteria (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding NewMinorTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" />
                                </StackPanel>
                            </Grid>

                            <!-- Field 3: Link -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="External Work Link (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding NewMinorLink, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" />
                            </StackPanel>

                            <!-- Field 4: Description -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding NewMinorDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="72" />
                            </StackPanel>

                            <!-- Field 5: Notes -->
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="Notes (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding NewMinorNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="60" />
                            </StackPanel>

                            <!-- Add Button -->
                            <Button Style="{StaticResource Button.Primary}" Content="+ Add Minor Task" Command="{Binding CreateMinorTaskCommand}" HorizontalAlignment="Right" Height="38" Padding="22,0" />
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <TextBlock Text="No sub-tasks in this checklist yet. Add one above." FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" 
                               Visibility="{Binding MinorTaskRows.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" 
                               HorizontalAlignment="Center" Margin="0,20" />

                    <!-- Checklist Items -->
                    <ItemsControl ItemsSource="{Binding MinorTaskRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Border.Card}" Margin="0,0,0,14" Padding="16">
                                    <StackPanel>
                                        <!-- Top Row: Checkbox, Title, Status Pill, Delete -->
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand"
                                                          IsChecked="{Binding Item.State, Converter={StaticResource StateToBool}, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleTaskDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip="Check to mark done / uncheck to reopen" />
                                                <TextBlock Text="{Binding Item.Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.State}" Value="Done">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Status Pill -->
                                                <Border CornerRadius="8" Padding="10,4" Margin="0,0,12,0" Background="{DynamicResource Brush.SurfaceElevated}">
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="In Progress" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
<Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.State}" Value="Done">
                                                                    <Setter Property="Text" Value="Completed ✓" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Add Time Button (owner only) -->
                                                <Button Style="{StaticResource Button.Icon}"
                                                        Command="{Binding DataContext.AddWorkTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Add work time"
                                                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource Icon.Stopwatch}" Fill="{DynamicResource Brush.TextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>

                                                <!-- Delete Item Button -->
                                                <Button Style="{StaticResource Button.Icon}"
                                                        Command="{Binding DataContext.DeleteMinorTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete Item">
                                                    <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Brush.Danger}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Work Time -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                    Visibility="{Binding HasWorkTime, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource Icon.Stopwatch}" Fill="{DynamicResource Brush.Primary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding WorkTimeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                        </StackPanel>

                                        <!-- Target / Acceptance Criteria -->
                                        <TextBlock Text="{Binding Item.Target}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding Item.Target, Converter={StaticResource NullToVis}}" />

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Item.Description}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding Item.Description, Converter={StaticResource NullToVis}}" />

                                        <!-- Notes -->
                                        <TextBlock Text="{Binding Item.Notes}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding Item.Notes, Converter={StaticResource NullToVis}}" />

                                        <!-- Link Row (Clickable) -->
                                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="10,6"
                                                Visibility="{Binding Item.Link, Converter={StaticResource NullToVis}}">
                                            <Button Style="{StaticResource Button.Ghost}" Padding="0" Cursor="Hand" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Item.Link}" ToolTip="Open external link">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.GitHub}" Fill="{DynamicResource Brush.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Item.Link}" FontSize="12" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text=" ↗" FontSize="12" Foreground="{DynamicResource Brush.Primary}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
