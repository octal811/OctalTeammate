<UserControl
    x:Class="OctalPulse.Views.OctoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OctalPulse.ViewModels"
    d:DesignHeight="850"
    d:DesignWidth="1100"
    Background="{DynamicResource Brush.Background}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <!--  Main Vertical Layout  -->
        <Grid.RowDefinitions>
            <!--  Top Header & Scope Bar  -->
            <RowDefinition Height="Auto" />
            <!--  Scope Dropdown Drawer (Collapsible)  -->
            <RowDefinition Height="Auto" />
            <!--  Chat Stream  -->
            <RowDefinition Height="*" />
            <!--  Quick Prompts  -->
            <RowDefinition Height="Auto" />
            <!--  Input Box  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── 1. HEADER & ACTIVE SCOPE BAR ──────────────────────────────  -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Brand & Identity  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="{DynamicResource Brush.PrimarySoft}"
                        CornerRadius="10">
                        <Path
                            Width="18"
                            Height="18"
                            Data="{StaticResource Icon.Sparkles}"
                            Fill="{DynamicResource Brush.Primary}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="Octo" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,2"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="AI SUPPORTER" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Project &amp; Task Intelligence" />
                    </StackPanel>
                </StackPanel>

                <!--  Active Scope Indicator  -->
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="10,0"
                    Command="{Binding ToggleScopeSelectorCommand}"
                    Cursor="Hand"
                    Style="{StaticResource Button.Ghost}">
                    <Border
                        Padding="10,4"
                        Height="30"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,6,0"
                                FontSize="12"
                                Text="🎯 Scope:"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock
                                MaxWidth="400"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.Primary}"
                                Text="{Binding ActiveScopeBadgeText}"
                                TextTrimming="CharacterEllipsis" />
                            <Path
                                Width="10"
                                Height="8"
                                Margin="8,0,0,0"
                                Data="{StaticResource Icon.ChevronDown}"
                                Fill="{DynamicResource Brush.TextSecondary}"
                                Stretch="Uniform" />
                        </StackPanel>
                    </Border>
                </Button>

                <!--  Header Actions (Clear Chat & Scope)  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding ToggleScopeSelectorCommand}"
                        Content="Filter Context"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Change Octo's analysis scope" />
                    <Button
                        Height="32"
                        Padding="12,0"
                        Command="{Binding ClearChatCommand}"
                        Content="Clear Chat"
                        Style="{StaticResource Button.Ghost}"
                        ToolTip="Reset conversation" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ── 2. EXPANDABLE CONTEXT SCOPE SELECTOR ───────────────────────  -->
        <Border
            Grid.Row="1"
            Padding="24,16"
            Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding IsScopeSelectorOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Context Scope" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Octo will restrict its analysis and tool queries to the selected scope." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Height="30" Margin="0,0,8,0" Padding="12,0" Content="Apply Scope" Command="{Binding ApplyScopeCommand}" Style="{StaticResource Button.Primary}" />
                        <Button Height="30" Margin="0,0,8,0" Padding="12,0" Content="Reset All" Command="{Binding ClearScopeCommand}" Style="{StaticResource Button.Secondary}" />
                        <Button Height="30" Width="30" Command="{Binding ToggleScopeSelectorCommand}" Style="{StaticResource Button.Icon}">
                            <Path Width="10" Height="10" Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.TextMuted}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Hierarchical Selectors Grid  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!--  Column 1: Project  -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="1. Project" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" />
                        <ComboBox
                            ItemsSource="{Binding AvailableProjects}"
                            SelectedItem="{Binding SelectedProject}"
                            DisplayMemberPath="Title"
                            Height="34" />
                    </StackPanel>

                    <!--  Column 2: Track  -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="2. Track" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" />
                        <ComboBox
                            ItemsSource="{Binding AvailableTracks}"
                            SelectedItem="{Binding SelectedTrack}"
                            DisplayMemberPath="Name"
                            Height="34" />
                    </StackPanel>

                    <!--  Column 3: Major Task  -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="3. Major Task" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" />
                        <ComboBox
                            ItemsSource="{Binding AvailableMajorTasks}"
                            SelectedItem="{Binding SelectedMajorTask}"
                            DisplayMemberPath="Title"
                            Height="34" />
                    </StackPanel>

                    <!--  Column 4: Specific Task Checklist  -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="4. Focus Specific Tasks (Optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" />
                        <Border
                            Height="90"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableTasksForSelection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding IsSelected}"
                                                Margin="0,2"
                                                VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  ── 3. CHAT STREAM (SCROLLVIEWER) ──────────────────────────────  -->
        <ScrollViewer
            Grid.Row="2"
            Padding="32,20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

                <!--  Unconfigured Banner  -->
                <Border
                    Margin="0,0,0,24"
                    Padding="20"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsGeminiConfigured, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#26F59E0B" Margin="0,0,16,0">
                            <Path Data="{StaticResource Icon.Sparkles}" Fill="{DynamicResource Brush.Warning}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Gemini API Key Required" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="To interact with Octo, please connect your personal Gemini API key in Settings. Your key is stored securely via Windows DPAPI and never shared." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Configure in Settings" Command="{Binding NavigateSettingsCommand}" Style="{StaticResource Button.Primary}" Height="36" Padding="14,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Message List  -->
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OctoMessageDisplayItem}">
                            <Grid Margin="0,8">
                                <!--  User Message Bubble (Right-Aligned)  -->
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    MaxWidth="680"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <Border
                                        Background="{DynamicResource Brush.Primary}"
                                        CornerRadius="16,16,2,16"
                                        Padding="16,12">
                                        <TextBlock
                                            Text="{Binding Content}"
                                            Foreground="#FFFFFF"
                                            FontSize="14"
                                            TextWrapping="Wrap"
                                            LineHeight="20" />
                                    </Border>
                                    <TextBlock
                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                        FontSize="10"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,4,0" />
                                </StackPanel>

                                <!--  Assistant Message Bubble (Left-Aligned)  -->
                                <Grid
                                    HorizontalAlignment="Left"
                                    MaxWidth="760"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Avatar  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.PrimarySoft}"
                                        CornerRadius="16">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource Icon.Sparkles}"
                                            Fill="{DynamicResource Brush.Primary}"
                                            Stretch="Uniform" />
                                    </Border>

                                    <!--  Card Content  -->
                                    <StackPanel Grid.Column="1">
                                        <!--  Thinking / Live Activity Pill  -->
                                        <Border
                                            Padding="10,6"
                                            Margin="0,0,0,8"
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                                                <TextBlock
                                                    Text="{Binding StatusText, FallbackValue='Octo is thinking...'}"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource Brush.Primary}" />
                                            </StackPanel>
                                        </Border>

                                        <!--  Message Card  -->
                                        <Border
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="2,16,16,16"
                                            Padding="18,14">
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{Binding Content}"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    FontSize="13.5"
                                                    TextWrapping="Wrap"
                                                    LineHeight="22" />

                                                <!--  Tool Execution Summary Badge  -->
                                                <Border
                                                    Margin="0,10,0,0"
                                                    Padding="8,4"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding ToolSummary, Converter={StaticResource NullToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡ " FontSize="11" />
                                                        <TextBlock Text="{Binding ToolSummary}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock
                                            Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="10"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Margin="4,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!--  System Message (Centered Notice)  -->
                                <Border
                                    HorizontalAlignment="Center"
                                    Margin="0,6"
                                    Padding="14,6"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!--  ── 4. QUICK PROMPT SUGGESTIONS ────────────────────────────────  -->
        <Border
            Grid.Row="3"
            Padding="24,6,24,10"
            Background="{DynamicResource Brush.Surface}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Suggestions:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding SendQuickPromptCommand}"
                        CommandParameter="Which task should I start with, and why?"
                        Style="{StaticResource Button.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 Where should I start?" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding SendQuickPromptCommand}"
                        CommandParameter="What tasks or dependencies are currently blocking progress in this scope?"
                        Style="{StaticResource Button.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ What is blocking progress?" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding SendQuickPromptCommand}"
                        CommandParameter="Compare the highest priority tasks in this scope and summarize their status."
                        Style="{StaticResource Button.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖️ Compare high priority tasks" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding SendQuickPromptCommand}"
                        CommandParameter="How would you break down the active major task into actionable subtasks?"
                        Style="{StaticResource Button.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩 Suggest task breakdown" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ── 5. MESSAGE INPUT AREA ──────────────────────────────────────  -->
        <Border
            Grid.Row="4"
            Padding="24,12,24,18"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="880" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource TextBox.Modern}"
                    Tag="Ask Octo anything about your tasks, dependencies, or what to do next..."
                    AcceptsReturn="False"
                    Height="44"
                    FontSize="13.5"
                    Padding="14,0"
                    Margin="0,0,12,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button
                    Grid.Column="1"
                    Height="44"
                    Padding="22,0"
                    Command="{Binding SendMessageCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                    Style="{StaticResource Button.Primary}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Data="{StaticResource Icon.Send}"
                            Fill="#FFFFFF"
                            Stretch="Uniform" />
                        <TextBlock Text="Send" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
