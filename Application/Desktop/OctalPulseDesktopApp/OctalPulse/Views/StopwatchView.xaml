<UserControl
    x:Class="OctalPulse.Views.StopwatchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OctalPulse.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1050"
    Background="{DynamicResource Brush.Background}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToEnabledConverter x:Key="NullToEnabled" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel MaxWidth="860" HorizontalAlignment="Center">

            <!-- ── Time Display ── -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextMuted}"
                Text="WORK TIMER"
                HorizontalAlignment="Center" />
            <Border
                Background="{DynamicResource Brush.SurfaceElevated}"
                CornerRadius="14"
                Padding="40,32"
                Margin="0,0,0,20"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding ElapsedDisplay}"
                        FontSize="80"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="H : MM : SS"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ── Controls ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Button
                    Command="{Binding ToggleRunningCommand}"
                    Width="130"
                    Height="44"
                    Margin="0,0,12,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Pause" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Content" Value="Start" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Command="{Binding ResetTimerCommand}"
                    Style="{StaticResource Button.Secondary}"
                    Width="100"
                    Height="44"
                    Content="Reset" />
            </StackPanel>

            <!-- ── Save Panel ── -->
            <Border
                Style="{StaticResource Border.Card}"
                Padding="24"
                Margin="0,0,0,16"
                Visibility="{Binding IsElapsed, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Text="Save work time to a task" />

                    <!--  Project  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Project" />
                    <ComboBox
                        Margin="0,0,0,14"
                        DisplayMemberPath="Title"
                        Height="40"
                        ItemsSource="{Binding Projects}"
                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                        Style="{StaticResource ComboBox.Modern}" />

                    <!--  Track  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Track" />
                    <ComboBox
                        Margin="0,0,0,14"
                        DisplayMemberPath="Name"
                        Height="40"
                        IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToEnabled}}"
                        ItemsSource="{Binding Tracks}"
                        SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                        Style="{StaticResource ComboBox.Modern}" />

                    <!--  Major Task  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Major Task" />
                    <ComboBox
                        Margin="0,0,0,14"
                        DisplayMemberPath="Title"
                        Height="40"
                        IsEnabled="{Binding SelectedTrack, Converter={StaticResource NullToEnabled}}"
                        ItemsSource="{Binding MajorTasks}"
                        SelectedItem="{Binding SelectedMajorTask, Mode=TwoWay}"
                        Style="{StaticResource ComboBox.Modern}" />

                    <!--  Minor Task + Toggle Create  -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Minor Task"
                            VerticalAlignment="Center" />
                        <Button
                            Margin="12,0,0,0"
                            Padding="6,0"
                            FontSize="12"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource Button.Ghost}"
                            Foreground="{DynamicResource Brush.Primary}"
                            Command="{Binding ToggleCreateMinorCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreatingMinor}" Value="True">
                                                <Setter Property="Text" Value="Pick existing task ▾" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCreatingMinor}" Value="False">
                                                <Setter Property="Text" Value="+ Create new task" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <ComboBox
                        Margin="0,0,0,16"
                        DisplayMemberPath="Title"
                        Height="40"
                        IsEnabled="{Binding SelectedMajorTask, Converter={StaticResource NullToEnabled}}"
                        ItemsSource="{Binding MinorTasks}"
                        SelectedItem="{Binding SelectedMinorTask, Mode=TwoWay}"
                        Style="{StaticResource ComboBox.Modern}"
                        Visibility="{Binding IsCreatingMinor, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <!-- ── New Minor Task Form ── -->
                    <Border
                        Background="{DynamicResource Brush.Background}"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsCreatingMinor, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="New sub-task details" />

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Title (required)" />
                            <TextBox
                                Margin="0,0,0,12"
                                Style="{StaticResource TextBox.Modern}"
                                Text="{Binding NewMinorTitle, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Job Type" />
                            <ComboBox
                                Margin="0,0,0,12"
                                ItemsSource="{Binding AvailableJobTypes}"
                                SelectedItem="{Binding NewMinorJobType}"
                                Style="{StaticResource ComboBox.Modern}" />

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Description" />
                            <TextBox
                                Margin="0,0,0,12"
                                Style="{StaticResource TextBox.Multiline}"
                                Height="80"
                                Text="{Binding NewMinorDescription, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="Target" />
                                    <TextBox
                                        Style="{StaticResource TextBox.Modern}"
                                        Text="{Binding NewMinorTarget, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="Link" />
                                    <TextBox
                                        Style="{StaticResource TextBox.Modern}"
                                        Text="{Binding NewMinorLink, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Notes" />
                            <TextBox
                                Style="{StaticResource TextBox.Modern}"
                                Text="{Binding NewMinorNotes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!--  Save Button  -->
                    <Button
                        HorizontalAlignment="Right"
                        Height="38"
                        Padding="24,0"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsElapsed}"
                        Content="Save" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>