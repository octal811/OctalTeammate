<UserControl x:Class="OctalPulse.Views.VerifyEmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OctalPulse.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Margin="30,24">
            <Border Style="{StaticResource Border.Card}" Padding="36">
                <StackPanel>
                    <!-- Icon badge -->
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Path Data="{StaticResource Icon.Check}" Fill="{DynamicResource Brush.Primary}" Width="24" Height="24" Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="Verify your email" Style="{StaticResource Text.Heading2}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="We have sent an 8-digit verification code to your inbox." Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <!-- Error Alert Banner -->
                    <Border Background="#2DFE5353" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Success Alert Banner -->
                    <Border Background="#2D10B981" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource Brush.Success}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Email Display -->
                    <TextBlock Text="Email Address" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Modern}" Margin="0,0,0,18" />

                    <!-- 8-digit OTP Input -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="8-Digit OTP Code" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Left" />
                        <!-- Countdown Display -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Expires in: " FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding CountdownDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TextBox.Modern}" 
                             FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" MaxLength="8"
                             Margin="0,0,0,24" />

                    <!-- Verify Button -->
                    <Button Style="{StaticResource Button.Primary}" Content="Verify Email" Command="{Binding VerifyOtpCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,0,0,14" />

                    <!-- Resend Button -->
                    <Button Style="{StaticResource Button.Secondary}" Content="{Binding ResendButtonText}" Command="{Binding ResendOtpCommand}" IsEnabled="{Binding CanResend}" Margin="0,0,0,20" />

                    <!-- Busy Progress -->
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Modern}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />

                    <!-- Back to Sign In -->
                    <Button Style="{StaticResource Button.Ghost}" Content="Return to Sign In" Command="{Binding NavigateToLoginCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
