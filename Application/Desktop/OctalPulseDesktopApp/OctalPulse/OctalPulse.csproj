<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OctalPulse.Application\OctalPulse.Application.csproj" />
    <ProjectReference Include="..\OctalPulse.Infrastructure\OctalPulse.Infrastructure.csproj" />
    <ProjectReference Include="..\OctalPulse.Domain\OctalPulse.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OctalPulse.ico" />
    <Resource Include="Assets\OctalPulse.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\OctalPulse.ico</ApplicationIcon>
    <!-- Use our custom Program.Main so the mutex check runs BEFORE WPF initialises -->
    <StartupObject>OctalPulse.Program</StartupObject>
  </PropertyGroup>

</Project>
